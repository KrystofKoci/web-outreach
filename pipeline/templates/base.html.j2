{%- import 'partials/_icons.html.j2' as ic -%}
<!DOCTYPE html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ lead.name }} – {{ lead.category or industry_label }}{% if lead.city %} {{ t.in_city }} {{ lead.city }}{% endif %}</title>
<meta name="description" content="{{ copy.subheadline }}">
<meta name="robots" content="noindex,nofollow">
<meta property="og:type" content="website">
<meta property="og:title" content="{{ lead.name }} – {{ copy.headline }}">
<meta property="og:description" content="{{ copy.subheadline }}">
{% if og_image_url %}<meta property="og:image" content="{{ og_image_url }}">{% endif %}
{% if preview_url %}<meta property="og:url" content="{{ preview_url }}">{% endif %}
<meta property="og:locale" content="{{ 'cs_CZ' if lang == 'cs' else 'en_US' }}">
<link rel="icon" href="data:image/svg+xml,{{ favicon_svg | urlencode }}">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="{{ fonts.link }}">
{% if hero_image %}<!-- Photo: {{ hero_image.photographer }} ({{ hero_image.source_url }}) via Pexels -->{% endif %}
<style>
:root{
  --bg:{{ palette.bg }};--ink:{{ palette.ink }};--brand:{{ palette.brand }};--accent:{{ palette.accent }};
  --accent-ink:{{ palette.accent_ink }};--soft:{{ palette.soft }};--muted:{{ palette.muted }};--line:{{ palette.line }};
  --on-brand:#FFFFFF;--on-brand-muted:rgba(255,255,255,.78);
  --font-display:{{ fonts.display | safe }};--font-body:{{ fonts.body | safe }};
  --radius:{{ radius | default('10px') }};--maxw:1120px;--gutter:clamp(18px,4vw,40px);
}
*,*::before,*::after{box-sizing:border-box}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
@media (prefers-reduced-motion:reduce){html{scroll-behavior:auto}*{transition:none!important;animation:none!important}}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font-body);font-size:17px;line-height:1.55;
  -webkit-font-smoothing:antialiased;padding-bottom:var(--banner-h,0)}
img,svg{display:block;max-width:100%}
a{color:inherit}
h1,h2,h3{font-family:var(--font-display);line-height:1.1;margin:0;letter-spacing:-.01em;text-wrap:balance}
h1{font-size:clamp(2.3rem,8vw,4.4rem);font-weight:800}
h2{font-size:clamp(1.75rem,4.5vw,2.6rem);font-weight:700}
h3{font-size:1.15rem;font-weight:700}
p{margin:0}
.wrap{width:min(var(--maxw),100% - 2*var(--gutter));margin-inline:auto}
.ico{width:1.4em;height:1.4em;flex:none}
:focus-visible{outline:3px solid var(--accent);outline-offset:3px}
.sr{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:.55em;padding:.95em 1.4em;border-radius:var(--radius);font-weight:700;
  text-decoration:none;font-size:1.05rem;line-height:1;border:2px solid transparent;cursor:pointer;font-family:var(--font-body)}
.btn-accent{background:var(--accent);color:var(--accent-ink);border-color:var(--accent)}
.btn-accent:hover{filter:brightness(1.08)}
.btn-ghost{background:transparent;color:var(--ink);border-color:var(--ink)}
.btn-ghost:hover{background:var(--ink);color:var(--bg)}
.on-brand .btn-ghost{color:var(--on-brand);border-color:var(--on-brand)}
.on-brand .btn-ghost:hover{background:var(--on-brand);color:var(--brand)}

/* top bar */
.top{position:sticky;top:0;z-index:20;background:color-mix(in srgb,var(--bg) 92%,transparent);backdrop-filter:blur(8px);
  border-bottom:1px solid var(--line)}
.top .wrap{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:64px}
.brand{font-family:var(--font-display);font-weight:800;font-size:1.2rem;text-decoration:none;display:flex;align-items:center;gap:.5em;min-width:0}
.brand .nm{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:48vw}
@media (max-width:560px){.top-cta span{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}.top-cta{width:44px;height:44px;padding:0;justify-content:center;border-radius:50%}.top-cta .ico{width:1.3em;height:1.3em}}
@media (min-width:860px){.brand .nm{max-width:none}}
.brand .mark{width:34px;height:34px;border-radius:9px;background:var(--brand);color:var(--on-brand);display:grid;place-items:center;
  font-size:1rem;font-weight:800;flex:none}
.nav{display:none;gap:26px;font-weight:600;font-size:.98rem}
.nav a{text-decoration:none;color:var(--muted)}
.nav a:hover{color:var(--ink)}
.top-cta{display:inline-flex;align-items:center;gap:.5em;padding:.6em 1em;border-radius:999px;background:var(--brand);
  color:var(--on-brand);text-decoration:none;font-weight:700;font-size:.95rem;white-space:nowrap}
.top-cta .ico{width:1.1em;height:1.1em}
.menu-btn{display:inline-grid;place-items:center;width:44px;height:44px;border:0;background:transparent;color:var(--ink);cursor:pointer}
.mnav{display:none;border-top:1px solid var(--line);background:var(--bg)}
.mnav.open{display:block}
.mnav a{display:block;padding:14px var(--gutter);text-decoration:none;font-weight:600;border-bottom:1px solid var(--line)}
@media (min-width:860px){.nav{display:flex}.menu-btn{display:none}.mnav{display:none!important}}

/* hero (shared) */
.hero{position:relative;overflow:hidden}
.hero .wrap{display:grid;gap:36px;padding-block:clamp(44px,8vw,96px) clamp(44px,7vw,88px)}
.hero-copy{max-width:640px}
.hero h1{max-width:15ch}
.hero-cat{font-weight:600;color:var(--muted);margin-bottom:18px;display:flex;align-items:center;gap:.6em}
.hero-cat::before{content:"";width:28px;height:3px;background:var(--accent);border-radius:2px}
.hero p.sub{font-size:clamp(1.1rem,2.4vw,1.3rem);margin-top:22px;max-width:46ch;color:var(--muted)}
.hero .ctas{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.hero-meta{margin-top:28px;display:flex;flex-wrap:wrap;gap:10px 22px;font-size:.95rem;color:var(--muted)}
.hero-meta span{display:inline-flex;align-items:center;gap:.4em}
.hero-art{position:relative;min-height:260px}
.photo{width:100%;height:100%;min-height:260px;object-fit:cover;border-radius:var(--radius)}
.ph{min-height:280px;height:100%;border:2px dashed color-mix(in srgb,var(--ink) 35%,transparent);border-radius:var(--radius);
  display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;text-align:center;padding:28px;
  background:linear-gradient(135deg,var(--soft),transparent 70%)}
.ph .motif{width:72px;height:72px;color:var(--brand);opacity:.6}
.ph b{font-size:1.15rem}
.ph small{color:var(--muted);max-width:30ch;line-height:1.4}
.on-brand{--ink:var(--on-brand);--muted:var(--on-brand-muted);color:var(--on-brand)}
.on-brand .ph{border-color:rgba(255,255,255,.5);background:linear-gradient(135deg,rgba(255,255,255,.14),transparent 70%)}
.on-brand .ph .motif{color:#fff}
@media (min-width:860px){
  .hero .wrap{grid-template-columns:minmax(0,1.1fr) minmax(0,.9fr);align-items:center;gap:56px}
  .hero-art{min-height:420px}
}

/* sections */
section{padding-block:clamp(56px,8vw,104px)}
.sec-head{max-width:60ch;margin-bottom:clamp(28px,4vw,44px)}
.sec-head p{margin-top:12px;color:var(--muted);font-size:1.08rem}
.alt{background:var(--soft)}
.grid{display:grid;gap:18px}
@media (min-width:640px){.grid-2{grid-template-columns:1fr 1fr}.grid-3{grid-template-columns:1fr 1fr}}
@media (min-width:980px){.grid-3{grid-template-columns:repeat(3,1fr)}}

/* services */
.svc{padding:26px 24px 28px;border-radius:var(--radius);background:var(--bg);border:1px solid var(--line);display:flex;flex-direction:column;gap:12px}
.svc .ico-wrap{width:48px;height:48px;border-radius:12px;background:var(--brand);color:var(--on-brand);display:grid;place-items:center}
.svc .ico-wrap .ico{width:24px;height:24px}
.svc p{color:var(--muted)}

/* about + why */
.about{display:grid;gap:40px}
.about .lead-text{font-size:1.12rem;max-width:58ch}
.why{list-style:none;margin:0;padding:0;display:grid;gap:14px}
.why li{display:flex;gap:14px;align-items:flex-start;font-weight:600;font-size:1.05rem}
.why .tick{width:30px;height:30px;border-radius:50%;background:var(--accent);color:var(--accent-ink);display:grid;place-items:center;flex:none;margin-top:1px}
.why .tick .ico{width:17px;height:17px;stroke-width:2.6}
@media (min-width:860px){.about{grid-template-columns:1.2fr .8fr;gap:72px}}

/* reviews */
.reviews{padding-block:34px;border-block:1px solid var(--line)}
.reviews .wrap{display:flex;flex-wrap:wrap;align-items:center;gap:14px 28px}
.stars{position:relative;display:inline-block;font-size:1.5rem;letter-spacing:3px;line-height:1;color:var(--line)}
.stars::before{content:"★★★★★"}
.stars span{position:absolute;inset:0;overflow:hidden;white-space:nowrap;color:var(--accent)}
.stars span::before{content:"★★★★★"}
.reviews .txt{font-weight:700;font-size:1.1rem}
.reviews a{color:var(--muted);text-decoration:underline;text-underline-offset:3px;display:inline-flex;align-items:center;gap:.35em}

/* hours */
.hours{list-style:none;margin:0;padding:0;max-width:560px}
.hours li{display:flex;justify-content:space-between;gap:20px;padding:12px 0;border-bottom:1px solid var(--line)}
.hours li span:last-child{font-weight:700;text-align:right}
.hours li.today span:first-child{font-weight:700}
.hours .tag{display:inline-block;margin-left:.5em;font-size:.72rem;font-weight:700;padding:.15em .55em;border-radius:999px;background:var(--brand);color:var(--on-brand);vertical-align:middle;letter-spacing:.02em}
.hours-wrap{display:grid;gap:36px}
@media (min-width:860px){.hours-wrap{grid-template-columns:1fr 1fr;align-items:start}}
.map{border:0;width:100%;aspect-ratio:4/3;border-radius:var(--radius);background:var(--soft);min-height:260px}

/* contact */
.contact{display:grid;gap:40px}
.c-list{display:grid;gap:18px;margin-top:8px}
.c-item{display:flex;gap:16px;align-items:flex-start}
.c-item .ico-wrap{width:44px;height:44px;border-radius:12px;background:var(--soft);color:var(--brand);display:grid;place-items:center;flex:none}
.c-item b{display:block;font-size:.9rem;color:var(--muted);font-weight:600;margin-bottom:2px}
.c-item a{font-weight:700;text-decoration:none;font-size:1.1rem}
.c-item a:hover{text-decoration:underline}
form{display:grid;gap:14px;padding:26px;border-radius:var(--radius);background:var(--bg);border:1px solid var(--line)}
label{display:grid;gap:6px;font-weight:600;font-size:.95rem}
input,textarea{font:inherit;padding:.8em .9em;border:1.5px solid var(--line);border-radius:8px;background:#fff;color:#111;width:100%}
input:focus,textarea:focus{border-color:var(--brand);outline:0;box-shadow:0 0 0 3px color-mix(in srgb,var(--brand) 20%,transparent)}
textarea{min-height:120px;resize:vertical}
.form-note{font-size:.9rem;color:var(--muted)}
.form-msg{font-weight:600;min-height:1.4em}
.form-msg.err{color:#A3261C}
@media (min-width:860px){.contact{grid-template-columns:.9fr 1.1fr;gap:64px}}

/* faq */
.faq details{border-bottom:1px solid var(--line);padding:4px 0}
.faq summary{cursor:pointer;font-weight:700;font-size:1.08rem;padding:16px 0;list-style:none;display:flex;justify-content:space-between;gap:16px;align-items:center}
.faq summary::-webkit-details-marker{display:none}
.faq summary::after{content:"+";font-size:1.5rem;line-height:1;color:var(--accent);font-weight:400;transition:transform .2s}
.faq details[open] summary::after{transform:rotate(45deg)}
.faq details p{padding-bottom:18px;color:var(--muted);max-width:66ch}
.faq .inner{max-width:760px}

/* footer */
footer{background:var(--brand);color:var(--on-brand);padding-block:36px;font-size:.95rem}
footer .wrap{display:flex;flex-wrap:wrap;justify-content:space-between;gap:12px 28px;align-items:center}
footer a{color:var(--on-brand)}
footer .credit{opacity:.75;font-size:.85rem;width:100%}

/* preview banner */
.pv{position:fixed;left:0;right:0;bottom:0;z-index:50;background:#111827;color:#fff;font-family:system-ui,sans-serif;
  font-size:.92rem;line-height:1.4;padding:12px var(--gutter);display:flex;flex-wrap:wrap;gap:8px 18px;align-items:center;justify-content:center;
  box-shadow:0 -6px 24px rgba(0,0,0,.25)}
.pv a{color:#fff}
.pv .pv-cta{background:#fff;color:#111827;text-decoration:none;font-weight:700;padding:.45em .9em;border-radius:999px}
.pv .pv-x{opacity:.8;background:none;border:0;color:#fff;cursor:pointer;font:inherit;text-decoration:underline}
.pv.hidden{display:none}
{% block extra_css %}{% endblock %}
</style>
</head>
<body class="ind-{{ industry_key }}">

<header class="top">
  <div class="wrap">
    <a class="brand" href="#top" aria-label="{{ lead.name }}"><span class="mark">{{ lead.name[:1] | upper }}</span><span class="nm">{{ lead.name }}</span></a>
    <nav class="nav" aria-label="{{ t.nav_label }}">
      <a href="#sluzby">{{ t.nav_services }}</a><a href="#o-nas">{{ t.nav_about }}</a>
      {% if hours %}<a href="#hodiny">{{ t.nav_hours }}</a>{% endif %}<a href="#kontakt">{{ t.nav_contact }}</a>
    </nav>
    {% if phone %}<a class="top-cta" href="tel:{{ phone_href }}">{{ ic.icon('phone') }}<span>{{ phone }}</span></a>
    {% else %}<a class="top-cta" href="#kontakt">{{ ic.icon('mail') }}<span>{{ t.write_us }}</span></a>{% endif %}
    <button class="menu-btn" type="button" aria-expanded="false" aria-controls="mnav" aria-label="{{ t.menu }}" data-menu>{{ ic.icon('menu') }}</button>
  </div>
  <div class="mnav" id="mnav">
    <a href="#sluzby">{{ t.nav_services }}</a><a href="#o-nas">{{ t.nav_about }}</a>
    {% if hours %}<a href="#hodiny">{{ t.nav_hours }}</a>{% endif %}<a href="#kontakt">{{ t.nav_contact }}</a>
  </div>
</header>

<main id="top">
<section class="hero hero--{{ hero_variant }}{% if hero_on_brand %} on-brand{% endif %}">
  {% block hero_deco %}{% endblock %}
  <div class="wrap">
    <div class="hero-copy">
      <p class="hero-cat">{{ lead.category or industry_label }}{% if lead.city %} · {{ lead.city }}{% endif %}</p>
      <h1>{{ copy.headline }}</h1>
      <p class="sub">{{ copy.subheadline }}</p>
      <div class="ctas">
        {% if phone %}<a class="btn btn-accent" href="tel:{{ phone_href }}">{{ ic.icon('phone') }}{{ copy.cta_primary }}</a>{% endif %}
        <a class="btn btn-ghost" href="#kontakt">{{ ic.icon('mail') }}{{ t.write_us }}</a>
      </div>
      <div class="hero-meta">
        {% if hours_today %}<span>{{ ic.icon('clock') }}{{ t.today }}: {{ hours_today }}</span>{% endif %}
        {% if lead.city %}<span>{{ ic.icon('pin') }}{{ lead.city }}</span>{% endif %}
        {% if copy.reviews_line %}<span>{{ ic.icon('star') }}{{ copy.reviews_line }}</span>{% endif %}
      </div>
    </div>
    <div class="hero-art">
      {% block hero_art %}
      {% if hero_image %}
        <img class="photo" src="{{ hero_image.url }}" alt="{{ hero_image.alt }}" width="1200" height="800" fetchpriority="high">
      {% else %}
        <div class="ph" role="img" aria-label="{{ placeholder_label }}">
          <span class="motif">{{ motif_svg | safe }}</span>
          <b>{{ placeholder_label }}</b>
          <small>{{ placeholder_hint }}</small>
        </div>
      {% endif %}
      {% endblock %}
    </div>
  </div>
</section>

<section id="sluzby" class="alt">
  <div class="wrap">
    <div class="sec-head">
      <h2>{{ t.services_title }}</h2>
    </div>
    <div class="grid grid-3">
      {% for s in copy.services %}
      <article class="svc">
        <div class="ico-wrap">{{ ic.icon(s.icon) }}</div>
        <h3>{{ s.title }}</h3>
        <p>{{ s.text }}</p>
      </article>
      {% endfor %}
    </div>
  </div>
</section>

<section id="o-nas">
  <div class="wrap about">
    <div>
      <div class="sec-head"><h2>{{ copy.about_title }}</h2></div>
      <p class="lead-text">{{ copy.about_text }}</p>
    </div>
    <div>
      <h3 style="margin-bottom:18px;font-size:1.25rem">{{ t.why_title }}</h3>
      <ul class="why">
        {% for w in copy.why_us %}<li><span class="tick">{{ ic.icon('check') }}</span><span>{{ w }}</span></li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

{% if copy.reviews_line %}
<div class="reviews alt">
  <div class="wrap">
    <span class="stars" aria-hidden="true"><span style="width:{{ stars_pct }}%"></span></span>
    <span class="txt">{{ copy.reviews_line }}</span>
    {% if lead.maps_url %}<a href="{{ lead.maps_url }}" target="_blank" rel="noopener">{{ t.see_on_google }} {{ ic.icon('external') }}</a>{% endif %}
  </div>
</div>
{% endif %}

<section id="hodiny">
  <div class="wrap hours-wrap">
    <div>
      <div class="sec-head"><h2>{{ copy.hours_title }}</h2></div>
      {% if hours %}
      <ul class="hours">
        {% for day, val in hours %}<li{% if loop.index0 == today_idx %} class="today"{% endif %}><span>{{ day }}{% if loop.index0 == today_idx %} <em class="tag">{{ t.today | lower }}</em>{% endif %}</span><span>{{ val }}</span></li>{% endfor %}
      </ul>
      {% else %}
      <p class="form-note">{{ t.hours_missing }}</p>
      {% endif %}
    </div>
    <div>
      {% if lead.address %}
      <iframe class="map" loading="lazy" referrerpolicy="no-referrer-when-downgrade" title="{{ t.map_title }}"
        src="https://www.google.com/maps?q={{ map_query | urlencode }}&amp;output=embed"></iframe>
      {% endif %}
    </div>
  </div>
</section>

<section id="kontakt" class="alt">
  <div class="wrap contact">
    <div>
      <div class="sec-head"><h2>{{ copy.contact_title }}</h2><p>{{ t.contact_sub }}</p></div>
      <div class="c-list">
        {% if phone %}<div class="c-item"><span class="ico-wrap">{{ ic.icon('phone') }}</span><div><b>{{ t.phone }}</b><a href="tel:{{ phone_href }}">{{ phone }}</a></div></div>{% endif %}
        {% if lead.address %}<div class="c-item"><span class="ico-wrap">{{ ic.icon('pin') }}</span><div><b>{{ t.address }}</b><a href="{{ lead.maps_url or ('https://www.google.com/maps?q=' ~ (map_query | urlencode)) }}" target="_blank" rel="noopener">{{ lead.address }}</a></div></div>{% endif %}
        {% if email %}<div class="c-item"><span class="ico-wrap">{{ ic.icon('mail') }}</span><div><b>{{ t.email }}</b><a href="mailto:{{ email }}">{{ email }}</a></div></div>{% endif %}
      </div>
    </div>
    {% include 'partials/_form.html.j2' %}
  </div>
</section>

{% if copy.faq %}
<section class="faq">
  <div class="wrap">
    <div class="sec-head"><h2>{{ t.faq_title }}</h2></div>
    <div class="inner">
      {% for f in copy.faq %}
      <details{% if loop.first %} open{% endif %}><summary>{{ f.q }}</summary><p>{{ f.a }}</p></details>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
</main>

<footer>
  <div class="wrap">
    <span>© {{ year }} {{ lead.name }}{% if copy.footer_note %} · {{ copy.footer_note }}{% endif %}</span>
    {% if demo %}<span>{{ t.demo_footer }} <a href="{{ owner_site }}" rel="noopener">{{ owner_name }}</a></span>
    {% else %}<span>{{ t.prepared_by }} <a href="{{ owner_site }}" rel="noopener">{{ owner_name }}</a></span>{% endif %}
    {% if hero_image %}<span class="credit">{{ credit_label }}: <a href="{{ hero_image.source_url }}" rel="noopener nofollow">{{ hero_image.photographer }}</a> / Pexels</span>{% endif %}
  </div>
</footer>

{% if not demo %}{% include 'partials/_banner.html.j2' %}{% endif %}

<script>
(function(){
  var b=document.querySelector('[data-menu]'),m=document.getElementById('mnav');
  if(b&&m){b.addEventListener('click',function(){var o=m.classList.toggle('open');b.setAttribute('aria-expanded',o?'true':'false');});
    m.addEventListener('click',function(e){if(e.target.tagName==='A'){m.classList.remove('open');b.setAttribute('aria-expanded','false');}});}
  var pv=document.getElementById('pv');
  if(pv){var fit=function(){document.body.style.setProperty('--banner-h',pv.offsetHeight+'px');};fit();window.addEventListener('resize',fit);
    var x=pv.querySelector('[data-pv-close]');if(x){x.addEventListener('click',function(){pv.classList.add('hidden');document.body.style.setProperty('--banner-h','0px');});}}
  var f=document.getElementById('kf');
  if(f){f.addEventListener('submit',function(e){
    var url=f.getAttribute('data-webhook');var msg=f.querySelector('.form-msg');
    if(!url){return;}
    e.preventDefault();msg.textContent='…';msg.classList.remove('err');
    var d={lead_id:f.getAttribute('data-lead'),name:f.name.value,email:f.email.value,message:f.message.value,source:'preview'};
    fetch(url,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)})
      .then(function(r){if(!r.ok)throw new Error(r.status);msg.textContent=f.getAttribute('data-ok');f.reset();})
      .catch(function(){msg.textContent=f.getAttribute('data-err');msg.classList.add('err');});
  });}
})();
</script>
</body>
</html>
