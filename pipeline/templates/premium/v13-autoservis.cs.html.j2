<!DOCTYPE html>

<html data-pobocky="{{ pobocky }}" lang="cs">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<meta content="{{ meta_description }}" name="description"/>
<script>
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  h.dataset.tema=(q.get('tema')==='tmava'||location.hash==='#tmava')?'tmava':'svetla';
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0')h.classList.add('pohyb');
  if(q.get('pohyb')==='0')h.classList.add('bez-zoomu');
  /* počet poboček: pipeline nastaví data-pobocky na <html> (1–3), náhled přepíše ?pobocky= */
  var pb=q.get('pobocky')||h.getAttribute('data-pobocky')||'3';if(!/^[123]$/.test(pb))pb='3';h.setAttribute('data-pobocky',pb);})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@500;600&amp;family=Public+Sans:ital,wght@0,400;0,500;0,600;1,400&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V13 Přiblížení do dílny – autoservis Kardan (od jedné dílny po 2–3 pobočky; přizpůsobí se html[data-pobocky]).
     Motiv: žlutá vodorovná značka z podlahy dílny (vymezení stání, ramena zvedáků). Žlutá je jen funkční: tlačítka,
     označení vybrané služby, čára v hero. Nadpisy bez barevného zvýraznění.
     Hero: fotka celé dílny; při scrollu se obraz plynule přiblíží na mechaniky u aut. Řízeno scrollem v JS (rAF),
     takže běží i s „omezit animace“ (tehdy bez dojezdu, přímo podle scrollu); ?pohyb=0 = statická dílna bez přiblížení. */
  :root {
    --pozadi:#E2E5E7; --plocha:#F1F3F4; --text:#14202A; --tlumeny:#4A5560; --linka:rgba(20,32,42,.15);
    --akcent:#E8B517; --na-akcentu:#14202A; --pole-hrana:#737D86; --chyba:#B3402A;
    --foto: saturate(.88) contrast(1.03);
  }
  html[data-tema="tmava"] {
    --pozadi:#0D151C; --plocha:#15202A; --text:#E4E9ED; --tlumeny:#9AA7B1; --linka:rgba(228,233,237,.14);
    --pole-hrana:#66737E; --chyba:#E07A62;
    --foto: brightness(.86) saturate(.86) contrast(1.04);
    color-scheme: dark;
  }
  html { background: var(--pozadi); scroll-padding-top: 84px; }
  body { background: var(--pozadi); color: var(--text); font-family: "Public Sans", system-ui, sans-serif; font-size: 17px; line-height: 1.6; }
  h1, h2, h3, .logo, .disp { font-family: "Unbounded", "Public Sans", sans-serif; font-weight: 600; }
  .doplnit { color: var(--tlumeny); }
  .obal { max-width: 1360px; margin: 0 auto; padding: 0 clamp(18px, 3vw, 44px); }

  /* tlačítka */
  .cta { display: inline-flex; align-items: center; justify-content: center; height: 52px; padding: 0 26px; border-radius: 6px;
    background: var(--akcent); color: var(--na-akcentu); font-weight: 600; font-size: 16px; white-space: nowrap; }
  .cta:hover { background: #F5C935; }
  .tl-obrys { display: inline-flex; align-items: center; height: 52px; padding: 0 22px; border-radius: 6px; border: 1.5px solid var(--text); font-weight: 600; font-size: 16px; }
  .tl-obrys:hover { background: var(--text); color: var(--pozadi); }

  /* ---------- lišta ---------- */
  .lista { position: fixed; inset: 0 0 auto; z-index: 40; height: 68px; background: var(--plocha); border-bottom: 1px solid var(--linka); }
  .lista .obal { height: 100%; display: flex; align-items: center; gap: 26px; }
  .logo { font-size: 21px; letter-spacing: -.01em; display: inline-flex; align-items: center; gap: 10px; margin-right: auto; }
  .logo i { display: block; width: 22px; height: 6px; background: var(--akcent); border-radius: 1px; }
  .odkazy { display: flex; gap: 24px; font-size: 15.5px; font-weight: 500; }
  .odkazy a:hover, .tel:hover { text-decoration: underline; text-underline-offset: 5px; }
  .tel { font-size: 15.5px; font-weight: 600; white-space: nowrap; }
  .tel .doplnit { font-weight: 500; }
  .tel { display: inline-flex; align-items: center; gap: 6px; }
  .tel .ikona-tel { display: none; width: 17px; height: 17px; flex: none; }
  .lista .cta { height: 44px; padding: 0 18px; font-size: 15px; }
  .menu-tl { display: none; height: 42px; padding: 0 14px; border-radius: 6px; border: 1px solid var(--pole-hrana); font-weight: 600; font-size: 15px; align-items: center; gap: 9px; }
  .menu-tl i { display: block; width: 16px; height: 1.5px; background: currentColor; box-shadow: 0 5px 0 currentColor; transform: translateY(-2.5px); }
  .menu-panel { display: none; }
  .tema-prepinac { border-radius: 6px; }

  /* ---------- hero: dílna, která se při scrollu přiblíží na tým ---------- */
  .hero { position: relative; height: 230svh; background: #1A242D; }
  .hero-pin { position: sticky; top: 0; height: 100svh; overflow: hidden; }
  .hero-foto { position: absolute; left: 0; top: 0; max-width: none; transform-origin: 0 0; filter: var(--foto); will-change: transform; user-select: none; }
  html:not(.js-hero) .hero-foto { width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
  /* tmavá: jemný závoj jen u spodního okraje (pod panely), fotka sama zůstává čistá */
  html[data-tema="tmava"] .hero-pin::before { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none;
    background: linear-gradient(0deg, rgba(13,21,28,.62) 0%, rgba(13,21,28,.28) 34%, rgba(13,21,28,0) 62%); }
  .hero-pin::after { content: ""; position: absolute; left: 0; right: 0; bottom: 0; height: 8px; background: repeating-linear-gradient(90deg, var(--akcent) 0 64px, transparent 64px 84px); }
  .panel { position: absolute; z-index: 2; background: var(--plocha); color: var(--text); border-radius: 6px; box-shadow: 0 18px 50px rgba(8,14,20,.22); }
  .panel-a { left: clamp(18px, 3vw, 44px); bottom: clamp(36px, 6vh, 72px); width: min(640px, calc(100% - 36px)); padding: clamp(24px, 2.6vw, 38px); }
  .panel-a h1 { font-size: clamp(2rem, 3.6vw, 3.4rem); line-height: 1.04; letter-spacing: -.025em; }
  .panel-a .pod { margin-top: 16px; color: var(--tlumeny); max-width: 31em; font-size: 17.5px; }
  .tlacitka { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 24px; }
  .info { display: grid; grid-template-columns: repeat(3, auto); justify-content: start; gap: 6px 32px; margin-top: 26px; padding-top: 18px; border-top: 1px solid var(--linka); font-size: 15px; }
  .info dt { color: var(--tlumeny); }
  .info dd { font-weight: 600; }
  .info dd .doplnit { font-weight: 500; }
  .panel-b { right: clamp(18px, 3vw, 44px); bottom: clamp(36px, 6vh, 72px); width: min(470px, calc(100% - 36px)); padding: clamp(22px, 2.4vw, 32px); opacity: 0; visibility: hidden; }
  .panel-b .disp { font-size: clamp(1.35rem, 1.9vw, 1.75rem); line-height: 1.15; letter-spacing: -.015em; }
  .cisla { display: flex; flex-wrap: wrap; gap: 8px 28px; margin-top: 18px; font-size: 15px; }
  .cisla div { display: flex; gap: 8px; }
  .cisla dt { color: var(--tlumeny); }
  .cisla dd { font-weight: 600; }
  html.bez-zoomu .hero { height: auto; }
  html.bez-zoomu .hero-pin { position: relative; }
  html.bez-zoomu .panel-b { display: none; }

  /* ---------- služby a ceny: vlevo fotka vybrané služby, vpravo ceník ---------- */
  .sluzby { padding: clamp(84px, 9vw, 132px) 0 clamp(80px, 8vw, 120px); }
  .hlava { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 16px clamp(28px, 4vw, 64px); align-items: end; margin-bottom: clamp(30px, 3.6vw, 52px); }
  .hlava h2 { font-size: clamp(1.9rem, 3.1vw, 2.9rem); line-height: 1.06; letter-spacing: -.025em; }
  .hlava p { color: var(--tlumeny); max-width: 34em; }
  .cenik { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(28px, 4vw, 64px); align-items: start; }
  .ram { position: sticky; top: 100px; aspect-ratio: 4 / 4.4; max-height: calc(100svh - 140px); border-radius: 6px; overflow: hidden; background: var(--plocha); }
  .ram img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0; transition: opacity .45s ease; }
  .ram img.vybrana { opacity: 1; }
  .sl { position: relative; display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 28px; padding: 24px 0 24px 26px; border-top: 1px solid var(--linka); }
  .sl:last-child { border-bottom: 1px solid var(--linka); }
  .sl::before { content: ""; position: absolute; left: 0; top: 24px; bottom: 24px; width: 5px; border-radius: 1px; background: var(--akcent); transform: scaleY(0); transform-origin: top; transition: transform .3s ease; }
  .sl.vybrana::before { transform: none; }
  .sl h3 { font-size: clamp(1.1rem, 1.4vw, 1.3rem); line-height: 1.2; letter-spacing: -.01em; }
  .sl p { color: var(--tlumeny); font-size: 16px; max-width: 34em; grid-column: 1; }
  .sl .vpravo { grid-column: 2; grid-row: 1 / span 2; display: flex; flex-direction: column; align-items: flex-end; justify-content: space-between; gap: 10px; text-align: right; }
  .cena { font-weight: 600; font-size: 17px; white-space: nowrap; }
  .cena .doplnit { font-weight: 500; }
  .sl .obj { font-size: 15px; font-weight: 600; text-decoration: underline; text-underline-offset: 4px; text-decoration-thickness: 1px; }
  .sl .obj:hover { text-decoration-thickness: 2px; }
  .sl figure { display: none; }

  /* ---------- pobočky a tým ---------- */
  .firma { padding: clamp(80px, 8vw, 120px) 0; background: var(--plocha); border-top: 1px solid var(--linka); border-bottom: 1px solid var(--linka); }
  .pobocky { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0; border-top: 6px solid var(--akcent); }
  .pobocka { padding: 26px clamp(18px, 2vw, 30px) 28px 0; display: flex; flex-direction: column; gap: 14px; }
  .pobocka figure { margin: 0 0 6px; aspect-ratio: 3 / 2; border-radius: 6px; overflow: hidden; background: var(--pozadi); }
  .pobocka figure img { width: 100%; height: 100%; object-fit: cover; }
  .tym { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 18px); margin-bottom: clamp(40px, 4.4vw, 64px); }
  .tym figure { margin: 0; position: relative; aspect-ratio: 4 / 5; border-radius: 6px; overflow: hidden; background: var(--pozadi); }
  .tym img { width: 100%; height: 100%; object-fit: cover; }
  .tym figcaption { position: absolute; left: 12px; bottom: 12px; padding: 6px 12px; border-radius: 4px; background: var(--plocha); color: var(--text); font-size: 14px; font-weight: 600; }
  .pobocka + .pobocka { padding-left: clamp(18px, 2vw, 30px); border-left: 1px solid var(--linka); }
  .pobocka h3 { font-size: 1.2rem; letter-spacing: -.01em; }
  .pobocka dl { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 8px 18px; font-size: 15.5px; }
  .pobocka dt { color: var(--tlumeny); }
  .pobocka a.obj { margin-top: auto; align-self: flex-start; font-weight: 600; font-size: 15px; text-decoration: underline; text-underline-offset: 4px; }
  .vybava { margin-top: clamp(48px, 5vw, 72px); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: 20px clamp(28px, 4vw, 64px); }
  .vybava h3 { font-size: clamp(1.35rem, 1.9vw, 1.75rem); line-height: 1.15; letter-spacing: -.015em; }
  .vybava > div > p { margin-top: 12px; color: var(--tlumeny); max-width: 30em; }
  .vybava dl { display: grid; grid-template-columns: minmax(0, 1fr) auto; }
  .vybava dl > div { display: contents; }
  .vybava dt, .vybava dd { padding: 14px 0; border-top: 1px solid var(--linka); }
  .vybava dd { text-align: right; font-weight: 600; }
  .vybava dd .doplnit { font-weight: 500; }

  /* ---------- přizpůsobení počtu poboček (html[data-pobocky]) ---------- */
  html[data-pobocky="1"] [data-jen="vice"], html:not([data-pobocky="1"]) [data-jen="1"] { display: none !important; }
  html[data-pobocky="1"] .pobocka:nth-child(n+2), html[data-pobocky="2"] .pobocka:nth-child(n+3) { display: none; }
  html[data-pobocky="2"] .pobocky { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  html[data-pobocky="1"] .pobocky { grid-template-columns: 1fr; }
  html[data-pobocky="1"] .pobocka { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); column-gap: clamp(28px, 4vw, 64px); row-gap: 14px; align-content: start; padding-right: 0; }
  html[data-pobocky="1"] .pobocka figure { grid-column: 1; grid-row: 1 / span 4; aspect-ratio: 16 / 10; margin: 0; }
  html[data-pobocky="1"] .pobocka > :not(figure) { grid-column: 2; }
  html[data-pobocky="1"] .pobocka dl { align-self: start; padding-top: 6px; }
  html[data-pobocky="1"] .pobocka a.obj { margin-top: 0; }

  /* ---------- objednávka (pole jako V10 + pobočka, den a čas přistavení) ---------- */
  .objednat { padding: clamp(84px, 9vw, 132px) 0 clamp(80px, 8vw, 120px); }
  .obj-form { background: var(--plocha); border: 1px solid var(--linka); border-radius: 6px; padding: 4px clamp(20px, 3vw, 44px) clamp(24px, 3vw, 36px); }
  .obj-skupina { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 16px clamp(28px, 4vw, 56px); padding: clamp(24px, 2.6vw, 34px) 0; border-bottom: 1px solid var(--linka); }
  .obj-titul { font-size: clamp(1.15rem, 1.5vw, 1.35rem); line-height: 1.2; letter-spacing: -.01em; }
  .obj-napoveda { margin-top: 10px; color: var(--tlumeny); font-size: 15px; max-width: 22em; }
  .obj-pole { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 20px 16px; align-content: start; }
  .f-pole { display: flex; flex-direction: column; gap: 8px; min-width: 0; border: 0; margin: 0; padding: 0; }
  .f-pole.cela { grid-column: 1 / -1; }
  .f-pole[hidden] { display: none; }
  .f-pole > label, .f-pole > legend { font-size: 15px; font-weight: 600; margin: 0; padding: 0; }
  .f-pole > legend { margin-bottom: 8px; }
  .f-pole small { font-weight: 400; font-size: 13.5px; color: var(--tlumeny); }
  .f-pole input:not([type="radio"]):not([type="checkbox"]), .f-pole select, .f-pole textarea {
    width: 100%; height: 52px; border-radius: 6px; border: 1px solid var(--pole-hrana); background: var(--pozadi); color: var(--text);
    font: inherit; font-size: 16px; padding: 0 16px; margin: 0; }
  .f-pole textarea { height: auto; min-height: 128px; padding: 13px 16px; resize: vertical; line-height: 1.5; }
  .f-pole ::placeholder { color: var(--tlumeny); opacity: 1; }
  .f-pole input:not([type="radio"]):not([type="checkbox"]):focus-visible, .f-pole select:focus-visible, .f-pole textarea:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-color: var(--text); }
  .obj-form .f-pole input[aria-invalid="true"]:not([type="checkbox"]):not([type="radio"]), .obj-form .f-pole textarea[aria-invalid="true"] { border-color: var(--chyba); box-shadow: inset 0 0 0 1px var(--chyba); }
  .vyber { position: relative; display: block; color: var(--text); }
  .vyber[hidden] { display: none; }
  .vyber select { -webkit-appearance: none; appearance: none; padding-right: 46px; cursor: pointer; }
  .vyber select:disabled { color: var(--tlumeny); cursor: not-allowed; opacity: 1; }
  .vyber::after { content: ""; position: absolute; right: 20px; top: 50%; width: 8px; height: 8px; border-right: 1.5px solid currentColor; border-bottom: 1.5px solid currentColor; transform: translateY(-70%) rotate(45deg); pointer-events: none; }
  .vyber select option { background: var(--plocha); color: var(--text); }
  .druhy { display: flex; flex-wrap: wrap; gap: 8px; }
  .druh { position: relative; cursor: pointer; }
  .druh span { display: inline-flex; align-items: center; height: 46px; padding: 0 22px; border-radius: 6px; border: 1px solid var(--pole-hrana); background: var(--pozadi); font-size: 15.5px; }
  .druh:hover span { border-color: var(--text); }
  .druh input:checked + span { background: var(--text); color: var(--plocha); border-color: var(--text); }
  .druh input:focus-visible + span, .je-chyba .druh input:focus + span { outline: 2px solid var(--text); outline-offset: 3px; }
  .je-chyba .druh input:not(:checked) + span { border-color: var(--chyba); box-shadow: inset 0 0 0 1px var(--chyba); }
  .zaskrtavaci { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 250px), 1fr)); gap: 8px; }
  .zaskrt { position: relative; display: block; cursor: pointer; }
  .zaskrt-plocha { display: flex; align-items: center; gap: 12px; min-height: 52px; height: 100%; padding: 12px 14px; border-radius: 6px; border: 1px solid var(--pole-hrana); background: var(--pozadi); font-size: 15.5px; line-height: 1.3; }
  .zaskrt:hover .zaskrt-plocha { border-color: var(--text); }
  .zaskrt .box { flex: none; width: 20px; height: 20px; border-radius: 4px; border: 1.5px solid var(--tlumeny); display: grid; place-items: center; }
  .zaskrt .box::after { content: ""; width: 10px; height: 5px; border-left: 2px solid var(--na-akcentu); border-bottom: 2px solid var(--na-akcentu); transform: translateY(-1px) rotate(-45deg); opacity: 0; }
  .zaskrt input:checked + .zaskrt-plocha { border-color: var(--text); }
  .zaskrt input:checked + .zaskrt-plocha .box { background: var(--akcent); border-color: var(--akcent); }
  .zaskrt input:checked + .zaskrt-plocha .box::after { opacity: 1; }
  .zaskrt input:focus-visible + .zaskrt-plocha, .je-chyba .zaskrt input:focus + .zaskrt-plocha { outline: 2px solid var(--text); outline-offset: 2px; }
  .je-chyba .zaskrt-plocha { border-color: var(--chyba); box-shadow: inset 0 0 0 1px var(--chyba); }
  .chyba { display: flex; gap: 8px; align-items: baseline; font-size: 14px; color: var(--chyba); font-weight: 500; }
  .chyba::before { content: "!"; flex: none; width: 16px; height: 16px; border-radius: 50%; background: var(--chyba); color: var(--plocha); font-size: 11px; font-weight: 700; line-height: 16px; text-align: center; transform: translateY(2px); }
  .chyba[hidden] { display: none; }
  .obj-odeslat { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr); gap: 16px clamp(28px, 4vw, 56px); padding-top: clamp(22px, 2.4vw, 30px); }
  .obj-odeslat > div { grid-column: 2; display: flex; align-items: center; justify-content: space-between; gap: 16px 24px; flex-wrap: wrap; }
  .obj-hlaska { color: var(--tlumeny); font-size: 15px; max-width: 26em; }
  .obj-hlaska.ukazka { color: var(--text); }
  .obj-hlaska.chybi { color: var(--chyba); font-weight: 500; }
  input[type="date"]::-webkit-calendar-picker-indicator { opacity: .7; cursor: pointer; }
  html[data-tema="tmava"] input[type="date"]::-webkit-calendar-picker-indicator { filter: invert(1); }

  /* ---------- rady ---------- */
  .rady { padding: 0 0 clamp(80px, 8vw, 120px); }
  .clanky { border-top: 1px solid var(--linka); }
  .clanek { border-bottom: 1px solid var(--linka); }
  .clanek summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 44px; gap: 10px clamp(28px, 4vw, 64px); align-items: start; padding: 26px 0; }
  .clanek summary::-webkit-details-marker { display: none; }
  .clanek summary h3 { font-size: clamp(1.1rem, 1.45vw, 1.35rem); line-height: 1.22; letter-spacing: -.01em; }
  .clanek summary p { color: var(--tlumeny); font-size: 16px; }
  .plus { width: 40px; height: 40px; border-radius: 6px; border: 1px solid var(--pole-hrana); display: grid; place-items: center; justify-self: end; }
  .plus::before { content: ""; width: 14px; height: 14px; background: linear-gradient(currentColor, currentColor) center / 14px 1.5px no-repeat, linear-gradient(currentColor, currentColor) center / 1.5px 14px no-repeat; }
  .clanek[open] .plus::before { background: linear-gradient(currentColor, currentColor) center / 14px 1.5px no-repeat; }
  .clanek summary:hover .plus { border-color: var(--text); }
  .clanek .telo { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr) 44px; gap: 0 clamp(28px, 4vw, 64px); padding-bottom: 30px; }
  .clanek .telo > div { grid-column: 2; display: flex; flex-direction: column; gap: 14px; max-width: 38em; }
  .clanek .telo a { text-decoration: underline; text-underline-offset: 4px; font-weight: 600; }

  /* ---------- hodnocení Google (úplně dole) ---------- */
  .hodnoceni { border-top: 1px solid var(--linka); padding: clamp(64px, 7vw, 100px) 0; text-align: center; }
  .hodnoceni h2 { font-size: clamp(1.4rem, 2vw, 1.85rem); letter-spacing: -.015em; }
  .znamka { margin-top: 22px; display: flex; flex-direction: column; align-items: center; gap: 10px; --hodnota: 0; }
  .hvezdy { position: relative; display: block; width: 170px; height: 30px; color: var(--text); }
  .hvezdy svg { width: 100%; height: 100%; }
  .hvezdy .plne { position: absolute; inset: 0; width: calc(var(--hodnota) / 5 * 100%); overflow: hidden; color: var(--akcent); }
  .hvezdy .plne svg { width: 170px; }
  .znamka-cislo { font-family: "Unbounded", sans-serif; font-weight: 600; font-size: 1.6rem; }
  .znamka-pocet { color: var(--tlumeny); }

  /* ---------- patička ---------- */
  .pata { background: var(--plocha); border-top: 6px solid var(--akcent); padding: 44px 0 40px; font-size: 15.5px; }
  .pata .radek { display: grid; grid-template-columns: minmax(0, 1.4fr) repeat(4, minmax(0, 1fr)); gap: 18px 28px; align-items: start; }
  .pata .logo { margin: 0; }
  .pata dt { color: var(--tlumeny); font-size: 14px; }
  .pata dd { font-weight: 600; }
  .pata dd .doplnit { font-weight: 500; }
  .pata .navrh { margin-top: 34px; padding-top: 18px; border-top: 1px solid var(--linka); color: var(--tlumeny); font-size: 14px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px; }
  .pata .navrh a { text-decoration: underline; text-underline-offset: 3px; }

  @media (max-width: 1180px) {
    .odkazy { gap: 18px; font-size: 15px; }
    .obj-skupina, .obj-odeslat { grid-template-columns: minmax(0, 3fr) minmax(0, 7fr); }
  }
  @media (max-width: 1040px) {
    .odkazy, .lista .obal > .cta { display: none; }
    .menu-tl { display: inline-flex; }
    .menu-panel { position: absolute; top: 100%; right: clamp(18px, 3vw, 44px); min-width: 240px; flex-direction: column; padding: 8px; border-radius: 6px; background: var(--plocha); border: 1px solid var(--linka); box-shadow: 0 18px 40px rgba(8,14,20,.18); }
    .menu-panel.otevreno { display: flex; }
    .menu-panel a { padding: 12px 14px; border-radius: 4px; font-weight: 500; }
    .menu-panel a:hover { background: var(--pozadi); }
    .menu-panel .cta { margin-top: 6px; height: 48px; }
    .pata .radek { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 860px) {
    .hlava, .cenik, .vybava { grid-template-columns: 1fr; }
    .ram { display: none; }
    .sl { grid-template-columns: 112px minmax(0, 1fr); gap: 4px 16px; padding: 20px 0; }
    .sl::before { display: none; }
    .sl figure { display: block; grid-column: 1; grid-row: 1 / span 3; aspect-ratio: 1; border-radius: 6px; overflow: hidden; background: var(--plocha); }
    .sl figure img { width: 100%; height: 100%; object-fit: cover; }
    .sl h3, .sl p { grid-column: 2; }
    .sl .vpravo { grid-column: 2; grid-row: auto; flex-direction: row; align-items: baseline; justify-content: space-between; text-align: left; margin-top: 6px; }
    .pobocky { grid-template-columns: 1fr; border-top: 0; }
    .tym { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 8px; }
    .tym figure { aspect-ratio: 3 / 4; }
    .tym figcaption { left: 6px; bottom: 6px; padding: 4px 8px; font-size: 12.5px; }
    .pobocka, .pobocka + .pobocka { padding: 22px 0; border-left: 0; border-top: 6px solid var(--akcent); }
    html[data-pobocky="1"] .pobocka { grid-template-columns: 1fr; }
    html[data-pobocky="1"] .pobocka figure { grid-row: auto; }
    html[data-pobocky="1"] .pobocka > :not(figure) { grid-column: 1; }
    html[data-pobocky="2"] .pobocky { grid-template-columns: 1fr; }
    .clanek summary { grid-template-columns: minmax(0, 1fr) 40px; }
    .clanek summary p { grid-column: 1; }
    .clanek summary .plus { grid-column: 2; grid-row: 1; }
    .clanek .telo { grid-template-columns: 1fr; }
    .clanek .telo > div { grid-column: 1; }
  }
  @media (max-width: 760px) {
    body { font-size: 16.5px; }
    .lista { height: 62px; }
    .lista .obal { gap: 10px; }
    .tel { font-size: 14px; }
    .tel .pref { display: none; }
    .tel .ikona-tel { display: inline-block; }
    .hero { height: 200svh; }
    .panel-a { left: 12px; right: 12px; bottom: 26px; width: auto; padding: 22px 20px; }
    .panel-a h1 { font-size: 1.75rem; }
    .panel-a .pod { font-size: 16px; margin-top: 12px; }
    .tlacitka { margin-top: 18px; }
    .tlacitka a { flex: 1 1 auto; height: 48px; }
    .info { grid-template-columns: 1fr; gap: 2px; margin-top: 18px; padding-top: 14px; }
    .info div { display: flex; gap: 10px; }
    .panel-b { left: 12px; right: 12px; bottom: 26px; width: auto; padding: 20px; }
    .obj-skupina, .obj-odeslat { grid-template-columns: 1fr; }
    .obj-odeslat > div { grid-column: 1; }
    .obj-pole { grid-template-columns: 1fr; }
    .obj-form { padding: 0 16px 22px; }
    .pata .radek { grid-template-columns: 1fr; }
  }
  @media (max-width: 760px) and (max-height: 700px) {
    .panel-a .pod { display: none; }
  }
  @media (min-width: 761px) {
    .info div { display: contents; }
    .info dt { grid-row: 1; }
    .info dd { grid-row: 2; }
  }
</style>
<style id="pz-css">
.pz-hod{padding:clamp(56px,9vw,104px) 24px;text-align:center;color:inherit;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
.pz-hod .pz-in{max-width:560px;margin:0 auto}
.pz-hod .pz-cislo{font-size:clamp(44px,7vw,72px);line-height:1;margin:0;font-weight:500;letter-spacing:-.02em}
.pz-hod .pz-cislo span{font-size:.32em;opacity:.7;letter-spacing:0;margin-left:.3em}
.pz-hod .pz-hv{position:relative;display:inline-block;font-size:22px;letter-spacing:4px;margin:14px 0 8px;color:color-mix(in srgb,currentColor 22%,transparent)}
.pz-hod .pz-hv b{position:absolute;inset:0 auto 0 0;overflow:hidden;white-space:nowrap;color:var(--akcent,var(--accent,#E3A008));font-weight:400}
.pz-hod .pz-pod{margin:0 0 14px;opacity:.78}
.pz-hod a{color:inherit}
.pz-pata{padding:28px 24px 34px;text-align:center;font-size:14px;opacity:.85;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
.pz-pata p{margin:4px 0}.pz-pata a{color:inherit}
.pz-credit{font-size:12px;opacity:.7;text-align:center;padding:0 24px 22px}
.pz-credit a{color:inherit}
.pz-pv{position:fixed;left:12px;right:12px;bottom:12px;z-index:2147483000;background:#111827;color:#fff;font:14px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif;
 padding:10px 14px;border-radius:14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3)}
.pz-pv a{color:#fff}.pz-pv .pz-cta{background:#fff;color:#111827;text-decoration:none;font-weight:700;padding:.4em .85em;border-radius:999px}
.pz-pv button{background:none;border:0;color:#fff;opacity:.8;cursor:pointer;font:inherit;text-decoration:underline}
.pz-pv.pz-skryt{display:none}
@media print{.pz-pv{display:none}}
</style><style>.lista .logo{white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:44vw}</style></head>
<body>
<header class="lista">
<div class="obal">
<a aria-label="{{ brand }}, autoservis – úvod" class="logo" href="#"><i aria-hidden="true"></i>{{ brand }}</a>
<nav aria-label="Hlavní" class="odkazy">
<a href="#sluzby">Služby a ceny</a><a data-jen="vice" href="#pobocky">Pobočky a tým</a><a data-jen="1" href="#pobocky">Naše dílna</a><a href="#rady">Rady</a><a href="#kontakt">Kontakt</a>
</nav>
{% if phone %}<a aria-label="Telefon {{ phone }}" class="tel" href="tel:{{ phone_href }}"><svg aria-hidden="true" class="ikona-tel" fill="none" stroke="currentColor" stroke-width="1.8" viewbox="0 0 24 24"><path d="M5 3.5h3.2l1.6 4.2-2.1 1.4a11 11 0 0 0 5.2 5.2l1.4-2.1 4.2 1.6V17a2.5 2.5 0 0 1-2.7 2.5A15.5 15.5 0 0 1 2.5 6.2 2.5 2.5 0 0 1 5 3.5z"></path></svg><span class="pref">Tel. </span>{{ phone }}</a>{% endif %}
<a class="cta" href="#objednat">Objednat</a>
<button aria-controls="menu-panel" aria-expanded="false" class="menu-tl" data-menu-zaklad="" type="button"><i aria-hidden="true"></i>Menu</button>
<button aria-label="Přepnout na tmavý režim" aria-pressed="false" class="tema-prepinac" data-prepnout-tema="" type="button">
<svg aria-hidden="true" class="ikona-slunce" fill="none" stroke="currentColor" stroke-width="1.6" viewbox="0 0 24 24"><circle cx="12" cy="12" r="4.2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M4.6 4.6l1.6 1.6M17.8 17.8l1.6 1.6M2.5 12h2.2M19.3 12h2.2M4.6 19.4l1.6-1.6M17.8 6.2l1.6-1.6"></path></svg>
<svg aria-hidden="true" class="ikona-mesic" fill="none" stroke="currentColor" stroke-width="1.6" viewbox="0 0 24 24"><path d="M20 14.6A8.2 8.2 0 0 1 9.4 4a8.2 8.2 0 1 0 10.6 10.6z"></path></svg>
</button>
<nav aria-label="Menu" class="menu-panel" id="menu-panel">
<a href="#sluzby">Služby a ceny</a><a data-jen="vice" href="#pobocky">Pobočky a tým</a><a data-jen="1" href="#pobocky">Naše dílna</a><a href="#rady">Rady</a><a href="#kontakt">Kontakt</a>
<a class="cta" href="#objednat">Objednat servis</a>
</nav>
</div>
</header>
<main>

<section aria-labelledby="hero-h" class="hero" id="hero">
<div class="hero-pin">
<img alt="Prostorná světlá dílna se zvedáky: mechanici v červených montérkách pracují u aut s otevřenými kapotami, uprostřed technik přijímá auto od zákaznice" class="hero-foto" data-ohnisko="0.60 0.50" data-ohnisko-mobil="0.675 0.49" decoding="async" fetchpriority="high" height="2725" src="{{ A }}img/V13-autoservis-dilna.webp" width="5400"/>
<div class="panel panel-a">
<h1 data-slozit="" id="hero-h">Dílna, kde se na vaše auto najde místo.</h1>
<p class="pod" data-po-nadpisu="">Servis osobních aut s týmem mechaniků. Objednáte se online, termín vám potvrdíme.</p>
<div class="tlacitka" data-po-nadpisu="">
<a class="cta" href="#objednat">Objednat servis</a>
<a class="tl-obrys" href="#sluzby">Ceník služeb</a>
</div>
<dl class="info">
{% if hours_today %}<div><dt>Otevřeno</dt><dd>{{ hours_today }}</dd></div>{% endif %}

{% if address %}<div data-jen="1"><dt>Adresa</dt><dd><a href="#pobocky">{{ address }}</a></dd></div>{% endif %}
{% if phone %}<div><dt>Telefon</dt><dd><a href="tel:{{ phone_href }}">{{ phone }}</a></dd></div>{% endif %}
</dl>
</div>
<div aria-hidden="true" class="panel panel-b">
<p class="disp">Auto převezme, opraví a předá tým, který ho zná od příjmu.</p>

</div>
</div>
</section>

<section aria-labelledby="sluzby-h" class="sluzby" id="sluzby">
<div class="obal">
<div class="hlava">
<h2 data-odhalit="" id="sluzby-h">Služby a ceny</h2>
<p data-odhalit="">Ceny jsou orientační a zahrnují práci. Přesnou cenu vám řekneme po prohlídce auta, ještě než začneme.</p>
</div>
<div class="cenik">
<div aria-hidden="true" class="ram" data-ram=""></div>
<ul data-sluzby="autoservis">
<li class="sl" data-sluzba="servis">
<figure><img alt="Mechanik kontroluje motor SUV s otevřenou kapotou v dílně" decoding="async" height="750" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-servis.webp" width="1000"/></figure>
<h3>Servisní prohlídka</h3>
<p>Prohlídka podle servisního plánu výrobce, výměna náplní a filtrů a zápis do servisní knížky.</p>
<div class="vpravo"><span class="cena" data-cena="servis">{{ price_text }}</span><a class="obj" data-objednat="servis" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="olej">
<figure><img alt="Mechanik v rukavicích nalévá nový olej do motoru" decoding="async" height="666" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-olej.webp" width="1000"/></figure>
<h3>Výměna oleje a filtrů</h3>
<p>Olej podle normy pro váš motor, nový olejový filtr a kontrola ostatních kapalin.</p>
<div class="vpravo"><span class="cena" data-cena="olej">{{ price_text }}</span><a class="obj" data-objednat="olej" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="brzdy">
<figure><img alt="Brzdový kotouč a třmen na nápravě bez kola" decoding="async" height="666" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-brzdy.webp" width="1000"/></figure>
<h3>Brzdy</h3>
<p>Destičky, kotouče a brzdová kapalina. Změříme opotřebení a měníme jen to, co je potřeba.</p>
<div class="vpravo"><span class="cena" data-cena="brzdy">{{ price_text }}</span><a class="obj" data-objednat="brzdy" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="diagnostika">
<figure><img alt="Technik v autě čte chybové kódy na notebooku připojeném k vozu" decoding="async" height="1500" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-diagnostika.webp" width="1000"/></figure>
<h3>Diagnostika</h3>
<p>Načteme chybové kódy, příčinu ověříme měřením a řekneme vám, co je potřeba opravit.</p>
<div class="vpravo"><span class="cena" data-cena="diagnostika">{{ price_text }}</span><a class="obj" data-objednat="diagnostika" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="pneu">
<figure><img alt="Mechanik povoluje šrouby kola rázovým utahovákem" decoding="async" height="664" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-pneu.webp" width="1000"/></figure>
<h3>Pneuservis a geometrie</h3>
<p>Přezutí, vyvážení kol a seřízení geometrie, aby auto jelo rovně a pneumatiky se nesjížděly nerovnoměrně.</p>
<div class="vpravo"><span class="cena" data-cena="pneu">{{ price_text }}</span><a class="obj" data-objednat="pneu" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="klimatizace">
<figure><img alt="Kulatý výdech ventilace na palubní desce" decoding="async" height="1250" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-klima.webp" width="1000"/></figure>
<h3>Klimatizace</h3>
<p>Kontrola těsnosti, doplnění chladiva a dezinfekce výparníku, aby v kabině nebyl cítit zatuchlý zápach.</p>
<div class="vpravo"><span class="cena" data-cena="klimatizace">{{ price_text }}</span><a class="obj" data-objednat="klimatizace" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="stk">
<figure><img alt="Zadní náprava a výfuk auta při pohledu zespodu" decoding="async" height="447" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-podvozek.webp" width="1000"/></figure>
<h3>Příprava na STK</h3>
<p>Projdeme podvozek, světla, brzdy a emise a opravíme, co by na stanici technické kontroly neprošlo.</p>
<div class="vpravo"><span class="cena" data-cena="stk">{{ price_text }}</span><a class="obj" data-objednat="stk" href="#objednat">Objednat</a></div>
</li>
<li class="sl" data-sluzba="rozvody">
<figure><img alt="Rozvodový řetěz a ozubená kola v motoru" decoding="async" height="1502" loading="lazy" src="{{ A }}img/V13-autoservis-sluzba-rozvody.webp" width="1000"/></figure>
<h3>Rozvody</h3>
<p>Výměna rozvodového řemene nebo řetězu i s napínákem a kladkami podle předpisu výrobce.</p>
<div class="vpravo"><span class="cena" data-cena="rozvody">{{ price_text }}</span><a class="obj" data-objednat="rozvody" href="#objednat">Objednat</a></div>
</li>
</ul>
</div>
</div>
</section>

<section aria-labelledby="pobocky-h" class="firma" id="pobocky">
<div class="obal">
<div class="hlava">
<h2 data-odhalit="" id="pobocky-h"><span data-jen="vice">Pobočky a tým</span><span data-jen="1">Naše dílna</span></h2>
<p data-odhalit=""><span data-jen="vice">Vyberte si pobočku, která je vám nejblíž. </span>Rozsah opravy i cenu domluvíte se servisním technikem ještě před začátkem práce.</p>
</div>
<div class="tym" data-odhalit="deti">
<figure><img alt="Servisní technik s tabletem přijímá auto od zákaznice" decoding="async" height="1000" loading="lazy" src="{{ A }}img/V13-autoservis-tym-prijem.webp" width="800"/><figcaption>Příjem auta</figcaption></figure>
<figure><img alt="Mechanik v rukavicích pracuje v motorovém prostoru" decoding="async" height="1000" loading="lazy" src="{{ A }}img/V13-autoservis-tym-motor.webp" width="800"/><figcaption>Opravy motoru</figcaption></figure>
<figure><img alt="Mechanik kontroluje podvozek auta na zvedáku" decoding="async" height="1000" loading="lazy" src="{{ A }}img/V13-autoservis-tym-podvozek.webp" width="800"/><figcaption>Podvozek a STK</figcaption></figure>
</div>
<div class="pobocky" data-odhalit="deti">
<article class="pobocka" data-pobocka="1">
<figure><img alt="Ilustrační foto dílny – nahradí se fotkou pobočky" decoding="async" height="666" loading="lazy" src="{{ A }}img/V13-autoservis-pobocka-1.webp" width="1000"/></figure>
<h3 data-jen="vice">{{ brand }}</h3>
<dl><dt>Adresa</dt>{% if address %}<dd>{{ address }}</dd>{% endif %}<dt>Otevřeno</dt>{% if hours_today %}<dd>{{ hours_today }}</dd>{% endif %}<dt>Telefon</dt>{% if phone %}<dd><a href="tel:{{ phone_href }}">{{ phone }}</a></dd>{% endif %}<dt data-jen="1">Mapa</dt>{% if maps_url %}<dd data-jen="1"><a data-mapa="" href="{{ maps_url }}" rel="noopener" target="_blank">{{ t_map }}</a></dd>{% endif %}</dl>
<a class="obj" data-jen="vice" data-na-pobocku="1" href="#objednat">Objednat na tuto pobočku</a>
<a class="obj" data-jen="1" href="#objednat">Objednat servis</a>
</article>
<article class="pobocka" data-pobocka="2">
<figure><img alt="Ilustrační foto dílny – nahradí se fotkou pobočky" decoding="async" height="666" loading="lazy" src="{{ A }}img/V13-autoservis-pobocka-2.webp" width="1000"/></figure>
<h3>{{ brand }}</h3>
<dl><dt>Adresa</dt>{% if address %}<dd>{{ address }}</dd>{% endif %}<dt>Otevřeno</dt>{% if hours_today %}<dd>{{ hours_today }}</dd>{% endif %}<dt>Telefon</dt>{% if phone %}<dd><a href="tel:{{ phone_href }}">{{ phone }}</a></dd>{% endif %}</dl>
<a class="obj" data-na-pobocku="2" href="#objednat">Objednat na tuto pobočku</a>
</article>
<article class="pobocka" data-pobocka="3">
<figure><img alt="Ilustrační foto dílny – nahradí se fotkou pobočky" decoding="async" height="666" loading="lazy" src="{{ A }}img/V13-autoservis-pobocka-3.webp" width="1000"/></figure>
<h3>{{ brand }}</h3>
<dl><dt>Adresa</dt>{% if address %}<dd>{{ address }}</dd>{% endif %}<dt>Otevřeno</dt>{% if hours_today %}<dd>{{ hours_today }}</dd>{% endif %}<dt>Telefon</dt>{% if phone %}<dd><a href="tel:{{ phone_href }}">{{ phone }}</a></dd>{% endif %}</dl>
<a class="obj" data-na-pobocku="3" href="#objednat">Objednat na tuto pobočku</a>
</article>
</div>

</div>
</section>

<section aria-labelledby="objednat-h" class="objednat" id="objednat">
<div class="obal">
<div class="hlava">
<h2 data-odhalit="" id="objednat-h">Objednat servis</h2>
<p data-odhalit="">Napište, co auto potřebuje a kdy se vám hodí ho přistavit. Ozveme se a termín potvrdíme.</p>
</div>
<form aria-labelledby="objednat-h" class="obj-form" data-formular="objednavka" novalidate="">
<div class="obj-skupina">
<h3 class="obj-titul">Kontakt na vás</h3>
<div class="obj-pole">
<div class="f-pole cela">
<label for="f-jmeno">Jméno a příjmení</label>
<input autocomplete="name" id="f-jmeno" name="jmeno" required="" type="text"/>
<span class="chyba" hidden="" id="e-jmeno">Vyplňte jméno a příjmení.</span>
</div>
<div class="f-pole">
<label for="f-telefon">Telefon</label>
<input autocomplete="tel" id="f-telefon" inputmode="tel" name="telefon" required="" type="tel"/>
<span class="chyba" hidden="" id="e-telefon">Vyplňte telefon, aspoň 9 číslic.</span>
</div>
<div class="f-pole">
<label for="f-email">E-mail <small>(nepovinné)</small></label>
<input autocomplete="email" id="f-email" name="email" type="email"/>
<span class="chyba" hidden="" id="e-email">Zkontrolujte e-mail, chybí v něm zavináč nebo doména.</span>
</div>
</div>
</div>
<div class="obj-skupina">
