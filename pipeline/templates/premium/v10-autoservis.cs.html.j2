<body>
<header class="lista">
<a aria-label="{{ brand }}, autoservis – úvod" class="logo" href="#">{{ brand }}</a>
<nav aria-label="Hlavní" class="odkazy">
<a aria-current="page" href="#objednat">Objednat</a><a href="#sluzby">Služby</a><a href="#sluzby">Ceník</a><a href="#kontakt">Kontakt</a>
</nav>
<div class="vpravo">
{% if phone %}<a class="tel" href="tel:{{ phone_href }}">Tel. {{ phone }}</a>{% endif %}
<button aria-label="Přepnout na tmavý režim" aria-pressed="false" class="tema-prepinac" data-prepnout-tema="" type="button">
<svg aria-hidden="true" class="ikona-slunce" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
<svg aria-hidden="true" class="ikona-mesic" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
</button>
<button aria-controls="menu" aria-expanded="false" class="menu-tl" data-menu-zaklad="" type="button"><i></i>Menu</button>
</div>
<nav aria-label="Menu" class="menu-panel" hidden="" id="menu">
<a href="#objednat">Objednat</a><a href="#sluzby">Služby</a><a href="#sluzby">Ceník</a><a href="#kontakt">Kontakt</a>
{% if phone %}<a class="tel-m" href="tel:{{ phone_href }}"><span>Zavolat</span>{{ phone }}</a>{% endif %}
</nav>
</header>
<main>
<section aria-label="Úvod" class="hero" id="hero">
<div class="foto">
<img alt="Světlá dílna se zvedákem: mechanik v pracovní bundě se sklání pod otevřenou kapotu sedanu, vedle ponk s nářadím" fetchpriority="high" height="1600" src="{{ A }}img/V10-autoservis-dilna2.webp" width="2400"/>
<img alt="" aria-hidden="true" class="svetlo" height="1600" src="{{ A }}img/V10-autoservis-dilna2.webp" width="2400"/>
</div>
<div class="hlava">
<h1 data-slozit="">Opravíme, co je potřeba.</h1>
<p data-po-nadpisu="0.2">Než začneme, zavoláme vám s tím, co jsme našli a kolik to bude stát. Rozhodnete vy.</p>
</div>
<p class="roh mono" data-po-nadpisu="0.3">{% if hours_today %}<span>Otevřeno {{ hours_today }}</span>{% endif %}{% if address %}<span>Adresa {{ address }}</span>{% endif %}{% if phone %}<a href="tel:{{ phone_href }}">Telefon {{ phone }}</a>{% endif %}</p>
</section>
<section class="sluzby" id="sluzby">
<div class="sluzby-hlava">
<h2 data-odhalit="">S čím k nám přijet</h2>
<p class="pod" data-odhalit="">Na každou práci dostanete předem odhad. Když se cena změní, nejdřív voláme.</p>
</div>

<ul class="radky" data-odhalit="deti" data-sluzby="autoservis">
<li data-sluzba="servis">
<figure class="foto-sl"><img alt="Mechanik se sklání nad otevřeným motorovým prostorem auta" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-servis.webp" width="1200"/></figure>
<div class="text-sl"><h3>Servis podle předpisu výrobce</h3><p>Prohlídku uděláme podle servisního plánu vašeho modelu a všechno zapíšeme do servisní knížky.</p><span class="cena" data-cena="servis">{{ price_text }}</span></div>
</li>
<li data-sluzba="olej">
<figure class="foto-sl"><img alt="Ruka v pracovní rukavici vylévá starý olejový filtr pod zvednutým autem" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-olej.webp" width="1200"/></figure>
<div class="text-sl"><h3>Výměna oleje a filtrů</h3><p>Olej podle specifikace výrobce, nový olejový, vzduchový i kabinový filtr. Hodí se i mezi prohlídkami, když hodně najezdíte.</p><span class="cena" data-cena="olej">{{ price_text }}</span></div>
</li>
<li data-sluzba="brzdy">
<figure class="foto-sl"><img alt="Brzdový kotouč a třmen na zvednutém autě bez kola" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-brzdy.webp" width="1200"/></figure>
<div class="text-sl"><h3>Brzdy</h3><p>Změříme destičky i kotouče a zkontrolujeme brzdovou kapalinu. Měníme jen to, co je opravdu opotřebené.</p><span class="cena" data-cena="brzdy">{{ price_text }}</span></div>
</li>
<li data-sluzba="pneu">
<figure class="foto-sl"><img alt="Mechanik nasazuje pneumatiku na disk v přezouvačce" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-pneu.webp" width="1200"/></figure>
<div class="text-sl"><h3>Pneuservis a uskladnění kol</h3><p>Přezujeme, vyvážíme a změříme hloubku dezénu. Sadu na příští sezónu u nás můžete nechat uskladněnou.</p><span class="cena" data-cena="pneu">{{ price_text }}</span></div>
</li>
<li data-sluzba="klimatizace">
<figure class="foto-sl"><img alt="Výdechy ventilace na palubní desce auta" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-klima.webp" width="1200"/></figure>
<div class="text-sl"><h3>Klimatizace</h3><p>Doplnění chladiva, dezinfekce výparníku a kontrola těsnosti, aby v létě chladila a v kabině nebylo cítit zatuchlo.</p><span class="cena" data-cena="klimatizace">{{ price_text }}</span></div>
</li>
<li data-sluzba="diagnostika">
<figure class="foto-sl"><img alt="Ruce na klávesnici notebooku připojeného k autu diagnostickým kabelem" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-diagnostika.webp" width="1200"/></figure>
<div class="text-sl"><h3>Diagnostika</h3><p>Načteme chybové kódy z řídicích jednotek a příčinu ověříme měřením. Teprve pak se rozhoduje o dílech.</p><span class="cena" data-cena="diagnostika">{{ price_text }}</span></div>
</li>
<li data-sluzba="stk">
<figure class="foto-sl"><img alt="Rozsvícený přední světlomet tmavého auta" decoding="async" height="900" loading="lazy" src="{{ A }}img/V10-autoservis-sluzba-stk.webp" width="1200"/></figure>
<div class="text-sl"><h3>Příprava na STK</h3><p>Projdeme světla, brzdy, tlumiče, výfuk a všechno, na co se technik na stanici dívá. Na kontrolu pak jedete s klidem.</p><span class="cena" data-cena="stk">{{ price_text }}</span></div>
</li>
</ul>
</section>

{# SEKCE_PATCH_V1 #}{% include "_onas.html.j2" %}
<section aria-labelledby="objednat-h" class="objednat" id="objednat">
<div class="objednat-hlava">
<h2 data-odhalit="" id="objednat-h">Objednat servis</h2>
<p class="pod" data-odhalit="">Napište, co vozidlo potřebuje. Podle druhu, značky a roku výroby odhadneme, jak dlouho práce zabere, a ozveme se s termínem.</p>
</div>
<form aria-labelledby="objednat-h" class="obj-form" data-formular="objednavka" novalidate="">
<div class="obj-skupina">
<h3 class="obj-titul">Kontakt na vás</h3>
<div class="obj-pole">
<div class="f-pole cela">
<label for="f-jmeno">Jméno a příjmení</label>
<input autocomplete="name" id="f-jmeno" name="jmeno" required="" type="text"/>
<span class="chyba" hidden="" id="e-jmeno">Vyplňte jméno a příjmení.</span>
</div>
<div class="f-pole">
<label for="f-telefon">Telefon</label>
<input autocomplete="tel" id="f-telefon" inputmode="tel" name="telefon" required="" type="tel"/>
<span class="chyba" hidden="" id="e-telefon">Vyplňte telefon, aspoň 9 číslic.</span>
</div>
<div class="f-pole">
<label for="f-email">E-mail <small>(nepovinné)</small></label>
<input autocomplete="email" id="f-email" name="email" type="email"/>
<span class="chyba" hidden="" id="e-email">Zkontrolujte e-mail, chybí v něm zavináč nebo doména.</span>
</div>
</div>
</div>
<div class="obj-skupina">
<h3 class="obj-titul">Vozidlo</h3>
<div class="obj-pole">
<fieldset class="f-pole cela" id="f-druh">
<legend>Druh vozidla</legend>
<div class="druhy">
<label class="druh"><input class="sr-only" name="druh" required="" type="radio" value="auto"/><span>Auto</span></label>
<label class="druh"><input class="sr-only" name="druh" required="" type="radio" value="motorka"/><span>Motorka</span></label>
<label class="druh"><input class="sr-only" name="druh" required="" type="radio" value="jine"/><span>Jiné</span></label>
</div>
<span class="chyba" hidden="" id="e-druh">Vyberte, jestli jde o auto, motorku, nebo jiné vozidlo.</span>
</fieldset>
<div class="f-pole">
<label for="f-typ" id="l-typ">Typ vozidla <small>(nepovinné)</small></label>
<span class="vyber"><select disabled="" id="f-typ" name="typ"><option value="">Nejdřív zvolte druh vozidla</option></select></span>
<input autocomplete="off" disabled="" hidden="" id="f-typ-jine" name="typ" placeholder="Napište, o jaké vozidlo jde" type="text"/>
</div>
<div class="f-pole">
<label for="f-znacka">Značka</label>
<input autocomplete="off" id="f-znacka" name="znacka" required="" type="text"/>
<span class="chyba" hidden="" id="e-znacka">Vyplňte značku vozidla.</span>
</div>
<div class="f-pole">
<label for="f-model">Model</label>
<input autocomplete="off" id="f-model" name="model" required="" type="text"/>
<span class="chyba" hidden="" id="e-model">Vyplňte model vozidla.</span>
</div>
<div class="f-pole">
<label for="f-rok">Rok výroby <small>(nepovinné)</small></label>
<input autocomplete="off" id="f-rok" inputmode="numeric" name="rok" pattern="[0-9]{4}" placeholder="např. 2016" type="text"/>
<span class="chyba" hidden="" id="e-rok">Rok výroby zadejte čtyřmi číslicemi, od 1950 do letošního roku.</span>
</div>
</div>
</div>
<div class="obj-skupina">
<div>
<h3 class="obj-titul">Co je potřeba</h3>
<p class="obj-napoveda" id="n-sluzby">Zaškrtněte služby z nabídky výš, nebo problém popište vlastními slovy.</p>
</div>
<div class="obj-pole">
<fieldset aria-describedby="n-sluzby" class="f-pole cela" id="f-sluzby">
<legend>Služby</legend>
<div class="zaskrtavaci" data-sluzby-volby=""></div>
<span class="chyba" hidden="" id="e-sluzby">Zaškrtněte aspoň jednu službu, nebo do pole Něco navíc napište, co je potřeba.</span>
</fieldset>
<div class="f-pole cela">
<label for="f-zprava">Něco navíc</label>
<textarea id="f-zprava" name="zprava" placeholder="Např. při brzdění vpředu něco skřípe, termín se mi hodí spíš dopoledne." rows="4"></textarea>
</div>
</div>
</div>
<div class="obj-odeslat">
<div>
<p aria-live="polite" class="obj-hlaska" id="obj-hlaska">Pole bez označení „nepovinné“ je potřeba vyplnit.</p>
<button class="cta" type="submit"><span data-magnet-vnitrek="">Objednat<span aria-hidden="true" class="kruh"><svg fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 16 16"><path d="M3 8h10M9 4l4 4-4 4"></path></svg></span></span></button>
</div>
</div>
</form>
{% include "_mapa.html.j2" %}
</section>
</main>
{% include "_recenze.html.j2" %}
{% if rating %}<section aria-label="Hodnocení na Googlu" class="pz-hod"><div class="pz-in">
<p class="pz-cislo">{{ rating_txt }}<span>z 5</span></p>
<p aria-hidden="true" class="pz-hv">★★★★★<b style="width:{{ rating_pct }}%">★★★★★</b></p>
<p class="pz-pod">Hodnocení na Googlu{% if show_count %} · {{ rating_count }} recenzí{% endif %}</p>
{% if maps_url %}<p><a href="{{ maps_url }}" rel="noopener" target="_blank">Zobrazit na Mapách Google</a></p>{% endif %}
</div></section>{% endif %}<footer class="pz-pata"><p><strong>{{ name }}</strong></p>
{% if address %}<p>{{ address }}</p>{% endif %}
<p>{% if phone %}<a href="tel:{{ phone_href }}">{{ phone }}</a>{% endif %}{% if phone and email %} · {% endif %}{% if email %}<a href="mailto:{{ email }}">{{ email }}</a>{% endif %}</p></footer><script>
  (function () {
    var b = document.querySelector('.menu-tl'), p = document.getElementById('menu');
    b.addEventListener('click', function () { var o = p.hidden; p.hidden = !o; b.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  })();

  /* Objednávka servisu (kolo 5): služby se generují z bloku služeb, typ vozidla podle druhu, kontrola povinných polí,
     fokus na první chybné pole. Nic se neodesílá (ukázka šablony). */
  (function () {
    var f = document.querySelector('[data-formular="objednavka"]'); if (!f) return;
    var hl = document.getElementById('obj-hlaska');
    var typSel = document.getElementById('f-typ'), typTxt = document.getElementById('f-typ-jine'), typLabel = document.getElementById('l-typ');
    var rok = document.getElementById('f-rok'), ROK_MIN = 1950, ROK_MAX = new Date().getFullYear();
    var zprava = document.getElementById('f-zprava'), fsSluzby = document.getElementById('f-sluzby'), volby = f.querySelector('[data-sluzby-volby]');
    var seznam = document.querySelector('ul[data-sluzby="autoservis"]');
    var TYPY = { auto: ['Osobní', 'SUV', 'Kombi', 'Dodávka'], motorka: ['Silniční', 'Enduro / cross', 'Skútr', 'Čtyřkolka'] };
    document.getElementById('e-rok').textContent = 'Rok výroby zadejte čtyřmi číslicemi, od ' + ROK_MIN + ' do ' + ROK_MAX + '.';

    /* zaškrtávací služby = položky li[data-sluzba] nad formulářem (název z h3); zaškrtnuté zůstanou zaškrtnuté i po změně seznamu */
    function nactiSluzby() {
      var byly = {};
      volby.querySelectorAll('input:checked').forEach(function (i) { byly[i.getAttribute('data-id')] = true; });
      volby.textContent = '';
      var polozky = seznam ? seznam.querySelectorAll('li[data-sluzba]') : [];
      Array.prototype.forEach.call(polozky, function (li) {
        var id = li.getAttribute('data-sluzba'), h = li.querySelector('h3');
        var nazev = (h ? h.textContent : id).replace(/[ \t\n\r]+/g, ' ').trim();
        var lab = document.createElement('label'); lab.className = 'zaskrt';
        var inp = document.createElement('input');
        inp.type = 'checkbox'; inp.className = 'sr-only'; inp.name = 'sluzby[]'; inp.id = 'f-sl-' + id;
        inp.value = nazev.replace(/\s+/g, ' '); inp.setAttribute('data-id', id); inp.checked = !!byly[id];
        var pl = document.createElement('span'); pl.className = 'zaskrt-plocha';
        var box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        pl.appendChild(box); pl.appendChild(document.createTextNode(nazev));
        lab.appendChild(inp); lab.appendChild(pl); volby.appendChild(lab);
      });
      fsSluzby.hidden = !polozky.length; /* bez služeb zbývá jen pole Něco navíc */
      if (!document.getElementById('e-sluzby').hidden) over('sluzby');
    }
    nactiSluzby();
    if (seznam && 'MutationObserver' in window) new MutationObserver(nactiSluzby).observe(seznam, { childList: true, subtree: true, characterData: true });

    /* typ vozidla podle druhu: auto / motorka = výběr, jiné = volné pole */
    function nastavTyp(druh) {
      var jine = druh === 'jine';
      typSel.parentNode.hidden = jine; typSel.disabled = jine || !druh;
      typTxt.hidden = !jine; typTxt.disabled = !jine;
      typLabel.htmlFor = jine ? 'f-typ-jine' : 'f-typ';
      if (jine) return;
      typSel.textContent = '';
      var prvni = document.createElement('option'); prvni.value = '';
      prvni.textContent = druh ? 'Vyberte…' : 'Nejdřív zvolte druh vozidla'; typSel.appendChild(prvni);
      (TYPY[druh] || []).forEach(function (t) { var o = document.createElement('option'); o.value = t; o.textContent = t; typSel.appendChild(o); });
    }
    var vybrany = f.querySelector('input[name="druh"]:checked'); /* obnovený stav formuláře po návratu na stránku */
    if (vybrany) nastavTyp(vybrany.value);

    /* pravidla v pořadí polí; cile = prvky, které dostanou aria-invalid / popis chyby, první z nich dostane fokus */
    var radia = function () { return Array.prototype.slice.call(f.querySelectorAll('input[name="druh"]')); };
    var zaskrt = function () { return Array.prototype.slice.call(volby.querySelectorAll('input')); };
    var pole = function (id) { return function () { return [document.getElementById(id)]; }; };
    var hodnota = function (id) { return document.getElementById(id).value.trim(); };
    var PRAVIDLA = {
      jmeno:   { cile: pole('f-jmeno'),   spatne: function () { return !hodnota('f-jmeno'); } },
      telefon: { cile: pole('f-telefon'), spatne: function () { return hodnota('f-telefon').replace(/\D/g, '').length < 9; } },
      email:   { cile: pole('f-email'),   spatne: function () { var v = hodnota('f-email'); return !!v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); } },
      druh:    { cile: radia, skupina: 'f-druh', spatne: function () { return !f.querySelector('input[name="druh"]:checked'); } },
      znacka:  { cile: pole('f-znacka'),  spatne: function () { return !hodnota('f-znacka'); } },
      model:   { cile: pole('f-model'),   spatne: function () { return !hodnota('f-model'); } },
      rok:     { cile: pole('f-rok'),     spatne: function () { var v = hodnota('f-rok'); if (!v) return false; var n = +v; return !/^\d{4}$/.test(v) || n < ROK_MIN || n > ROK_MAX; } },
      sluzby:  { cile: function () { return zaskrt().concat([zprava]); }, skupina: 'f-sluzby', spatne: function () { return !volby.querySelector('input:checked') && !zprava.value.trim(); } }
    };
    function oznac(klic, ano) {
      var p = PRAVIDLA[klic], idChyby = 'e-' + klic;
      document.getElementById(idChyby).hidden = !ano;
      if (p.skupina) document.getElementById(p.skupina).classList.toggle('je-chyba', ano);
      p.cile().forEach(function (el) {
        var d = (el.getAttribute('aria-describedby') || '').split(' ').filter(function (x) { return x && x !== idChyby; });
        if (ano) d.push(idChyby);
        if (d.length) el.setAttribute('aria-describedby', d.join(' ')); else el.removeAttribute('aria-describedby');
        if (ano) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
      });
    }
    function over(klic) { var s = PRAVIDLA[klic].spatne(); oznac(klic, s); return s; }

    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var prvni = null;
      Object.keys(PRAVIDLA).forEach(function (k) {
        if (over(k) && !prvni) prvni = PRAVIDLA[k].cile().filter(function (el) { return !el.closest('[hidden]'); })[0];
      });
      if (prvni) {
        hl.classList.remove('ukazka'); hl.classList.add('chybi');
        hl.textContent = 'Zkontrolujte prosím označená pole.';
        prvni.focus(); return;
      }
      hl.classList.remove('chybi'); hl.classList.add('ukazka');
      hl.textContent = 'Děkujeme, ozveme se vám co nejdříve.';
    });
    /* po opravě chyba zmizí hned; nové chyby se ukazují až při odeslání */
    function klicPole(el) {
      if (el.name === 'druh') return 'druh';
      if (el.name === 'sluzby[]' || el === zprava) return 'sluzby';
      return el.name in PRAVIDLA ? el.name : null;
    }
    function znovu(e) {
      var k = klicPole(e.target);
      if (k && !document.getElementById('e-' + k).hidden) over(k);
    }
    rok.addEventListener('input', function () { var c = rok.value.replace(/\D/g, '').slice(0, 4); if (c !== rok.value) rok.value = c; });
    f.addEventListener('input', znovu);
    f.addEventListener('change', function (e) {
      if (e.target.name === 'druh') nastavTyp(e.target.value);
      znovu(e);
    });
  })();
</script>
<script defer="" src="{{ A }}zaklad.js"></script>
<script id="sluzby-vychozi" type="application/json">
[
  {
