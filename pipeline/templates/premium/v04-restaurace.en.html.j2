  (function(){ var b=document.querySelector('.menu-tl'), p=document.getElementById('menu-panel');
    b.addEventListener('click', function(){ var o=p.classList.toggle('otevreno'); b.setAttribute('aria-expanded', o?'true':'false'); }); })();
</script>
<script>
  /* rezervace je ukázka: formulář nic neodesílá */
  (function(){ var f=document.querySelector('.formular'), h=document.getElementById('rez-hlaska');
    f.addEventListener('submit', function(e){ e.preventDefault(); h.textContent='Thank you, we’ll confirm your reservation.'; h.classList.add('ukazana'); }); })();
</script>
<script defer="" src="{{ A }}zaklad.js"></script>
<script>
  /* Podpisový pohyb V04: lístek vyjede přes stojící fotku.
     p = jak daleko je horní hrana lístku od spodku okna k ~12 % výšky okna (0 → 1).
     Lístek se cestou narovná (−3,2° → 0) a jde o kus pomaleji než stránka (zpoždění 60 px → 0), fotka za ním se nepatrně přiblíží a potemní.
     Řízeno scrollem, běží i s „omezit animace“; ?pohyb=0 nechá lístek rovný. Lišta dostane podklad, až fotka odjede. */
  (function () {
    var q = new URLSearchParams(location.search), staticky = q.get('pohyb') === '0';
    var listek = document.querySelector('.listek'), hero = document.querySelector('.hero'), lista = document.querySelector('.lista');
    var bezi = false;
    function hl(t) { t = Math.min(1, Math.max(0, t)); return t * t * (3 - 2 * t); }
    function kresli() {
      bezi = false;
      var H = window.innerHeight, r = listek.getBoundingClientRect();
      var p = hl((H - r.top + (parseFloat(getComputedStyle(listek).getPropertyValue('--lt')) || 0)) / (H * 0.88));
      hero.style.setProperty('--p', p.toFixed(4));
      if (!staticky) {
        listek.style.setProperty('--lr', (-3.2 * (1 - p)).toFixed(3) + 'deg');
        listek.style.setProperty('--lt', ((innerWidth < 761 ? 16 : 60) * (1 - p)).toFixed(1) + 'px');
      }
      lista.classList.toggle('pod', r.top < 80);
    }
    function pozadej() { if (!bezi) { bezi = true; requestAnimationFrame(kresli); } }
    addEventListener('scroll', pozadej, { passive: true }); addEventListener('resize', pozadej);
    kresli();
    window.V04 = { stav: function () { return getComputedStyle(hero).getPropertyValue('--p'); } };
  })();
</script>
<p class="pz-credit">Website draft by: <a href="{{ owner_site }}" rel="noopener">{{ owner_name }}</a> · Photos: Unsplash</p>
{% if show_banner %}<div class="pz-pv" id="pz-pv" role="note"><span>Non-binding draft of a new website for <strong>{{ name }}</strong> · prepared by {{ owner_name }}</span>
<a class="pz-cta" href="{{ want_url }}">I want this website</a>{% if wa_url %}<a class="pz-cta" href="{{ wa_url }}" rel="noopener" target="_blank">WhatsApp</a>{% endif %}
<button data-pz-skryt="" type="button">Hide</button></div>{% endif %}
<script id="pz-js">(function(){
var pv=document.getElementById('pz-pv');if(pv){var x=pv.querySelector('[data-pz-skryt]');x&&x.addEventListener('click',function(){pv.classList.add('pz-skryt');});}
var HOOK="{{ form_webhook_url }}",LEAD="{{ lead_id }}";
function lab(f,el){var l=el.id&&f.querySelector('label[for="'+el.id+'"]');if(!l)l=el.closest('label');var s=(l?l.textContent:'')||el.name||'';return s.replace(/\s+/g,' ').replace(/\*/g,'').trim();}
document.addEventListener('submit',function(e){var f=e.target;if(!f||f.tagName!=='FORM'||f.hasAttribute('data-pz-ignore')||!HOOK)return;
  var d={lead_id:LEAD,source:'preview',name:'',email:'',phone:'',message:''},rest=[],seen={};
  Array.prototype.forEach.call(f.elements,function(el){ if(!el.name||el.type==='submit'||el.type==='button')return; if((el.type==='checkbox'||el.type==='radio')&&!el.checked)return;
   var v=(el.value||'').trim(); if(!v)return; var n=el.name.toLowerCase();
   if(/^(jmeno|name|jmeno_prijmeni)$/.test(n))d.name=v; else if(/^(email|e-mail)$/.test(n))d.email=v; else if(/^(telefon|phone|tel)$/.test(n))d.phone=v;
   else {var k=lab(f,el)||el.name; if(seen[k]){seen[k].push(v);}else{seen[k]=[v];rest.push(k);}} });
  d.message=rest.map(function(k){return k+': '+seen[k].join(', ');}).join('\n');
  setTimeout(function(){ if(f.querySelector('[aria-invalid="true"],.chyba,.is-invalid'))return; if(!f.hasAttribute('novalidate')&&!f.checkValidity())return; if(!d.name&&!d.email&&!d.phone)return;
   try{fetch(HOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});}catch(err){}
  },0);
},true);
})();</script></body>
