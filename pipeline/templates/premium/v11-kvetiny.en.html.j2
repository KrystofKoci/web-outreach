<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<meta content="{{ meta_description }}" name="description"/>
<script>
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  h.dataset.tema=(q.get('tema')==='tmava'||location.hash==='#tmava')?'tmava':'svetla';
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0'){h.classList.add('pohyb');h.classList.add('ps');setTimeout(function(){if(!h.classList.contains('ps-bezi'))h.classList.remove('ps');},4000);}})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Unbounded:wght@800&amp;family=Inter+Tight:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V11 Nadpis + mřížka nebo pás karet – wordmark nahoře + fotopás (kolo 8: bez objektu přes hranu): BUILT FLAVOUR (uxui_DZeW-cOIp79_1),
     DESIGNTHINKING (marcelo_DeQEo7HBCM0_5); písmo a paleta BLOOM (uxui_DeOyWEjIGVp_4) */
  :root {
    --pozadi:#EFE9E0;        /* teplá slonovina */
    --text:#1B1714;
    --tlumeny:#625A52;
    --linka:rgba(27,23,20,.14);
    --akcent:#B4472A;        /* korál ztmavený pro AA */
    --na-akcentu:#FFFFFF;
    --stopa:#CDBFAF;
    --pilulka:rgba(27,23,20,.05);
    --pilulka-akt:#FFFFFF;
    --foto-filtr: none;
    --noc: transparent;          /* tónování fotek do noci (jen tmavá) */
  }
  html[data-tema="tmava"] {
    --pozadi:#141110;
    --text:#EDE6DC;
    --tlumeny:#A0968C;
    --linka:rgba(237,230,220,.14);
    --akcent:#E58A64;
    --na-akcentu:#1B1714;
    --stopa:#3A302A;
    --pilulka:rgba(237,230,220,.06);
    --pilulka-akt:rgba(237,230,220,.14);
    /* noc: fotky tmavší, chladnější a méně syté */
    --foto-filtr: brightness(.7) saturate(.72) contrast(1.06);
    --noc: linear-gradient(180deg, rgba(26,18,34,.18) 0%, rgba(20,14,28,.58) 100%);
  }
  body { background: var(--pozadi); color: var(--text); font-family: "Inter Tight", system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
  .verzalky { font-weight: 500; font-size: 11px; letter-spacing: .18em; text-transform: uppercase; line-height: 1.7; }
  .doplnit { color: var(--tlumeny); }

  .hero { position: relative; min-height: max(100svh, 640px); overflow: hidden; isolation: isolate; display: flex; flex-direction: column; }

  /* wordmark přes celou šířku nahoře */
  .wordmark { position: relative; z-index: 2; margin: 1.9vw 0 0; padding: 0 1.6vw; font-family: "Unbounded", sans-serif; font-weight: 800; font-size: 20vw; line-height: .8;
    letter-spacing: -.035em; text-align: center; white-space: nowrap; color: var(--text); }

  /* řada pod wordmarkem: lišta (pilulková skupina) + popis + CTA */
  .rada { position: relative; z-index: 6; display: flex; align-items: center; gap: 16px; padding: 1.5vw 2.6vw 1.6vw; }
  .lista { position: relative; display: flex; align-items: center; gap: 10px; margin-right: auto; }   /* kolo 8: bez pivoňky odsune popis a CTA doprava */
  .lista nav ul { display: flex; gap: 2px; padding: 4px; border-radius: 999px; background: var(--pilulka); border: 1px solid var(--linka); }
  .lista nav a { display: block; padding: 9px 18px; border-radius: 999px; font-size: 14px; }
  .lista nav a[aria-current="page"] { background: var(--pilulka-akt); }
  .hamburger { display: none; width: 40px; height: 40px; place-items: center; border-radius: 50%; border: 1px solid var(--linka); }
  .hamburger i { display: grid; gap: 5px; width: 18px; }
  .hamburger span { display: block; height: 1.5px; background: currentColor; }
  .hamburger[aria-expanded="true"] i { gap: 0; }
  .hamburger[aria-expanded="true"] span:first-child { transform: translateY(.75px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:last-child { transform: translateY(-.75px) rotate(-45deg); }
  .menu-panel { position: absolute; top: calc(100% + 10px); left: 0; right: 0; z-index: 30; padding: 8px 22px 22px; border-radius: 20px;
    background: var(--pozadi); border: 1px solid var(--linka); box-shadow: 0 18px 40px -24px rgba(0,0,0,.4); }
  .menu-panel[hidden] { display: none; }
  .menu-panel .pilulka-plna:focus-visible { outline-color: var(--text); outline-offset: 4px; }   /* obrys v barvě textu, ne bílý na světlém panelu */
  .menu-panel li a { display: block; padding: 14px 0; font-size: 17px; border-bottom: 1px solid var(--linka); }
  .menu-panel .pilulka-plna { margin-top: 18px; height: 48px; padding: 0 22px; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px;
    background: var(--akcent); color: var(--na-akcentu); font-weight: 500; }
  .popis { flex: none; max-width: 15.5em; font-size: 15px; line-height: 1.45; color: var(--tlumeny); text-align: right; text-wrap: balance; }
  .cta { flex: none; display: inline-flex; align-items: center; gap: 14px; height: 52px; padding: 0 6px 0 24px; border-radius: 999px;
    background: var(--akcent); color: var(--na-akcentu); font-weight: 500; font-size: 15px; }
  .cta .kolecko { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: var(--text); color: var(--pozadi); }
  .cta svg { width: 15px; height: 15px; }

  /* fotopás */
  .pas { position: relative; z-index: 1; flex: 1; min-height: 300px; display: grid; grid-template-columns: 1fr 1.32fr 1fr 1.32fr 1fr; gap: 6px; margin: 0; }
  .pas figure { position: relative; overflow: hidden; margin: 0; }
  .pas figure::after { content: ""; position: absolute; inset: 0; background: var(--noc); pointer-events: none; }
  .pas img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: var(--foto-filtr); }
  /* Pixel Scan (HorizonX, přepsáno do čistého WebGL): dokud fotka neprošla průchodem, kryje ji plocha stránky.
     .ps nastaví hlavička jen s pohybem; když WebGL chybí, skript třídu sundá a fotky jsou rovnou celé. */
  html.ps .pas figure { background: var(--pozadi); }
  html.ps .pas figure:not(.ps-hotovo):not(.ps-jede) img, html.ps .pas figure:not(.ps-hotovo):not(.ps-jede)::after { visibility: hidden; }
  .pas canvas.ps-platno { position: absolute; inset: 0; width: 100%; height: 100%; z-index: 1; pointer-events: none; }
  .pas figure:nth-child(2) img { object-position: 45% 40%; }
  .pas figure:nth-child(3) img { object-position: 50% 30%; }
  .pas figure:nth-child(4) img { object-position: 40% 40%; }

  .pata { position: relative; z-index: 6; display: flex; justify-content: space-between; align-items: center; padding: 14px 2.6vw 16px; color: var(--text); }
  .pata p { margin: 0; }

  /* ---------- nabídka s vějířem fotek (HorizonX „gallery-fan“ ve vanilla JS, převzato z V08 kvůli jednotnosti) ----------
     Každá sekce: řádek nadpis | text | cena, pod ním 5 karet 2:3 (rádius 14 px, mezera 16 px).
     S pohybem: sekce je scroll range, scéna je sticky; karty přijedou zprava, přes vějíř (abs(i−2)·3°, origin 50 % 0 %)
     se složí do řady, popisky vyjedou zdola. Bez pohybu (reduced motion, ?pohyb=0) rovnou složený stav. */
  .fan { position: relative; --kw: min(calc((100vw - 5.2vw - 64px) / 5), calc((100svh - 330px) * .6667)); }
  .fan + .fan .fan-hlava { border-top-color: transparent; }
  .fan-scena { padding: 96px 2.6vw 72px; }
  .fan-hlava { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto; gap: 4vw; align-items: baseline;
    padding-top: 28px; border-top: 1px solid var(--linka); }
  .fan-hlava h2 { font-weight: 500; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.08; letter-spacing: -.035em; margin: 0; }
  .fan-hlava p { color: var(--tlumeny); max-width: 44ch; }
  .fan-hlava .cena { white-space: nowrap; font-size: 15px; }
  .fan-rada { display: flex; gap: 16px; margin-top: 48px; justify-content: center; }
  .karta-fan { flex: none; width: var(--kw); margin: 0; }
  .karta-fan .foto { display: block; width: 100%; aspect-ratio: 2 / 3; border-radius: 14px; overflow: hidden; transform-origin: 50% 0%;
    background: color-mix(in srgb, var(--text) 8%, var(--pozadi)); }
  .karta-fan img { width: 100%; height: 100%; object-fit: cover; display: block; }
  html[data-tema="tmava"] .karta-fan img { filter: brightness(.86) saturate(.9); }
  .karta-fan figcaption { overflow: hidden; margin-top: 14px; min-height: 3.2em; }
  .karta-fan figcaption span { display: block; }
  .karta-fan .co { font-weight: 500; font-size: 17px; line-height: 1.25; letter-spacing: -.015em; }
  .karta-fan .veta { font-size: 14px; line-height: 1.45; color: var(--tlumeny); margin-top: 3px; max-width: 30ch; }

  @media (min-height: 560px) {
    html.pohyb .fan { height: calc(100svh + 130vh); }
    html.pohyb .fan-scena { position: sticky; top: 0; height: 100svh; overflow: clip; display: flex; flex-direction: column; justify-content: center; }
    html.pohyb .karta-fan .foto, html.pohyb .karta-fan figcaption span { will-change: transform, opacity; }
  }

  /* ---------- hodnocení Google (jen když je recenzí víc než 45, viz RECENZE ve skriptu) ---------- */
  .hodnoceni { padding: 110px 2.6vw 120px; border-top: 1px solid var(--linka); }
  .hodnoceni[hidden] { display: none; }
  .hod-souhrn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 4vw; align-items: end; }
  .hod-souhrn h2 { font-weight: 500; font-size: clamp(2rem, 3vw, 3rem); line-height: 1.08; letter-spacing: -.035em; }
  .hod-cislo { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .hod-cislo .znamka { font-family: "Unbounded", sans-serif; font-weight: 800; font-size: clamp(2.4rem, 3.6vw, 3.6rem); line-height: 1; letter-spacing: -.035em; }
  .hod-cislo .znamka.doplnit { font-family: inherit; font-weight: 500; font-size: clamp(1.3rem, 1.8vw, 1.8rem); letter-spacing: -.02em; }
  .hod-cislo .pocet, .hod-cislo .podil { color: var(--tlumeny); font-size: 15px; }
  .hvezdy { display: inline-flex; gap: 3px; color: var(--akcent); }
  .hvezdy svg { width: 15px; height: 15px; }
  .hod-seznam { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 56px; border-top: 1px solid var(--linka); }
  .hod-seznam li { padding: 30px 32px 6px 0; display: grid; gap: 16px; align-content: start; }
  .hod-seznam li + li { padding-left: 32px; border-left: 1px solid var(--linka); }
  .hod-seznam blockquote { margin: 0; font-size: 18px; line-height: 1.45; letter-spacing: -.01em; color: var(--tlumeny); }
  .hod-seznam .kdo { font-size: 14px; color: var(--tlumeny); }
  .hod-zdroj { margin-top: 36px; font-size: 14px; color: var(--tlumeny); }
  .hod-zdroj a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  /* ---------- patička ---------- */
  .paticka { padding: 64px 2.6vw 40px; border-top: 1px solid var(--linka); display: grid; grid-template-columns: 1fr repeat(3, auto); gap: 24px 64px; align-items: start; }
  .paticka .logo { display: inline-block; margin-bottom: 10px; font-family: "Unbounded", sans-serif; font-weight: 800; font-size: 28px; letter-spacing: -.035em; line-height: 1; }
  .paticka p { color: var(--tlumeny); font-size: 14px; }
  .paticka dt { color: var(--tlumeny); }
  .paticka dd { margin: 4px 0 0; font-size: 15px; }
  .paticka .spodek { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 16px; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--linka); font-size: 13px; color: var(--tlumeny); }

  /* kolo 8: bez pivoňky je v řadě místo. Odstavec se nevejde jen mezi 761 a 980 px (pilulky + odstavec + CTA). */
  @media (max-width: 980px) and (min-width: 761px) { .popis { display: none; } }
  @media (max-width: 760px) {
    .wordmark { margin-top: 18px; padding: 0 8px; font-size: 19.6vw; order: 1; }
    /* řada se rozpustí: lišta a popis nahoře, CTA dole u palce pod pásem */
    .rada { display: contents; }
    .lista { order: 2; z-index: 8; margin: 14px 20px 0; justify-content: space-between; }
    .lista nav { display: none; }
    .lista .znacka { font-size: 14px; margin-right: auto; }
    .hamburger { display: inline-grid; }
    .popis { order: 3; position: relative; z-index: 6; margin: 10px 20px 16px; text-align: left; max-width: none; font-size: 15px; }
    .pas { order: 4; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 6px; padding: 0 20px; scrollbar-width: none; min-height: 0; flex: 1 0 280px; }
    .pas::-webkit-scrollbar { display: none; }
    .pas figure { flex: 0 0 64vw; scroll-snap-align: start; scroll-margin-left: 20px; }
    .cta { order: 5; position: relative; z-index: 6; align-self: flex-start; margin: 16px 20px 0; }
    .pata { order: 6; padding: 12px 20px 16px; }
    .fan { --kw: min(58vw, calc((100svh - 400px) * .6667)); }
    .fan-scena { padding: 76px 20px 48px; }
    .fan-hlava { grid-template-columns: 1fr auto; gap: 10px 16px; padding-top: 22px; }
    .fan-hlava p { grid-column: 1 / -1; grid-row: 2; font-size: 15px; }
    .fan-hlava .cena { grid-column: 2; grid-row: 1; }
    .fan-rada { justify-content: flex-start; margin-top: 30px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -20px; padding: 0 20px 6px; scrollbar-width: none; }
    .fan-rada::-webkit-scrollbar { display: none; }
    .karta-fan { scroll-snap-align: start; }
    html.pohyb .fan-rada { overflow: visible; scroll-snap-type: none; }
    .hodnoceni { padding: 80px 20px 90px; }
    .hod-souhrn { grid-template-columns: 1fr; gap: 20px; }
    .hod-seznam { grid-template-columns: 1fr; margin-top: 36px; }
    .hod-seznam li, .hod-seznam li + li { padding: 26px 0; border-left: 0; }
    .hod-seznam li + li { border-top: 1px solid var(--linka); }
    .paticka { grid-template-columns: 1fr 1fr; padding: 56px 20px 32px; gap: 24px; }
    .paticka > div:first-child { grid-column: 1 / -1; }
    .paticka .spodek { flex-direction: column; gap: 6px; }
  }
  @media (min-width: 761px) { .lista .znacka { display: none; } }
</style>
<style id="pz-css">
.pz-hod{padding:clamp(56px,9vw,104px) 24px;text-align:center;color:inherit;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
.pz-hod .pz-in{max-width:560px;margin:0 auto}
.pz-hod .pz-cislo{font-size:clamp(44px,7vw,72px);line-height:1;margin:0;font-weight:500;letter-spacing:-.02em}
.pz-hod .pz-cislo span{font-size:.32em;opacity:.7;letter-spacing:0;margin-left:.3em}
.pz-hod .pz-hv{position:relative;display:inline-block;font-size:22px;letter-spacing:4px;margin:14px 0 8px;color:color-mix(in srgb,currentColor 22%,transparent)}
.pz-hod .pz-hv b{position:absolute;inset:0 auto 0 0;overflow:hidden;white-space:nowrap;color:var(--akcent,var(--accent,#E3A008));font-weight:400}
.pz-hod .pz-pod{margin:0 0 14px;opacity:.78}
.pz-hod a{color:inherit}
.pz-pata{padding:28px 24px 34px;text-align:center;font-size:14px;opacity:.85;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
.pz-pata p{margin:4px 0}.pz-pata a{color:inherit}
.pz-credit{font-size:12px;opacity:.7;text-align:center;padding:0 24px 22px}
.pz-credit a{color:inherit}
.pz-pv{position:fixed;left:12px;right:12px;bottom:12px;z-index:2147483000;background:#111827;color:#fff;font:14px/1.4 system-ui,-apple-system,"Segoe UI",sans-serif;
 padding:10px 14px;border-radius:14px;display:flex;flex-wrap:wrap;gap:6px 16px;align-items:center;justify-content:center;box-shadow:0 10px 30px rgba(0,0,0,.3)}
.pz-pv a{color:#fff}.pz-pv .pz-cta{background:#fff;color:#111827;text-decoration:none;font-weight:700;padding:.4em .85em;border-radius:999px}
.pz-pv button{background:none;border:0;color:#fff;opacity:.8;cursor:pointer;font:inherit;text-decoration:underline}
.pz-pv.pz-skryt{display:none}
@media print{.pz-pv{display:none}}
</style><style id="pz-ext-css">
