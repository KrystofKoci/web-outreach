</style></head>
<body>
<main>
<section class="hero">
<h1 class="wordmark" data-slozit="">{{ brand_up }}<span class="sr-only"> – florist</span></h1>
<div class="rada">
<header class="lista">
<span class="znacka verzalky">Florist</span>
<nav aria-label="Main">
<ul>
<li><a aria-current="page" href="#">Bouquets</a></li>
<li><a href="#sluzby">Weddings</a></li>
<li><a href="#sluzby">Studio</a></li>
<li><a href="#kontakt">Contact</a></li>
</ul>
</nav>
<button aria-label="Switch to dark mode" aria-pressed="false" class="tema-prepinac" data-prepnout-tema="" type="button">
<svg class="ikona-slunce" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
<svg class="ikona-mesic" fill="none" stroke="currentColor" stroke-width="1.5" viewbox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path></svg>
</button>
<button aria-controls="menu" aria-expanded="false" aria-label="Menu" class="hamburger" data-menu="" type="button"><i><span></span><span></span></i></button>
