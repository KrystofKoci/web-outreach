<script>
  /* menu: hamburger otevře panel s odkazy a CTA; zavře se Esc, klikem na odkaz nebo mimo panel */
  (function () {
    var b = document.querySelector('[data-menu]'), p = document.getElementById(b.getAttribute('aria-controls'));
    function nastav(o) { b.setAttribute('aria-expanded', o ? 'true' : 'false'); p.hidden = !o; }
    b.addEventListener('click', function () { nastav(p.hidden); });
    p.addEventListener('click', function (e) { if (e.target.closest('a')) nastav(false); });
    document.addEventListener('keydown', function (e) { if (e.key === 'Escape' && !p.hidden) { nastav(false); b.focus(); } });
    document.addEventListener('click', function (e) { if (!p.hidden && !p.contains(e.target) && !b.contains(e.target)) nastav(false); });
    matchMedia('(min-width: 861px)').addEventListener('change', function (m) { if (m.matches) nastav(false); });
  })();
</script>
<script defer="" src="{{ A }}zaklad.js"></script>
<script>
  /* Pixel Scan na fotopásu (HorizonX „pixel-scan“, mode 0 = across, bandWidth 0.2, layers 3, speed 0.75), přepsáno do čistého WebGL bez knihoven.
     - Každá fotka se odhalí jedním průchodem pixelového pásu zleva doprava, když vstoupí do viewportu (IntersectionObserver);
       fotky jdou postupně zleva doprava (start fotky = nejdřív start předchozí + ROZESTUP).
     - Jeden sdílený WebGL kontext mimo DOM; do každé fotky se kreslí přes malý 2D canvas (drawImage). Kreslí se jen během průchodu,
       po poslední fotce se kontext uvolní a canvasy zmizí.
     - Barva buněk = barva fotky v buňce, lehce prosvětlená k tónu stránky (žádná duha). Neodhalená část = plocha stránky (--pozadi).
     - Bez pohybu (reduced motion, ?pohyb=0) třída .ps vůbec nevznikne; bez WebGL se sundá → fotky rovnou celé. */
  (function () {
    var html = document.documentElement, pas = document.querySelector('[data-pixel-scan]');
    if (!pas || !html.classList.contains('ps')) return;
    var gl, glc = document.createElement('canvas');
    try { gl = glc.getContext('webgl', { premultipliedAlpha: true, alpha: true, antialias: false, preserveDrawingBuffer: true }); } catch (e) {}
    if (!gl || !window.IntersectionObserver) { html.classList.remove('ps'); return; }
    html.classList.add('ps-bezi');

    var VS = 'attribute vec2 a;void main(){gl_Position=vec4(a,0.,1.);}';
    var FS = [
      'precision highp float;',
      'uniform sampler2D src;uniform vec2 res;uniform float t0;uniform vec3 bg;uniform vec2 uvS;uniform vec2 uvO;uniform float dim;uniform float cellPx;',
      '#define W .2',
      'vec2 texUV(vec2 uv){return vec2(uv.x,1.-uv.y)*uvS+uvO;}',              /* uv postavy (y nahoru) → uv fotky (cover, y dolů) */
      'float hash(vec2 p){return fract(sin(dot(p,vec2(4859.,3985.)))*3984.);}',
      'float sdBox(vec2 p,float r){vec2 q=abs(p)-r;return min(length(q),max(q.y,q.x));}',
      'float toRangeT(vec2 p,float scale){return p.x/(scale*2.)+.5;}',          /* mode 0: across, zleva doprava */
      'vec4 cell(vec2 p,vec2 pi,float scale,float t,float edge){vec2 pc=pi+.5;vec2 uvc=pc/scale;uvc.y/=res.y/res.x;uvc=uvc*.5+.5;',
      '  if(uvc.x<0.||uvc.x>1.||uvc.y<0.||uvc.y>1.)return vec4(0);',
      '  vec3 c=texture2D(src,texUV(uvc)).rgb*dim;c=mix(c,bg,.14);',          /* barva z fotky, jemně k tónu stránky; ne duha */
      '  float x=toRangeT(pi,scale);float n=hash(pi);float anim=smoothstep(W*2.,0.,abs(x+n*W-t));',
      '  float e=edge*pow(anim,10.)*clamp(.3/abs(sdBox(p-pc,.5)),0.,3.);return vec4(min(c*(1.+.12*e),vec3(1.))*anim,anim);}',
      'vec4 cellsColor(vec2 p,float scale,float t){vec2 pi=floor(p);vec2 d=vec2(0,1);vec4 cc=vec4(0);',
      '  cc+=cell(p,pi,scale,t,.2)*4.;cc+=cell(p,pi+d.xy,scale,t,.9);cc+=cell(p,pi-d.xy,scale,t,.9);cc+=cell(p,pi+d.yx,scale,t,.9);cc+=cell(p,pi-d.yx,scale,t,.9);return cc/8.;}',
      'void main(){vec2 uv=gl_FragCoord.xy/res;vec2 p=uv*2.-1.;p.y*=res.y/res.x;',
      '  float t=t0*(1.+W*4.)-W*2.;float rev=0.;vec4 g=vec4(0);',
      '  for(int i=0;i<3;i++){float fi=float(i);float scale=res.x*.5/(cellPx*(1.+.42*fi));',  /* 3 mřížky, jemné buňky */
      '    vec2 pi=floor(p*scale);float n=hash(pi);rev+=smoothstep(t,t-W,toRangeT(pi,scale)+n*W);g+=cellsColor(p*scale,scale,t)*1.5;}',
      '  rev/=3.;g/=3.;float cov=1.-rev;',
      '  float ga=clamp(g.a,0.,1.);vec3 col=g.rgb/max(g.a,1e-3);',            /* krytí a průměrná barva buněk */
      '  float a=ga+cov*(1.-ga);vec3 rgb=col*ga+bg*cov*(1.-ga);',              /* premultiplied: buňky přes plochu / přes fotku */
      '  gl_FragColor=vec4(rgb,a)*smoothstep(-.001,0.,t0)+vec4(bg,1.)*(1.-smoothstep(-.001,0.,t0));}'
    ].join('\n');
    function sh(typ, kod) { var s = gl.createShader(typ); gl.shaderSource(s, kod); gl.compileShader(s); if (!gl.getShaderParameter(s, gl.COMPILE_STATUS)) throw new Error(gl.getShaderInfoLog(s)); return s; }
    var pr;
    try {
      pr = gl.createProgram(); gl.attachShader(pr, sh(gl.VERTEX_SHADER, VS)); gl.attachShader(pr, sh(gl.FRAGMENT_SHADER, FS)); gl.linkProgram(pr);
      if (!gl.getProgramParameter(pr, gl.LINK_STATUS)) throw new Error(gl.getProgramInfoLog(pr));
    } catch (e) { html.classList.remove('ps', 'ps-bezi'); return; }
    gl.useProgram(pr);
    var buf = gl.createBuffer(); gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]), gl.STATIC_DRAW);
    var la = gl.getAttribLocation(pr, 'a'); gl.enableVertexAttribArray(la); gl.vertexAttribPointer(la, 2, gl.FLOAT, false, 0, 0);
    var U = {}; ['src', 'res', 't0', 'bg', 'uvS', 'uvO', 'dim', 'cellPx'].forEach(function (n) { U[n] = gl.getUniformLocation(pr, n); });
    gl.uniform1i(U.src, 0);

    var POMALU = +new URLSearchParams(location.search).get('ps-pomalu') || 1;   /* jen pro kontrolní snímky: ?ps-pomalu=10 zpomalí průchod 10× */
    var TRVANI = POMALU / 0.75, ROZESTUP = 0.32 * POMALU, UVOD = 0.55 * POMALU;   /* s; úvod = počkat, až se složí wordmark */
    var DPR = Math.min(window.devicePixelRatio || 1, 1.5);
    var figs = Array.prototype.slice.call(pas.querySelectorAll('figure')).map(function (f, i) {
      var cv = document.createElement('canvas'); cv.className = 'ps-platno'; cv.setAttribute('aria-hidden', 'true'); f.appendChild(cv);
      return { f: f, img: f.querySelector('img'), cv: cv, ctx: cv.getContext('2d'), i: i, start: -1, hotovo: false, tex: null };
    });
    var t0 = performance.now() / 1000, posledniStart = t0 + UVOD - ROZESTUP, bezi = false;

    function barvaPozadi() {
      var m = getComputedStyle(document.body).backgroundColor.match(/[\d.]+/g) || [239, 233, 224];
      return [m[0] / 255, m[1] / 255, m[2] / 255];
    }
    function velikost(o) {
      var r = o.f.getBoundingClientRect(), w = Math.max(1, Math.round(r.width * DPR)), h = Math.max(1, Math.round(r.height * DPR));
      if (o.cv.width !== w || o.cv.height !== h) { o.cv.width = w; o.cv.height = h; }
      return [w, h, r.width, r.height];
    }
    /* první snímek = plocha stránky, aby fotka nebyla vidět před průchodem */
    function zakryj(o) { var v = velikost(o), b = barvaPozadi(); o.ctx.fillStyle = 'rgb(' + b.map(function (x) { return Math.round(x * 255); }) + ')'; o.ctx.fillRect(0, 0, v[0], v[1]); }
    figs.forEach(zakryj);

    function priprav(o) {
      o.tex = gl.createTexture(); gl.bindTexture(gl.TEXTURE_2D, o.tex);
