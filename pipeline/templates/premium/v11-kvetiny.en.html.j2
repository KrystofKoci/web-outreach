<script>
  /* Hodnocení Google (převzato z V08). Blok se ukáže jen při víc než 45 recenzích (pocet 45 a méně = blok zůstane skrytý).
     Od 50 recenzí se navíc ukáže podíl spokojených (ROZHODNUTI_MAJITELE). U klienta se mění jen tahle data.
     ukazka: true = demo: místo čísel se ukáže [doplnit], texty recenzí jsou zřetelné šablonové výplně (žádné vymyšlené recenze). */
  var RECENZE = {
    pocet: {{ rating_count_js }},            /* demo hodnota, aby byl blok vidět; pod 46 se blok skryje */
    znamka: {{ rating_js }},         /* např. 4.9 – doplnit z Google */
    podilSpokojenych: null,
    odkaz: '{{ maps_url_js }}',
    ukazka: false,
    vybrane: {{ reviews_js|safe }}
  };
  (function () {
    var blok = document.querySelector('[data-hodnoceni]');
    if (!blok || !(RECENZE.znamka > 0)) return;
    var hv = '<svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.2l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.5l-4.2 2.3 1-4.6L1.3 6l4.7-.5z"/></svg>';
    function hvezdy(n) { var h = ''; for (var i = 0; i < 5; i++) h += i < n ? hv : hv.replace('currentColor', 'none" stroke="currentColor'); return h; }
    function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    var zn = blok.querySelector('[data-hod-znamka]');
    if (RECENZE.ukazka || RECENZE.znamka == null) { zn.textContent = '–'; zn.classList.add('doplnit'); }
    else zn.textContent = RECENZE.znamka.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    blok.querySelector('[data-hod-hvezdy]').innerHTML = hvezdy(Math.round(RECENZE.znamka || 5));
    blok.querySelector('[data-hod-pocet]').innerHTML = RECENZE.ukazka ? 'Google reviews' : (RECENZE.pocet >= 50 ? esc(RECENZE.pocet) + ' Google reviews' : 'Google rating');
    if (RECENZE.podilSpokojenych != null) {
      var pd = blok.querySelector('[data-hod-podil]'); pd.hidden = false;
      pd.innerHTML = RECENZE.ukazka || RECENZE.podilSpokojenych == null ? '' : esc(RECENZE.podilSpokojenych) + '% satisfied';
    }
    blok.querySelector('[data-hod-seznam]').innerHTML = RECENZE.vybrane.slice(0, 5).map(function (r) {
      return '<li><span class="hvezdy" role="img" aria-label="' + r.hvezdy + ' out of 5 stars">' + hvezdy(r.hvezdy) + '</span>' +
        '<blockquote>' + esc(r.text) + '</blockquote><span class="kdo">' + esc(r.jmeno) + ' · Google</span></li>';
    }).join('');
    blok.querySelector('[data-hod-odkaz]').href = RECENZE.odkaz;
    blok.hidden = false;
  })();
</script>
<script>
  /* Vějíř fotek (HorizonX „gallery-fan“ ve vanilla JS, převzato z V08 beze změny logiky).
     Sekce .fan je scroll range, .fan-scena je sticky. Postup p (0–1) řídí pro každou kartu vlastní úsek (stagger):
       1) „rozházeno“ zprava: karta přijede zprava s natočením a výškovým posunem,
       2) vějíř: natočení (2 − i)·3° kolem horního středu (transform-origin 50 % 0 %),
       3) složená řada: natočení 0, posun 0; popisek vyjede zdola (translateY 100 % → 0, opacity 0 → 1).
     Desktop: karty se skládají zprava doleva (nejdřív pravá krajní). Mobil: celá řada jede zprava doleva přes obrazovku
     a karty se skládají v pořadí, jak vjíždějí. Jen transform/opacity, requestAnimationFrame, kreslí se jen při změně.
     Bez pohybu (reduced motion, ?pohyb=0) nebo na oknech nižších než 560 px: rovnou složený stav, žádné inline styly. */
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('pohyb')) return;
    var vyska = matchMedia('(min-height: 560px)');
    var ROZ = [[-9, 46], [6, -34], [-4, 58], [11, -22], [-7, 36]];   /* rozházeno: [natočení °, posun y px] */
    var STAG = 0.1, KONEC = 0.86;                                     /* úsek karty = (p − k·STAG) / (KONEC − 4·STAG) */
    function o(t) { return 1 - Math.pow(1 - t, 3); }
    function vh(t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
    function cl(t) { return t < 0 ? 0 : t > 1 ? 1 : t; }
    var fany = Array.prototype.map.call(document.querySelectorAll('.fan'), function (el) {
      var rada = el.querySelector('[data-fan]');
      return { el: el, scena: el.querySelector('.fan-scena'), rada: rada,
        karty: Array.prototype.map.call(rada.children, function (f) { return { foto: f.querySelector('.foto'), cap: f.querySelectorAll('figcaption span'), x: 0 }; }),
        start: 0, delka: 1, posun: 0, mobil: false, posl: -1 };
    });
    function mer() {
      var vw = window.innerWidth;
      fany.forEach(function (f) {
        f.rada.style.transform = ''; f.karty.forEach(function (k) { k.foto.style.transform = ''; });
        /* timeline začne už při vjezdu sekce (horní hrana v 55 % okna), ať řada není při přišpendlení prázdná */
        var nabeh = window.innerHeight * 0.45;
        f.start = f.el.getBoundingClientRect().top + window.scrollY - nabeh;
        f.delka = Math.max(1, f.el.offsetHeight - f.scena.offsetHeight + nabeh);
        f.mobil = vw <= 760;
        var r = f.rada.getBoundingClientRect(), pad = parseFloat(getComputedStyle(f.scena).paddingLeft) || 0;
        var sirka = f.rada.scrollWidth;
        f.posun = f.mobil ? Math.max(0, sirka - (vw - 2 * pad)) : 0;   /* o kolik musí řada na mobilu odjet doleva */
        f.karty.forEach(function (k) { k.x = k.foto.getBoundingClientRect().left; k.w = k.foto.offsetWidth; });
        f.posl = -1;
      });
    }
    var ceka = false;
    function pozadej() { if (!ceka) { ceka = true; requestAnimationFrame(kresli); } }
    function kresli() {
      ceka = false;
      if (!vyska.matches) return;
      var sy = window.scrollY, vw = window.innerWidth;
      fany.forEach(function (f) {
        var p = cl((sy - f.start) / f.delka);
        if (sy + window.innerHeight < f.start - 50 && f.posl === 0) return;
        if (Math.abs(p - f.posl) < 0.0004) return;
        f.posl = p;
        /* mobil: řada vjede zprava (začíná o 55 % šířky okna vpravo) a dojede tak, aby byla vidět pravá krajní karta */
        var rx = 0;
        if (f.mobil) { rx = (1 - vh(cl(p / 0.92))) * vw * 0.55 - f.posun * vh(cl((p - 0.08) / 0.84)); f.rada.style.transform = 'translate3d(' + rx.toFixed(1) + 'px,0,0)'; }
        var dur = KONEC - 4 * STAG;
        f.karty.forEach(function (k, i) {
          var poradi = f.mobil ? i : 4 - i;                       /* desktop zprava doleva */
          var t = cl((p - poradi * STAG) / dur);
          var a = o(cl(t / 0.62)), b = vh(cl((t - 0.5) / 0.5)), c = o(cl((t - 0.68) / 0.32));
          /* odkud karta přijíždí: desktop těsně za pravým okrajem okna, mobil kousek zprava (řadu veze posun celé řady) */
          var x0 = f.mobil ? 70 + i * 24 : (vw - k.x) + 40 + (4 - i) * 30;
          var fanR = (2 - i) * 3, fanY = Math.abs(i - 2) * 14;
          var x = x0 * (1 - a);
          var r = ROZ[i][0] + (fanR - ROZ[i][0]) * a; r = r * (1 - b);
          var y = ROZ[i][1] + (fanY - ROZ[i][1]) * a; y = y * (1 - b);
          var sc = 0.92 + 0.08 * a;
          k.foto.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0) rotate(' + r.toFixed(2) + 'deg) scale(' + sc.toFixed(3) + ')';
          k.foto.style.opacity = cl(a * 2.2).toFixed(3);
          for (var j = 0; j < k.cap.length; j++) {
            var cj = o(cl((t - 0.68 - j * 0.06) / 0.3));
            k.cap[j].style.transform = 'translate3d(0,' + ((1 - cj) * 100).toFixed(1) + '%,0)';
            k.cap[j].style.opacity = cj.toFixed(3);
          }
        });
      });
    }
    function znovu() { mer(); pozadej(); }
    mer();
    window.addEventListener('scroll', pozadej, { passive: true });
    window.addEventListener('resize', znovu);
    window.addEventListener('load', znovu);
    vyska.addEventListener('change', function () {
      if (!vyska.matches) fany.forEach(function (f) { f.rada.style.transform = ''; f.karty.forEach(function (k) { k.foto.style.cssText = ''; for (var j = 0; j < k.cap.length; j++) k.cap[j].style.cssText = ''; }); });
      znovu();
    });
    pozadej();
  })();
</script>
