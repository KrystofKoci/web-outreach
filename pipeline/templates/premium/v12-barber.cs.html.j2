<script>
  /* Kolo 4: tunel střihů V12 – nekonečná smyčka v requestAnimationFrame (jen transform a opacity), zastavení a popisek. */
  (function () {
    var html = document.documentElement, hero = document.querySelector('.hero'), tunel = hero.querySelector('.tunel');
    var popisek = hero.querySelector('.popisek-strihu');
    var nazvy = { 1: 'Texturovaný střih s linkou', 2: 'Sčesané dozadu s přechodem', 3: 'Vyčesané nahoru, krátké boky', 4: 'Vyholená hlava a plnovous',
      5: 'Přechod do kůže', 6: 'Přechod a dlouhý plnovous', 7: 'Dlouhé kudrnaté vlasy', 8: 'Krátký střih' };
    var karty = Array.prototype.slice.call(tunel.querySelectorAll('.karta'));
    karty.forEach(function (k) {
      var m = k.querySelector('img').getAttribute('src').match(/strih-(\d+)/); k.dataset.nazev = nazvy[m ? m[1] : 0] || '';
      if (!k.hasAttribute('aria-hidden')) k.tabIndex = 0;   /* fotky s alt textem jdou vybrat klávesnicí */
    });
    var pohyb = html.classList.contains('pohyb'), dotyk = !matchMedia('(hover: hover) and (pointer: fine)').matches;
    var mys = null, fokus = null;

    function umistiPopisek(k) {
      var r = k.getBoundingClientRect(), h = hero.getBoundingClientRect();
      var l = Math.max(r.left, 0), p = Math.min(r.right, window.innerWidth);
      var x = (l + p) / 2 - h.left, y = Math.min(r.bottom + 10, h.bottom - 64) - h.top;
      var sirka = popisek.offsetWidth; x = Math.max(12 + sirka / 2, Math.min(h.width - 12 - sirka / 2, x));
      popisek.style.transform = 'translate3d(' + (x - sirka / 2).toFixed(1) + 'px,' + y.toFixed(1) + 'px,0)';
    }
    function ukaz() {
      var k = fokus || mys;
      if (k) { popisek.textContent = k.dataset.nazev; umistiPopisek(k); popisek.classList.add('videt'); }
      else popisek.classList.remove('videt');
      if (pohyb) pozadej();
    }
    karty.forEach(function (k) {
      k.addEventListener('pointerenter', function (e) { if (e.pointerType === 'touch') return; mys = k; ukaz(); });
      k.addEventListener('pointerleave', function (e) { if (mys === k) { mys = null; ukaz(); } });
      k.addEventListener('pointerdown', function (e) { if (e.pointerType === 'touch') k.dataset.tap = String(Date.now()); });
      k.addEventListener('focus', function () {
        fokus = k; ukaz();
        /* na dotyku nic nevisí pod prstem: po ťuknutí se název ukáže na chvíli a smyčka pak sama pokračuje */
        if (Date.now() - (+k.dataset.tap || 0) < 800) setTimeout(function () { if (fokus === k) k.blur(); }, 2500);
      });
      k.addEventListener('blur', function () { if (fokus === k) { fokus = null; ukaz(); } });
    });
    if (!pohyb) return;   /* reduced motion nebo ?pohyb=0: statický tunel, popisek bez pohybu */

    tunel.classList.add('smycka');
    var N = 12, PREDEK = 2.5;          /* v hloubce 2,5 kroku je karta celá za okrajem obrazu (změřeno na 390–1440 px) */
    var ZAKLAD = dotyk ? 0.16 : 0.28;   /* kroků za sekundu; na dotyku pomaleji */
    var cilS = null;   /* při focusu klávesnicí tunel dojede tak, aby zaměřená karta byla ve střední hloubce (d = 3,5) */
    var s = -1, rychlost = ZAKLAD, scrollV = 0, poslY = window.scrollY, poslT = performance.now(), cas = 0, bezi = false, viditelne = true;
    function pozice() {
      karty.forEach(function (k) {
        var i = +k.style.getPropertyValue('--i');
        var d = ((i - s) % N + N) % N;            /* 0 = vpředu u diváka, N = úplně vzadu */
        var z = PREDEK - d;
        var o = Math.min(1, d / 0.4, (N - d) / 1.6);   /* vpředu se ztlumí před přeskokem, vzadu se roztmí */
        k.style.setProperty('--z', z.toFixed(4));
        k.style.opacity = o.toFixed(3);
      });
    }
    function krok(t) {
      bezi = false;
      var dt = cas ? Math.min(0.05, (t - cas) / 1000) : 0.016; cas = t;
      scrollV *= Math.pow(0.04, dt);                                     /* rychlost scrollu doznívá */
      var stop = !!(mys || fokus);
      var cil = stop ? 0 : ZAKLAD + Math.min(3.2, Math.abs(scrollV) / 380);
      rychlost += (cil - rychlost) * Math.min(1, dt * (stop ? 9 : 2.6));
      if (stop && rychlost < 0.002) rychlost = 0;
      s += rychlost * dt;
      if (fokus && cilS !== null) { s += (cilS - s) * Math.min(1, dt * 3.2); if (Math.abs(cilS - s) < 0.0005) s = cilS; }
      if (s > 1e6) s -= N * 1e5;
      pozice();
      var k = fokus || mys; if (k) umistiPopisek(k);
      if (viditelne && !document.hidden && (rychlost > 0 || !stop || (fokus && cilS !== null && s !== cilS))) pozadej(); else cas = 0;
    }
    function pozadej() { if (!bezi && viditelne && !document.hidden) { bezi = true; requestAnimationFrame(krok); } }
    karty.forEach(function (k) {
      k.addEventListener('focus', function () {
        var i = +k.style.getPropertyValue('--i'); cilS = s + ((((i - s - 3.5) % N) + N) % N); pozadej();
      });
      k.addEventListener('blur', function () { cilS = null; });
    });
    window.addEventListener('scroll', function () {
      var t = performance.now(), y = window.scrollY, dt = Math.max(8, t - poslT);
      scrollV = scrollV * 0.5 + ((y - poslY) / dt * 1000) * 0.5; poslY = y; poslT = t; pozadej();
    }, { passive: true });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (z) {
      viditelne = z[0].isIntersecting; if (viditelne) { cas = 0; pozadej(); }
    }).observe(hero);
    document.addEventListener('visibilitychange', function () { cas = 0; pozadej(); });
    window.V12 = { stav: function () { return { s: s, rychlost: rychlost }; } };
    pozice(); pozadej();
  })();
</script>
