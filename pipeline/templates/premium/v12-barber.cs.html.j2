<style>
  /* V12 Galerie s tvarem – barber Ostří
     Předlohy: marcelo_DfKk3DpR2_3_7 (Yohaku: regular grotesk na střed, 2. část nadpisu šedě, tunel karet pod textem, počítadlo vpravo dole),
     marcelo_DfRDD1dRlsR_1 (tunel přes celou šířku, popisky v rozích), uxui_DY1Jw2qooH3_1 (galerie střihů jako hlavní prvek). */
  :root {
    --pozadi:#EAE9E4; --text:#141413; --tlumeny:#62605B; --linka:rgba(20,20,19,.14);
    --akcent:#C8421C; --na-akcentu:#FFF8F3; --stopa:#B4B1AA; --karta:#D9D7D1; --ubeznik:transparent;
  }
  html[data-tema="tmava"] {
    --pozadi:#0F0F0E; --text:#EDEBE6; --tlumeny:#8E8C87; --linka:rgba(237,235,230,.14);
    --akcent:#E8582C; --na-akcentu:#120F0D; --stopa:#3C3B38; --karta:#1C1C1A; --ubeznik:rgba(232,88,44,.16);
  }
  body { background: var(--pozadi); color: var(--text); font-family: "Inter Tight", system-ui, sans-serif; }
  .mono { font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .02em; }

  /* ---------- lišta N2 ---------- */
  .lista { position: absolute; inset: 0 0 auto 0; z-index: 20; height: 76px; padding: 0 2.6vw;
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; font-size: 14px; }
  .znacka { display: inline-flex; align-items: center; gap: 10px; font-weight: 500; font-size: 17px; letter-spacing: -.02em; }
  .znacka i { width: 18px; height: 18px; border-radius: 50%; background: var(--text); }
  .odkazy { display: flex; gap: 34px; }
  .odkazy a:hover { color: var(--tlumeny); }
  .vpravo { justify-self: end; display: flex; align-items: center; gap: 10px; }
  .pilulka-lista { height: 40px; padding: 0 18px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px;
    border: 1px solid var(--linka); }
  .hamburger { display: none; width: 40px; height: 40px; align-content: center; gap: 6px; }
  .hamburger i { display: block; height: 1.5px; width: 20px; background: currentColor; }
  .menu-panel { display: none; }
  .lista.otevreno .menu-panel { display: grid; position: absolute; top: 62px; right: 20px; gap: 14px; padding: 20px 24px;
    background: var(--pozadi); border: 1px solid var(--linka); border-radius: 18px; font-size: 15px; }

  /* ---------- hero ---------- */
  .hero { min-height: max(100svh, 640px); position: relative; overflow: hidden; }
  .text { position: relative; z-index: 3; padding-top: max(15vh, 112px); text-align: center; }
  h1 { font-weight: 500; font-size: clamp(2.75rem, 6vw, 7rem); line-height: 1.04; letter-spacing: -.038em; padding: 0 4vw; }
  h1 .ton { color: var(--tlumeny); }
  h1 .spoj { white-space: nowrap; }
  .podtext { margin: 20px auto 0; max-width: 44ch; font-size: 16px; line-height: 1.5; color: var(--tlumeny); }
  .cta-obal { margin-top: 28px; }
  .cta { height: 46px; padding: 0 8px 0 22px; border-radius: 999px; display: inline-flex; align-items: center;
    background: var(--akcent); color: var(--na-akcentu); font-size: 14px; font-weight: 500; }
  .cta span { align-items: center; gap: 14px; }
  .cta b { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; font-weight: 400;
    background: color-mix(in srgb, var(--na-akcentu) 18%, transparent); }

  /* tunel karet */
  .tunel { position: absolute; z-index: 1; left: 0; right: 0; top: 47%; bottom: 0; perspective: 820px;
    perspective-origin: calc(50% + var(--px-mys-x, 0px)) calc(42% + var(--px-mys-y, 0px)); }
  .scena { position: absolute; left: 50%; top: 42%; width: 0; height: 0; transform-style: preserve-3d;
    /* při scrollu tunel „ujíždí“ k divákovi (data-parallax nastavuje --px-scroll) */
    transform: translate3d(0, 0, calc(var(--px-scroll, 0px) * var(--jizda, 1))); }
  /* teplé světlo v úběžníku (jen tmavá verze) */
  .svetlo { position: absolute; left: 50%; top: 42%; width: 62vw; height: 46vw; transform: translate(-50%, -50%); pointer-events: none;
    background: radial-gradient(closest-side, var(--ubeznik), color-mix(in srgb, var(--ubeznik) 72%, transparent) 22%,
      color-mix(in srgb, var(--ubeznik) 42%, transparent) 46%, color-mix(in srgb, var(--ubeznik) 16%, transparent) 72%, transparent); }
  .karta { position: absolute; width: var(--kw); height: calc(var(--kw) * 1.333); left: calc(var(--kw) / -2); top: calc(var(--kw) * -0.666);
    border-radius: 4px; overflow: hidden; background: var(--karta); backface-visibility: hidden;
    transform: translate3d(calc(var(--strana) * var(--x0)), 0, calc(var(--krok) * var(--z, calc(1 - var(--i))))) rotateY(calc(var(--strana) * -66deg)); }
  .karta:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .karta img { width: 100%; height: 100%; object-fit: cover; }
  .l { --strana: -1; } .p { --strana: 1; }
  .tunel { --kw: 14vw; --x0: 31vw; --krok: 14.5vw; }
  /* 861–1439 px: tunel větší (na 1024 px 17vw / 34vw / 16vw), plynule do hodnot pro 1440 px, bez skoku */
  @media (min-width: 861px) and (max-width: 1439px) { .tunel { --kw: calc(105px + 6.73vw); --x0: calc(107px + 23.56vw); --krok: calc(53px + 10.8vw); } }
  .mlha { position: absolute; z-index: 2; inset: 0; pointer-events: none;
    background: linear-gradient(to bottom, var(--pozadi) 0%, transparent 16%); }

  /* ---------- kolo 4: tunel plyne sám ----------
     Karty jedou k divákovi v nekonečné smyčce (hloubka --z nastavovaná skriptem), vpředu zmizí za okrajem a vzadu se doplní.
     Scroll smyčku zrychlí; najetí myší nebo focus na fotku ji zastaví a ukáže název střihu. Bez pohybu zůstává statický tunel. */
  html.pohyb .tunel.smycka .scena { transform: none; }   /* posun při scrollu nahrazuje zrychlení smyčky */
  html.pohyb .tunel.smycka .karta { will-change: transform, opacity; }
  .popisek-strihu { position: absolute; z-index: 4; left: 0; top: 0; padding: 7px 12px; border-radius: 999px; white-space: nowrap; pointer-events: none;
    background: color-mix(in srgb, var(--pozadi) 90%, transparent); color: var(--text); border: 1px solid var(--linka);
    opacity: 0; transition: opacity .25s ease; }
  .popisek-strihu.videt { opacity: 1; }

  .roh { position: absolute; z-index: 3; bottom: 22px; color: var(--tlumeny); }
  .roh-l { left: 2.6vw; }

  /* ---------- služby ---------- */
  .sluzby { position: relative; z-index: 3; background: var(--pozadi); padding: 120px 4vw 140px; }
  .sluzby h2 { font-weight: 500; font-size: clamp(2rem, 3.2vw, 3rem); letter-spacing: -.04em; margin-bottom: 48px; }
  .sluzby ul { border-top: 1px solid var(--linka); }
  .sluzby li { display: grid; grid-template-columns: 1.1fr 2fr auto; gap: 4vw; align-items: baseline; padding: 30px 0; border-bottom: 1px solid var(--linka); }
  .sluzby h3 { font-weight: 500; font-size: clamp(1.25rem, 1.8vw, 1.6rem); letter-spacing: -.03em; }
  .sluzby p { color: var(--tlumeny); font-size: 16px; line-height: 1.55; max-width: 52ch; }
  .sluzby .cena { font-size: 14px; color: var(--tlumeny); }

  @media (max-width: 860px) {
    .lista { height: 64px; padding: 0 20px; grid-template-columns: auto 1fr; }
    .odkazy, .pilulka-lista { display: none; }
    .hamburger { display: inline-grid; }
    .text { position: static; padding-top: 100px; }
    h1 { font-size: clamp(2.4rem, 12vw, 3.6rem); padding: 0 20px; }
    .podtext { font-size: 15px; padding: 0 28px; }
    .tunel { top: 33%; bottom: 96px; perspective: 460px; --kw: 34vw; --x0: 37vw; --krok: 32vw; --jizda: .55; }
    .svetlo { width: 120vw; height: 90vw; }
    .scena { top: 50%; }
    .cta-obal { position: absolute; z-index: 4; left: 0; right: 0; bottom: 56px; }
    .roh { bottom: 20px; }
    .sluzby { padding: 80px 20px 100px; }
    .sluzby li { grid-template-columns: 1fr auto; gap: 8px 16px; }
    .sluzby li p { grid-column: 1 / -1; grid-row: 2; }
  }
</style>
