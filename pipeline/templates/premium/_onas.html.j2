{# SEKCE_PATCH_V1 – O nás (varianta A), vlastní barva bloku pro každou šablonu (sekce.ONAS). Text přepíše offer_inject textem z webu firmy. #}
{% if onas %}
<section class="pz-onas" id="o-nas" aria-labelledby="pz-onas-h">
<style>
.pz-onas{box-sizing:border-box;background:{{ onas.bg }};color:{{ onas.fg }};padding:clamp(56px,8vw,112px) clamp(16px,5vw,64px)}
.pz-onas .in{max-width:1240px;margin:0 auto;display:grid;grid-template-columns:{{ '1fr 1fr' if onas.foto else '1fr' }};gap:clamp(28px,5vw,72px);align-items:center}
.pz-onas img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:16px}
.pz-onas h2{margin:0 0 18px;font-family:{{ onas.font|safe }};font-size:clamp(32px,4vw,56px);line-height:1.05;font-weight:500;color:{{ onas.fg }}}
.pz-onas p{margin:0;font-size:clamp(17px,1.4vw,20px);line-height:1.6;max-width:56ch;color:{{ onas.fg }}}
.pz-onas .pod{margin-top:16px;font-size:15px;color:{{ onas.mut }}}
@media(max-width:820px){.pz-onas .in{grid-template-columns:1fr}}
</style>
<div class="in">
{% if onas.foto %}<img src="{{ A }}{{ onas.foto }}" alt="{{ name }}" loading="lazy" data-onas-foto="">{% endif %}
<div><h2 id="pz-onas-h">{{ 'O nás' if lang == 'cs' else 'About us' }}</h2>
<p data-onas-text="">{{ onas_text }}</p>
<p class="pod">{{ name }}{% if city %} · {{ city }}{% endif %}</p></div>
</div>
</section>
{% endif %}
