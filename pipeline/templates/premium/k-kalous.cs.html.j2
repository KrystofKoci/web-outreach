<script>
(function(){
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const L=(p,a,b)=>Math.max(0,Math.min(1,(p-a)/(b-a)));
/* hero: scroll drives the arrival (and the reverse), two-blink greeting on arrival and on click */
const hero=document.getElementById('hero'),box=document.getElementById('carbox');
const film=document.getElementById('film'),fx=film.getContext('2d');
const lc=document.getElementById('lights'),lx=lc.getContext('2d');
const NF=+film.dataset.frames,FR=[];
const src=i=>film.dataset.src.replace('{n}',String(i).padStart(4,'0'));
const RINGS=[[501,382,18],[550,386,17],[827,384,8],[846,376,9]];const STOP=61;
let target=0,cur=0,drawn=-1,greeted=false,busy=false;
function draw(i){let j=i;while(j>0&&!(FR[j]&&FR[j].complete&&FR[j].naturalWidth))j--;
  if(j===drawn||!(FR[j]&&FR[j].complete&&FR[j].naturalWidth))return;drawn=j;fx.clearRect(0,0,980,580);fx.drawImage(FR[j],0,0,980,580);}
function glow(a){lx.clearRect(0,0,980,580);if(a<=0)return;
  lx.save();lx.globalCompositeOperation='lighter';
  for(const [x,y,r] of RINGS){
    let g=lx.createRadialGradient(x,y,0,x,y,r*5);
    g.addColorStop(0,`rgba(235,244,255,${.95*a})`);g.addColorStop(.25,`rgba(210,228,255,${.6*a})`);g.addColorStop(1,'rgba(205,225,255,0)');
    lx.fillStyle=g;lx.fillRect(x-r*5,y-r*5,r*10,r*10);
    lx.strokeStyle=`rgba(255,255,255,${a})`;lx.lineWidth=4;lx.beginPath();lx.arc(x,y,r*.85,0,7);lx.stroke();}
  lx.restore();}
function greet(){if(busy||Math.round(cur)<STOP)return;busy=true;const t0=performance.now();
  (function f(now){const t=(now-t0)/1000;
    const a=Math.exp(-Math.pow((t-.12)/.055,2))+Math.exp(-Math.pow((t-.38)/.055,2));
    glow(Math.min(1,a));
    if(t<.62)requestAnimationFrame(f);else{glow(0);busy=false;}})(t0);}
/* scroll -> target frame; the car eases toward it so wheel steps feel like motion, not jumps */
function readScroll(){const r=hero.getBoundingClientRect(),span=r.height-innerHeight;
  const raw=span>0?Math.min(1,Math.max(0,-r.top/span)):0;
  const p=Math.min(1,Math.max(0,(raw-.02)/.86));         /* last 12 % of the pin = car standing still */
  target=p*(NF-1);}
let raf=0;
function wake(){if(!raf)raf=requestAnimationFrame(tick);}
function tick(){raf=0;
  const d=target-cur;cur+=Math.abs(d)<.05?d:d*.16;
  draw(Math.round(cur));
  if(Math.round(cur)>=STOP){if(!greeted){greeted=true;setTimeout(greet,180);}}
  else if(cur<STOP-10)greeted=false;                         /* rolled back: greet again on the next arrival */
  if(!busy&&Math.round(cur)<STOP)lx.clearRect(0,0,980,580);
  if(cur!==target)wake();}                                   /* stojí-li auto, tick spí do dalšího scrollu */
for(let i=1;i<=NF;i++){const im=new Image();im.decoding='async';
  im.onload=()=>{if(i===1){document.querySelector('.hstage').classList.add('film');drawn=-1;draw(Math.round(cur));}else if(i-1<=Math.round(cur))wake();};
  im.src=src(i);FR[i-1]=im;}
const onScroll=()=>{readScroll();wake();};
addEventListener('scroll',onScroll,{passive:true});addEventListener('resize',onScroll);
readScroll();wake();
box.addEventListener('click',greet);
/* reveal */
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.12});
document.querySelectorAll('.reveal, .intro').forEach(el=>io.observe(el));
/* rating */
(function(){const r=document.getElementById('hodnoceni');const rating=parseFloat(String(r.dataset.rating).replace(',','.')),count=parseInt(r.dataset.count,10);
  const st=r.querySelector('.stars'),rn=document.getElementById('rnum'),tx=document.getElementById('rtxt');
  if(!(rating>0)){st.textContent='';rn.innerHTML='<span class="doplnit">[doplnit]</span>';tx.textContent='';return;}
  st.textContent='★'.repeat(Math.round(rating))+'☆'.repeat(5-Math.round(rating));rn.textContent=rating.toFixed(1).replace('.',',');
  /* pod 50 recenzí jen známka, od 50 i počet */
  tx.textContent=count>=50?`${count} recenzí na Google`:'';})();
/* hours */
const d=new Date().getDay();document.querySelectorAll('#hours li').forEach(li=>li.classList.toggle('today',+li.dataset.d===d));
/* mobilní menu */
(function(){const b=document.querySelector('.menu-tl'),p=document.getElementById('menu-panel');if(!b||!p)return;
  const zavri=(fokus)=>{p.hidden=true;b.setAttribute('aria-expanded','false');if(fokus)b.focus();};
  b.addEventListener('click',()=>{const o=p.hidden;p.hidden=!o;b.setAttribute('aria-expanded',String(o));if(o)p.querySelector('a').focus();});
  p.addEventListener('click',e=>{if(e.target.closest('a'))zavri(false);});
  document.addEventListener('keydown',e=>{if(e.key==='Escape'&&!p.hidden)zavri(true);});
  document.addEventListener('click',e=>{if(!p.hidden&&!p.contains(e.target)&&!b.contains(e.target))zavri(false);});
  matchMedia('(min-width:761px)').addEventListener('change',e=>{if(e.matches)zavri(false);});})();
/* objednávka servisu: stejná pole a logika jako V10 + den a čas přistavení; nic se neodesílá (ukázka šablony) */
(function(){
  const f=document.querySelector('[data-formular="objednavka"]');if(!f)return;
  const hl=document.getElementById('obj-hlaska');
  const typSel=document.getElementById('f-typ'),typTxt=document.getElementById('f-typ-jine'),typLabel=document.getElementById('l-typ');
  const rok=document.getElementById('f-rok'),ROK_MIN=1950,ROK_MAX=new Date().getFullYear();
  const den=document.getElementById('f-den');
  const zprava=document.getElementById('f-zprava'),fsSluzby=document.getElementById('f-sluzby'),volby=f.querySelector('[data-sluzby-volby]');
  const seznam=document.querySelector('ol[data-sluzby="autoservis"]');
  const TYPY={auto:['Osobní','SUV','Kombi','Dodávka'],motorka:['Silniční','Enduro / cross','Skútr','Čtyřkolka']};
  document.getElementById('e-rok').textContent='Rok výroby zadejte čtyřmi číslicemi, od '+ROK_MIN+' do '+ROK_MAX+'.';
  const dnes=()=>{const d=new Date();return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0');};
  den.min=dnes();
  /* zaškrtávací služby = položky li[data-sluzba] seznamu služeb (název ze span.n) */
  function nactiSluzby(){
    const byly={};volby.querySelectorAll('input:checked').forEach(i=>{byly[i.dataset.id]=true;});
    volby.textContent='';
    const polozky=seznam?seznam.querySelectorAll('li[data-sluzba]'):[];
    polozky.forEach(li=>{const id=li.dataset.sluzba,n=li.querySelector('.n');const nazev=(n?n.textContent:id).replace(/\s+/g,' ').trim();
      const lab=document.createElement('label');lab.className='zaskrt';
      const inp=document.createElement('input');inp.type='checkbox';inp.className='sr-only';inp.name='sluzby[]';inp.id='f-sl-'+id;inp.value=nazev;inp.dataset.id=id;inp.checked=!!byly[id];
      const pl=document.createElement('span');pl.className='zaskrt-plocha';const box=document.createElement('span');box.className='box';box.setAttribute('aria-hidden','true');
      pl.appendChild(box);pl.appendChild(document.createTextNode(nazev));lab.appendChild(inp);lab.appendChild(pl);volby.appendChild(lab);});
    fsSluzby.hidden=!polozky.length;
    if(!document.getElementById('e-sluzby').hidden)over('sluzby');
  }
  /* typ vozidla podle druhu: auto / motorka = výběr, jiné = volné pole */
  function nastavTyp(druh){const jine=druh==='jine';
    typSel.parentNode.hidden=jine;typSel.disabled=jine||!druh;typTxt.hidden=!jine;typTxt.disabled=!jine;typLabel.htmlFor=jine?'f-typ-jine':'f-typ';
    if(jine)return;typSel.textContent='';
    const prvni=document.createElement('option');prvni.value='';prvni.textContent=druh?'Vyberte…':'Nejdřív zvolte druh vozidla';typSel.appendChild(prvni);
    (TYPY[druh]||[]).forEach(t=>{const o=document.createElement('option');o.value=t;o.textContent=t;typSel.appendChild(o);});}
  const vybrany=f.querySelector('input[name="druh"]:checked');if(vybrany)nastavTyp(vybrany.value);
  const radia=()=>Array.from(f.querySelectorAll('input[name="druh"]'));
  const zaskrt=()=>Array.from(volby.querySelectorAll('input'));
  const pole=id=>()=>[document.getElementById(id)];
  const hodnota=id=>document.getElementById(id).value.trim();
  const PRAVIDLA={
    jmeno:{cile:pole('f-jmeno'),spatne:()=>!hodnota('f-jmeno')},
    telefon:{cile:pole('f-telefon'),spatne:()=>hodnota('f-telefon').replace(/\D/g,'').length<9},
    email:{cile:pole('f-email'),spatne:()=>{const v=hodnota('f-email');return !!v&&!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v);}},
    druh:{cile:radia,skupina:'f-druh',spatne:()=>!f.querySelector('input[name="druh"]:checked')},
    znacka:{cile:pole('f-znacka'),spatne:()=>!hodnota('f-znacka')},
    model:{cile:pole('f-model'),spatne:()=>!hodnota('f-model')},
    rok:{cile:pole('f-rok'),spatne:()=>{const v=hodnota('f-rok');if(!v)return false;const n=+v;return !/^\d{4}$/.test(v)||n<ROK_MIN||n>ROK_MAX;}},
    den:{cile:pole('f-den'),spatne:()=>{const v=hodnota('f-den');return !v||v<dnes();}},
    sluzby:{cile:()=>zaskrt().concat([zprava]),skupina:'f-sluzby',spatne:()=>!volby.querySelector('input:checked')&&!zprava.value.trim()}
  };
  function oznac(k,ano){const p=PRAVIDLA[k],idCh='e-'+k;document.getElementById(idCh).hidden=!ano;
    if(p.skupina)document.getElementById(p.skupina).classList.toggle('je-chyba',ano);
    p.cile().forEach(el=>{const d=(el.getAttribute('aria-describedby')||'').split(' ').filter(x=>x&&x!==idCh);if(ano)d.push(idCh);
      if(d.length)el.setAttribute('aria-describedby',d.join(' '));else el.removeAttribute('aria-describedby');
      if(ano)el.setAttribute('aria-invalid','true');else el.removeAttribute('aria-invalid');});}
  function over(k){const s=PRAVIDLA[k].spatne();oznac(k,s);return s;}
  nactiSluzby();
  f.addEventListener('submit',e=>{e.preventDefault();let prvni=null;
    Object.keys(PRAVIDLA).forEach(k=>{if(over(k)&&!prvni)prvni=PRAVIDLA[k].cile().filter(el=>!el.closest('[hidden]'))[0];});
    if(prvni){hl.classList.remove('ukazka');hl.classList.add('chybi');hl.textContent='Zkontrolujte prosím označená pole.';prvni.focus();return;}
    hl.classList.remove('chybi');hl.classList.add('ukazka');hl.textContent='Děkujeme, ozveme se vám co nejdříve.';});
  const klic=el=>{if(el.name==='druh')return 'druh';if(el.name==='sluzby[]'||el===zprava)return 'sluzby';return el.name in PRAVIDLA?el.name:null;};
  const znovu=e=>{const k=klic(e.target);if(k&&!document.getElementById('e-'+k).hidden)over(k);};
  rok.addEventListener('input',()=>{const c=rok.value.replace(/\D/g,'').slice(0,4);if(c!==rok.value)rok.value=c;});
  f.addEventListener('input',znovu);
  f.addEventListener('change',e=>{if(e.target.name==='druh')nastavTyp(e.target.value);znovu(e);});
})();
