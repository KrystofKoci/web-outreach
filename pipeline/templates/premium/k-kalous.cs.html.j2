<script>
/* page scroll drives the fold carousel; arrows step one card and keep the scroll in sync */
(function(){
  const sec=document.getElementById('sluzby'),N=6;
  const prev=document.getElementById('foldPrev'),next=document.getElementById('foldNext'),no=document.getElementById('foldNo');
  let target=0,cur=0,fc=null,lastShown=-1;
  /* názvy, popisy a ceny služeb bere karusel ze seznamu ol[data-sluzby] – systém doplní cenu jen do span.cena[data-cena] */
  const INFO=Array.from(document.querySelectorAll('ol[data-sluzby] li[data-sluzba]')).map(li=>[li.querySelector('.n').textContent,'',li.querySelector('.cena').textContent.trim(),li.querySelector('.p').textContent]);
  const box=document.getElementById('foldInfo'),tT=document.getElementById('foldTitle'),tF=document.getElementById('foldFrom'),tP=document.getElementById('foldPrice'),tD=document.getElementById('foldDesc');
  let infoTimer=0,first=true;
  function showInfo(i){const d=INFO[i];if(!d)return;
    const put=()=>{tT.textContent=d[0];tF.textContent=d[1];
      if(/\d/.test(d[2]))tP.textContent=d[2];else{tP.textContent='';const sp=document.createElement('span');sp.className='fold-dotaz';sp.textContent=d[2];tP.appendChild(sp);}
      tD.textContent=d[3];};
    if(first){first=false;put();return;}
    box.classList.add('swap');clearTimeout(infoTimer);
    infoTimer=setTimeout(()=>{put();box.classList.remove('swap');},230);}

  const span=()=>Math.max(1,sec.offsetHeight-innerHeight);
  let raw=0,idle=0;
  const ss=(a,b,x)=>{const t=Math.min(1,Math.max(0,(x-a)/(b-a)));return t*t*(3-2*t);};
  function read(){const r=sec.getBoundingClientRect();const p=Math.min(1,Math.max(0,-r.top/span()));
    const q=Math.min(1,Math.max(0,(p-.04)/.92));raw=q*(N-1);
    /* each card rests flat for the middle of its scroll step, the fold happens between */
    const i=Math.floor(raw),f=raw-i;target=Math.min(N-1,i+ss(.3,.7,f));
    wake();clearTimeout(idle);idle=setTimeout(()=>{target=Math.round(raw);wake();},160);}
  let raf=0,videt=true,posSet=NaN;
  const wake=()=>{if(!raf)raf=requestAnimationFrame(tick);};
  function tick(){raf=0;const d=target-cur;cur+=Math.abs(d)<.002?d:d*.14;
    if(fc&&videt&&cur!==posSet){fc.setPosition(cur);posSet=cur;}  /* WebGL kreslí jen při změně a v záběru */
    const idx=Math.round(cur);if(idx!==lastShown){lastShown=idx;no.textContent=String(idx+1).padStart(2,'0');showInfo(idx);
      prev.disabled=idx<=0;next.disabled=idx>=N-1;}
    if(cur!==target)wake();}
  new IntersectionObserver(es=>{videt=es[es.length-1].isIntersecting;if(videt){posSet=NaN;wake();}},{rootMargin:'100px 0px'}).observe(sec);
  function scrollToIndex(i){i=Math.max(0,Math.min(N-1,i));
    const q=i/(N-1),p=.04+q*.92;const top=sec.getBoundingClientRect().top+scrollY+p*span();
    scrollTo({top:Math.round(top),behavior:'smooth'});}
  prev.addEventListener('click',()=>scrollToIndex(Math.round(raw)-1));
  next.addEventListener('click',()=>scrollToIndex(Math.round(raw)+1));
  function attach(){fc=window.__fold||null;posSet=NaN;wake();}
  attach();addEventListener('fold-ready',attach);
  addEventListener('scroll',read,{passive:true});addEventListener('resize',()=>{posSet=NaN;read();});read();cur=target;wake();
})();
</script>
<script type="module">
/**
 * Fold Carousel — a looping row of cards where the centre card lies flat and
 * its neighbours fold away from it like doors: each one swings about its inner
 * edge, recedes, and curls back toward the lens at the side of the stage, where
 * the stretched part of the picture smears into streaks and the edges pick up a
 * thin spectral fringe. Drag, the wheel, the arrow keys or the hidden buttons
 * move it one card at a time; a critically damped spring does the settling.
 *
 * The geometry is pure maths and is exported so the unit tests can hold it to
 * its contract without a GPU. Three.js is loaded on demand (the site's bundler
 * code-splits it; the downloaded file resolves it through an importmap).
 *
 * Units: the centre card is 1 wide and CARD_H tall, world x to the right, z
 * toward the camera, and the camera sits at (0, 0, CAMERA_Z).
 */

const CARD_H = 1.25001;
const CAMERA_Z = 3.2;
const SEGMENTS = 128;
const TEX_W = 1024;
const TEX_H = 1280;
// A card further than this many slots from the centre is fully off stage.
const VISIBLE_SPAN = 1.62;

// ---------------------------------------------------------------------------
// Geometry
//
// Every card is described by its signed slot offset s (0 = centre, <0 = left).
// Left side: the card swings about its own LEFT edge (the hinge) like a door
// opening toward the viewer, 0 -> 180 deg as |s| goes 0 -> 1, while the hinge
// recedes. At |s| = 1 it lies on the rest "track": a short flat run facing away
// (so it reads mirrored), then a curl back toward the camera that flares off
// the side of the stage. Past |s| = 1 the card slides out along that track.
// The right side is the exact mirror (hinge = the card's own RIGHT edge).
// ---------------------------------------------------------------------------

// Rest track (left side), fitted to the silhouettes of the resting neighbours
// in the reference frames. (x, z) control points.
const TRACK_POINTS = [
  [-1.12999, -1.67],
  [-1.39999, -1.66501],
  [-1.53001, -1.61001],
  [-1.56501, -1.45001],
  [-1.52699, -1.11001],
  [-1.45399, -0.700001],
  [-1.35401, -0.260001],
  [-1.24299, 0.16],
  [-1.129, 0.530001],
  [-1.03, 0.950001],
  [-1.01999, 1.40001],
  [-1.25, 1.99999],
  [-1.90001, 2.44999],
  [-3.20001, 2.75001],
  [-12.0, 2.95001],
  [-60.0001, 3.00001]
];

const HINGE_REST = TRACK_POINTS[0];

// Swing keyframes over t = |s| in [0, 1]: the leaving card is at ~55 deg while
// the entering one is still folded flat with its flare, and both pass edge-on
// slightly after the midpoint.
const KEY_T = [0, 0.299999, 0.500001, 0.7, 1];
const KEY_ANGLE = [0, 0.299999, 0.515001, 0.919999, 1]; // fraction of 180 deg
const KEY_HX = [-0.5, -0.77, -0.799999, -0.830001, HINGE_REST[0]];
const KEY_HZ = [0, -0.449999, -0.869999, -1.10001, HINGE_REST[1]];
const KEY_CURL = [0, 0, 0.0199999, 0.850001, 1];

// Monotone cubic (Fritsch-Carlson) interpolation through the keyframes, so a
// keyframe never overshoots into a fold the reference does not show.
function monotone(xs, ys) {
  const n = xs.length;
  const d = [];
  const m = new Array(n);
  for (let i = 0; i < n - 1; i++) d.push((ys[i + 1] - ys[i]) / (xs[i + 1] - xs[i]));
  m[0] = d[0];
  m[n - 1] = d[n - 2];
  for (let i = 1; i < n - 1; i++) m[i] = d[i - 1] * d[i] <= 0 ? 0 : (d[i - 1] + d[i]) / 2;
  for (let i = 0; i < n - 1; i++) {
    if (d[i] === 0) { m[i] = m[i + 1] = 0; continue; }
    const a = m[i] / d[i];
    const b = m[i + 1] / d[i];
    const h = a * a + b * b;
    if (h > 9) { const k = 3 / Math.sqrt(h); m[i] = k * a * d[i]; m[i + 1] = k * b * d[i]; }
  }
  return (x) => {
    if (x <= xs[0]) return ys[0];
    if (x >= xs[n - 1]) return ys[n - 1];
    let i = 0;
    while (x > xs[i + 1]) i++;
    const h = xs[i + 1] - xs[i];
    const t = (x - xs[i]) / h;
    const t2 = t * t;
    const t3 = t2 * t;
    return (2 * t3 - 3 * t2 + 1) * ys[i] + (t3 - 2 * t2 + t) * h * m[i]
      + (-2 * t3 + 3 * t2) * ys[i + 1] + (t3 - t2) * h * m[i + 1];
  };
}
const angleAt = monotone(KEY_T, KEY_ANGLE);
const hingeX = monotone(KEY_T, KEY_HX);
const hingeZ = monotone(KEY_T, KEY_HZ);
const curlAt = monotone(KEY_T, KEY_CURL);

// Texture parameter p (0..1 over one card, >1 beyond it) -> arc length on the
// track. The first FLAT_U of the card keeps its size; after that the texture
// is stretched quadratically, which is what smears it into streaks.
const FLAT_U = 0.42;
const STRETCH = 8;
function arcOf(p) {
  if (p <= FLAT_U) return p;
  const q = p - FLAT_U;
  return FLAT_U + q + STRETCH * q * q;
}
// d(arc)/dp: 1 where the picture keeps its size, growing where it streaks.
function stretchOf(p) {
  return p <= FLAT_U ? 1 : 1 + 2 * STRETCH * (p - FLAT_U);
}

// Dense arc-length table of the Catmull-Rom spline through TRACK_POINTS.
const track = (() => {
  const pts = [];
  const P = TRACK_POINTS;
  const n = P.length;
  const get = (i) => P[Math.max(0, Math.min(n - 1, i))];
  for (let i = 0; i < n - 1; i++) {
    const p0 = i === 0 ? [2 * P[0][0] - P[1][0], 2 * P[0][1] - P[1][1]] : get(i - 1);
    const p1 = get(i);
    const p2 = get(i + 1);
    const p3 = i + 2 >= n ? [2 * P[n - 1][0] - P[n - 2][0], 2 * P[n - 1][1] - P[n - 2][1]] : get(i + 2);
    const steps = 80;
    for (let k = 0; k < steps; k++) {
      const t = k / steps;
      const t2 = t * t;
      const t3 = t2 * t;
      const c = (a, b, cc, d) =>
        0.499999 * (2 * b + (-a + cc) * t + (2 * a - 5 * b + 4 * cc - d) * t2 + (-a + 3 * b - 3 * cc + d) * t3);
      pts.push([c(p0[0], p1[0], p2[0], p3[0]), c(p0[1], p1[1], p2[1], p3[1])]);
    }
  }
  pts.push(P[n - 1]);
  const len = [0];
  for (let i = 1; i < pts.length; i++) {
    len.push(len[i - 1] + Math.hypot(pts[i][0] - pts[i - 1][0], pts[i][1] - pts[i - 1][1]));
  }
  return { pts, len, total: len[len.length - 1] };
})();

function trackAt(arc, out) {
  const { pts, len, total } = track;
  const a = Math.min(Math.max(arc, 0), total);
  let lo = 0;
  let hi = len.length - 1;
  while (hi - lo > 1) {
    const mid = (lo + hi) >> 1;
    if (len[mid] <= a) lo = mid; else hi = mid;
  }
  const seg = len[hi] - len[lo] || 1;
  const f = (a - len[lo]) / seg;
  out[0] = pts[lo][0] + (pts[hi][0] - pts[lo][0]) * f;
  out[1] = pts[lo][1] + (pts[hi][1] - pts[lo][1]) * f;
  return out;
}

// Rest shape in the hinge's local frame: a = along the card's initial
// direction (-x at rest), b = toward the camera (+z at rest).
function restLocal(p, out) {
  trackAt(arcOf(p), out);
  const x = out[0] - HINGE_REST[0];
  const z = out[1] - HINGE_REST[1];
  out[0] = -x;
  out[1] = z;
  return out;
}

// Left-side card with t = |s| >= 0. u in [0, 1] from the hinge edge.
// Writes (x, z, smear) into out.
const tmp = [0, 0];
function leftPoint(t, u, out) {
  if (t >= 1) {
    // Slide out along the rest track: a sliver left at t = 1.3, gone by 1.5.
    const p = u + 3.99999 * Math.pow(t - 1, 1.30001);
    trackAt(arcOf(p), out);
    out[2] = stretchOf(p) - 1;
    return out;
  }
  const theta = Math.PI * angleAt(t);
  const curl = curlAt(t);
  // The rigid part of the card swings with the door angle; the curl is added
  // in the rest orientation (toward the camera) so the near-camera flare never
  // swings across the view while the angle is still settling.
  restLocal(u, tmp);
  const bendX = -(tmp[0] - u) * curl;
  const bendZ = tmp[1] * curl;
  out[0] = hingeX(t) + u * Math.cos(theta) + bendX;
  out[1] = hingeZ(t) + u * Math.sin(theta) + bendZ;
  out[2] = (stretchOf(u) - 1) * curl;
  return out;
}

// Any card: s = signed slot offset, u in [0, 1] = card-local x (0 = own left
// edge). Returns [x, z, smear].
function cardPoint(s, u, out) {
  if (s <= 0) return leftPoint(-s, u, out);
  leftPoint(s, 1 - u, out);
  out[0] = -out[0];
  return out;
}

// ---------------------------------------------------------------------------
// Motion and layout
// ---------------------------------------------------------------------------

const wrapIndex = (x, n) => ((x % n) + n) % n;

// Signed distance of card i from the strip position, on the shorter way round
// the loop.
function offsetOf(i, pos, n) {
  let s = wrapIndex(i - pos, n);
  if (s >= n / 2) s -= n;
  return s;
}

// Exact solution of a critically damped spring over dt, so it is stable at any
// frame rate (explicit Euler diverges once omega * dt > 1). Returns [pos, vel].
function springStep(pos, vel, target, dt, omega) {
  const x = pos - target;
  const e = Math.exp(-omega * dt);
  const c = vel + omega * x;
  let p = target + (x + c * dt) * e;
  let v = (vel - omega * c * dt) * e;
  if (Math.abs(p - target) < 1e-4 && Math.abs(v) < 1e-3) {
    p = target;
    v = 0;
  }
  return [p, v];
}

// A released drag lands on the nearest card, nudged at most 0.6 of a slot in
// the direction of the fling so a flick always goes somewhere.
function flingTarget(pos, velocity) {
  return Math.round(pos + Math.max(-0.6, Math.min(0.6, velocity * 0.119999)));
}

// A wheel gesture that ends between cards snaps to one; any deliberate gesture
// (one mouse notch included) moves at least one card.
function settleWheel(from, target) {
  const moved = target - from;
  if (Math.abs(moved) < 0.08) return from;
  return from + Math.sign(moved) * Math.max(1, Math.round(Math.abs(moved)));
}

// Stage framing. The reference card is 35.7 % of the stage width and 49.4 % of
// its height (whichever binds); portrait stages get half the width so the
// folded neighbours stay legible. The camera's field of view is solved so the
// centre card is exactly cardPx wide on screen.
function layoutFor(width, height) {
  const W = Math.max(1, width);
  const H = Math.max(1, height);
  const widthShare = W / H < 0.899999 ? 0.500001 : 0.357001;
  const cardPx = Math.min(W * widthShare, H * 0.494001);
  const stageW = cardPx / 0.357001;
  return {
    cardPx,
    slotPx: cardPx * 1.25001,
    fov: (2 * Math.atan(H / 2 / cardPx / CAMERA_Z) * 180) / Math.PI,
    // The card centre sits slightly above the stage centre.
    offsetY: cardPx * 0.044,
    // Screen x relative to the reference stage, so the fringe follows the
    // geometry at any aspect ratio.
    edgeScale: W / stageW,
    fringe: 0.0219999 * stageW,
    haze: 0.0799999 * stageW
  };
}

// Bleed of a transparent stage. The flares are taller than the stage and run
// off its sides, so a canvas cut at the stage box shows straight edges once no
// painted panel hides them. The canvas instead grows out to the box that
// clips the stage on the page (the editor preview, a fullscreen view), each
// side capped at the larger stage dimension. Rects are in screen pixels;
// `scale` is screen pixels per layout pixel (the editor fits the stage with a
// CSS transform). Returns whole layout pixels per side.
function bleedFor(stageRect, clipRect, scale, width, height) {
  if (!clipRect || !(scale > 0)) return { left: 0, top: 0, right: 0, bottom: 0 };
  const cap = Math.max(width, height);
  const side = (px) => Math.min(cap, Math.max(0, Math.ceil(px / scale)));
  return {
    left: side(stageRect.left - clipRect.left),
    top: side(stageRect.top - clipRect.top),
    right: side(clipRect.right - stageRect.right),
    bottom: side(clipRect.bottom - stageRect.bottom)
  };
}

// Nearest ancestor that clips its content: the stage may paint up to its edges.
// None means the page gave the stage no larger box, so there is nothing to
// bleed into.
function clipBoxOf(root) {
  for (let el = root.parentElement; el && el !== document.body && el !== document.documentElement; el = el.parentElement) {
    if (el.classList.contains('fc-frame')) continue;
    const style = getComputedStyle(el);
    if (style.overflowX !== 'visible' || style.overflowY !== 'visible') return el;
  }
  return null;
}

function parseColor(value, fallback = [240, 240, 240]) {
  const hex = String(value ?? '').trim();
  const short = /^#([0-9a-f])([0-9a-f])([0-9a-f])$/i.exec(hex);
  if (short) return short.slice(1).map((c) => parseInt(c + c, 16));
  const long = /^#([0-9a-f]{2})([0-9a-f]{2})([0-9a-f]{2})$/i.exec(hex);
  if (long) return long.slice(1).map((c) => parseInt(c, 16));
  return fallback;
}

// ---------------------------------------------------------------------------
// Card faces
// ---------------------------------------------------------------------------

const FONT_STACK = "Inter, -apple-system, 'Segoe UI', sans-serif";
const font = (px, weight) => `${weight} ${px}px ${FONT_STACK}`;

// A tag that opens with a bullet is a status, not a label: it draws as a green
// dot and the words after it, without a pill.
const LIVE_TAG = /^[●•]\s*/;

function fitText(ctx, text, maxWidth) {
  const value = String(text ?? '');
  if (!value || ctx.measureText(value).width <= maxWidth) return value;
  let lo = 0;
  let hi = value.length;
  while (lo < hi) {
    const mid = (lo + hi + 1) >> 1;
    if (ctx.measureText(`${value.slice(0, mid).trimEnd()}…`).width <= maxWidth) lo = mid;
    else hi = mid - 1;
  }
  return `${value.slice(0, lo).trimEnd()}…`;
}

function roundRect(ctx, x, y, w, h, r) {
  ctx.beginPath();
  ctx.moveTo(x + r, y);
  ctx.arcTo(x + w, y, x + w, y + h, r);
  ctx.arcTo(x + w, y + h, x, y + h, r);
  ctx.arcTo(x, y + h, x, y, r);
  ctx.arcTo(x, y, x + w, y, r);
  ctx.closePath();
}

function drawCardFace(ctx, card, image) {
  const W = TEX_W;
  const H = TEX_H;
  ctx.clearRect(0, 0, W, H);
  ctx.fillStyle = '#2a2a2e';
  ctx.fillRect(0, 0, W, H);
  const iw = image?.naturalWidth || image?.width || 0;
  const ih = image?.naturalHeight || image?.height || 0;
  if (image && iw > 0 && ih > 0) {
    const scale = Math.max(W / iw, H / ih);
    const w = iw * scale;
    const h = ih * scale;
    ctx.drawImage(image, (W - w) / 2, (H - h) / 2, w, h);
  } else if (image) {
    // An image without intrinsic size (a sizeless SVG fill) covers the face.
    ctx.drawImage(image, 0, 0, W, H);
  }

  // Soft scrims so the white type stays legible on bright pictures.
  let g = ctx.createLinearGradient(0, 0, 0, 360);
  g.addColorStop(0, 'rgba(0,0,0,0.26)');
  g.addColorStop(1, 'rgba(0,0,0,0)');
  ctx.fillStyle = g;
  ctx.fillRect(0, 0, W, 360);
  g = ctx.createLinearGradient(0, H - 300, 0, H);
  g.addColorStop(0, 'rgba(0,0,0,0)');
  g.addColorStop(1, 'rgba(0,0,0,0.3)');
  ctx.fillStyle = g;
  ctx.fillRect(0, H - 300, W, 300);

  ctx.textBaseline = 'alphabetic';
  const tag = String(card.tag ?? '').trim();
  const live = LIVE_TAG.test(tag);
  const tagText = live ? tag.replace(LIVE_TAG, '') : tag;

  let pillWidth = 0;
  if (tagText && !live) {
    ctx.font = font(34, 500);
    const label = fitText(ctx, tagText, 360);
    const tw = ctx.measureText(label).width;
    pillWidth = tw + 56;
    const ph = 60;
    const px = W - 72 - pillWidth;
    const py = 112;
    roundRect(ctx, px, py, pillWidth, ph, ph / 2);
    ctx.fillStyle = 'rgba(255,255,255,0.18)';
    ctx.fill();
    ctx.fillStyle = 'rgba(255,255,255,0.9)';
    ctx.fillText(label, px + 28, py + 42);
  }

  const titleWidth = W - 140 - (pillWidth ? pillWidth + 24 : 0);
  ctx.fillStyle = 'rgba(255,255,255,0.93)';
  ctx.font = font(41, 420);
  ctx.fillText(fitText(ctx, card.title, titleWidth), 70, 150);
  ctx.fillText(fitText(ctx, card.subtitle, titleWidth), 70, 205);

  if (live) {
    ctx.fillStyle = '#7dff9b';
    ctx.beginPath();
    ctx.arc(82, 262, 10, 0, Math.PI * 2);
    ctx.fill();
    if (tagText) {
      ctx.font = font(36, 500);
      ctx.fillStyle = 'rgba(255,255,255,0.9)';
      ctx.fillText(fitText(ctx, tagText, W - 244), 104, 275);
    }
  }

  ctx.font = font(41, 420);
  ctx.fillStyle = 'rgba(255,255,255,0.93)';
  ctx.fillText(fitText(ctx, card.caption, W - 140), 70, 1186);
}

// ---------------------------------------------------------------------------
// Shaders
// ---------------------------------------------------------------------------

const CARD_VERTEX = /* glsl */`
  attribute float smear;
  varying vec2 vUv;
  varying float vSmear;
  void main() {
    vUv = uv;
    vSmear = smear;
    gl_Position = projectionMatrix * modelViewMatrix * vec4(position, 1.0);
  }
`;

const CARD_FRAGMENT = /* glsl */`
  uniform sampler2D map;
  uniform float radius;
  uniform float smearAmount;
  varying vec2 vUv;
  varying float vSmear;
  void main() {
    vec2 size = vec2(1.0, ${CARD_H.toFixed(3)});
    vec2 p = vUv * size - size * 0.5;
    vec2 q = abs(p) - size * 0.5 + radius;
    float d = length(max(q, 0.0)) + min(max(q.x, q.y), 0.0) - radius;
    float aa = max(fwidth(d), 1e-5);
    float alpha = clamp(0.5 - d / aa, 0.0, 1.0);
    if (alpha <= 0.0) discard;

    // Horizontal streak smear on the stretched (flared) part.
    float spread = vSmear * smearAmount;
    vec3 col = vec3(0.0);
    for (int i = 0; i < 9; i++) {
      float o = (float(i) / 8.0 - 0.5) * spread;
      col += texture2D(map, vec2(clamp(vUv.x + o, 0.0, 1.0), vUv.y)).rgb;
    }
    col /= 9.0;
    gl_FragColor = vec4(col, alpha);
  }
`;

const POST_VERTEX = /* glsl */`
  varying vec2 vUv;
  void main() {
    vUv = position.xy * 0.500001 + 0.499999;
    gl_Position = vec4(position.xy, 0.0, 1.0);
  }
`;

const POST_FRAGMENT = /* glsl */`
  uniform sampler2D tDiffuse;
  uniform vec2 resolution;
  uniform float strength;
  uniform float haze;
  uniform float edgeScale;
  uniform vec2 centre;
  uniform vec3 bg;
  uniform float clearStage;
  varying vec2 vUv;
  const int TAPS = 24;
  const int HAZE_TAPS = 14;
  const float HAZE_HUE = -1.22;
  const float HAZE_LIGHT = 0.35;
  const float HAZE_SAT = 1.8;
  const float HAZE_ALPHA = 0.9;
  vec3 spectrum(float t) {
    // t = 0 -> blue, 0.5 -> green, 1 -> red (red is displaced furthest out).
    return max(vec3(
      1.0 - abs(t - 1.0) * 1.9,
      1.0 - abs(t - 0.5) * 2.4,
      1.0 - abs(t) * 1.9
    ), 0.0) + 0.02;
  }
  // Hue rotation about the grey axis (Rodrigues); positive = red -> green.
  vec3 hueRotate(vec3 c, float a) {
    const vec3 k = vec3(0.57735027);
    float ca = cos(a);
    return c * ca + cross(k, c) * sin(a) + k * dot(k, c) * (1.0 - ca);
  }
  float isCard(vec3 s) {
    return smoothstep(0.015, 0.05, distance(s, bg));
  }
  vec3 hazeTint(vec3 c) {
    vec3 ghost = hueRotate(c, HAZE_HUE);
    float luma = dot(ghost, vec3(0.299, 0.587, 0.114));
    return clamp(mix(vec3(luma), ghost, HAZE_SAT), 0.0, 1.0);
  }

  // Transparent stage. The cards were drawn over a zero-alpha clear, so the
  // target holds premultiplied colour and coverage lives in alpha; the page
  // behind is unknown, so the haze fades by opacity instead of lifting toward
  // a stage colour, and it is laid under the card rather than over it.
  vec4 clearPass(vec2 c, float k, vec2 dir) {
    vec2 off = dir * strength * k / resolution;
    vec3 acc = vec3(0.0), cover = vec3(0.0), wsum = vec3(0.0);
    for (int i = 0; i < TAPS; i++) {
      float t = float(i) / float(TAPS - 1);
      vec3 w = spectrum(t);
      vec4 s = texture2D(tDiffuse, vUv - off * t);
      acc += s.rgb * w;
      cover += s.a * w;
      wsum += w;
    }
    vec3 col = acc / wsum;
    cover /= wsum;
    // Each channel has its own coverage. The widest one sets the alpha and the
    // channels it leaves uncovered are filled with light, which is what the
    // pale reference stage lends them: the silhouette keeps its warm spectral
    // rim on any page, and the colour stays premultiplied (never above alpha).
    float alpha = max(max(cover.r, cover.g), cover.b);
    col += alpha - cover;

    vec2 hdir = normalize(vec2(c.x * 0.3, c.y) * resolution + 1e-4);
    vec2 hoff = hdir * haze * k / resolution;
    vec3 hc = vec3(0.0);
    float cov = 0.0, wt = 0.0;
    for (int i = 0; i < HAZE_TAPS; i++) {
      float t = (float(i) + 0.5) / float(HAZE_TAPS);
      vec4 s = texture2D(tDiffuse, vUv - hoff * t);
      float w = 1.0 - 0.7 * t;
      float m = smoothstep(0.015, 0.05, s.a) * w;
      hc += s.rgb / max(s.a, 1e-3) * m;
      cov += m;
      wt += w;
    }
    float self = smoothstep(0.015, 0.05, texture2D(tDiffuse, vUv).a);
    if (cov > 0.0) {
      vec3 ghost = hazeTint(hc / cov);
      float a = sqrt(cov / wt) * (1.0 - self) * HAZE_ALPHA * (1.0 - HAZE_LIGHT) * smoothstep(0.25, 0.7, k);
      col += ghost * a * (1.0 - alpha);
      alpha += a * (1.0 - alpha);
    }
    return vec4(col, alpha);
  }

  void main() {
    vec2 c = vUv - centre;
    float ax = abs(c.x) * 2.0 * edgeScale;
    float k = smoothstep(0.34, 1.0, ax);
    k *= k;
    vec2 dir = normalize(c * resolution + 1e-4);
    if (clearStage > 0.5) {
      gl_FragColor = clearPass(c, k, dir);
      return;
    }

    // Thin spectral split: each channel is displaced along dir by a different
    // amount (red furthest).
    vec2 off = dir * strength * k / resolution;
    vec3 acc = vec3(0.0), wsum = vec3(0.0);
    for (int i = 0; i < TAPS; i++) {
      float t = float(i) / float(TAPS - 1);
      vec3 w = spectrum(t);
      acc += texture2D(tDiffuse, vUv - off * t).rgb * w;
      wsum += w;
    }
    vec3 col = acc / wsum;

    // Outer haze: a pale, hue-shifted ghost of the card spilling past its
    // silhouette. The flares open vertically, so the haze spreads mostly away
    // from the horizontal mid-line rather than radially.
    vec2 hdir = normalize(vec2(c.x * 0.3, c.y) * resolution + 1e-4);
    vec2 hoff = hdir * haze * k / resolution;
    vec3 hc = vec3(0.0);
    float cov = 0.0, wt = 0.0;
    for (int i = 0; i < HAZE_TAPS; i++) {
      float t = (float(i) + 0.5) / float(HAZE_TAPS);
      vec3 s = texture2D(tDiffuse, vUv - hoff * t).rgb;
      float w = 1.0 - 0.7 * t;
      float m = isCard(s) * w;
      hc += s * m;
      cov += m;
      wt += w;
    }
    float self = isCard(texture2D(tDiffuse, vUv).rgb);
    if (cov > 0.0) {
      vec3 ghost = hazeTint(hc / cov);
      // Lift toward white on a light stage, toward the stage on a dark one, so
      // the ghost never reads as a glow the reference does not have.
      vec3 lift = dot(bg, vec3(0.299, 0.587, 0.114)) > 0.5 ? vec3(1.0) : bg;
      ghost = mix(ghost, lift, HAZE_LIGHT);
      float a = sqrt(cov / wt) * (1.0 - self) * HAZE_ALPHA * smoothstep(0.25, 0.7, k);
      col = mix(col, ghost, a);
    }
    gl_FragColor = vec4(col, 1.0);
  }
`;

// ---------------------------------------------------------------------------
// Runtime
// ---------------------------------------------------------------------------

const ENGINE_DEFAULTS = {
  cards: [],
  background: 'transparent',
  startIndex: 0,
  settle: 10.5001,
  autoplay: 0,
  wheel: 'both',
  draggable: true,
  fringe: 1,
  haze: 1,
  smear: 1,
  preview: false,
  // Draw past the stage box on a solid stage too. The editor sets it when its
  // panel is painted the stage's colour, so the folded cards are not cut at an
  // edge nobody can see; an export never carries it.
  bleed: false
};

const cardKey = (card) => JSON.stringify([card.src, card.title, card.subtitle, card.tag, card.caption]);

function loadImage(src) {
  return new Promise((resolve) => {
    if (!src) { resolve(null); return; }
    const img = new Image();
    // The picture is uploaded to the GPU, which a browser only allows for an
    // image that is same-origin or sent with a CORS header. Anything that
    // refuses is drawn as a plain face instead of breaking the carousel.
    img.crossOrigin = 'anonymous';
    img.decoding = 'async';
    img.onload = () => resolve(img);
    img.onerror = () => resolve(null);
    img.src = src;
  });
}

function waitForFonts() {
  const fonts = typeof document !== 'undefined' ? document.fonts : null;
  if (!fonts?.load) return Promise.resolve();
  const loads = Promise.all([
    fonts.load(font(41, 420)),
    fonts.load(font(34, 500))
  ]).catch(() => {});
  // A font that never arrives must not hold the cards back.
  return Promise.race([loads, new Promise((resolve) => setTimeout(resolve, 1500))]);
}

function buildFoldCarousel(root, config) {
  if (!root) return null;
  let cfg = { ...ENGINE_DEFAULTS, ...config };
  const reducedMotion = typeof matchMedia === 'function' && matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stage = root.querySelector('.fc-gl') ?? root;
  const live = root.querySelector('.fc-live');

  let disposed = false;
  let scene = null;
  const cleanups = [];
  const listen = (target, type, handler, options) => {
    target.addEventListener(type, handler, options);
    cleanups.push(() => target.removeEventListener(type, handler, options));
  };

  const count = () => Math.max(cfg.cards.length, 1);
  const motion = {
    pos: cfg.startIndex,
    vel: 0,
    target: cfg.startIndex,
    dragging: false
  };

  function announce() {
    if (!live || cfg.preview) return;
    const n = count();
    const index = wrapIndex(Math.round(motion.target), n);
    const card = cfg.cards[index] ?? {};
    const words = [card.title, card.subtitle].filter(Boolean).join(', ');
    live.textContent = `Služba ${index + 1} z ${n}${words ? `: ${words}` : ''}`;
  }

  function go(delta, speak = true) {
    motion.target = Math.round(motion.target) + delta;
    if (speak) announce();
    scene?.invalidate();
  }

  function goTo(index) {
    const n = count();
    // Travel the short way round the loop.
    go(offsetOf(wrapIndex(Math.round(index), n), Math.round(motion.target), n));
  }

  // --- input ---------------------------------------------------------------

  let drag = null;
  listen(root, 'pointerdown', (e) => {
    if (!cfg.draggable || cfg.preview || e.button !== 0) return;
    if (e.target instanceof Element && e.target.closest('button')) return;
    try { root.setPointerCapture(e.pointerId); } catch { /* synthetic events */ }
    const now = performance.now();
    drag = { id: e.pointerId, x: e.clientX, pos: motion.pos, lastX: e.clientX, lastT: now, v: 0 };
    motion.dragging = true;
    motion.vel = 0;
    root.setAttribute('data-dragging', '');
  });
  listen(root, 'pointermove', (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    const now = performance.now();
    const dt = Math.max(now - drag.lastT, 1) / 1000;
    const slot = scene?.slotPx() ?? 380;
    const v = -(e.clientX - drag.lastX) / slot / dt;
    drag.v = drag.v * 0.7 + v * 0.3;
    drag.lastX = e.clientX;
    drag.lastT = now;
    motion.pos = drag.pos - (e.clientX - drag.x) / slot;
    scene?.invalidate();
  });
  const endDrag = (e) => {
    if (!drag || e.pointerId !== drag.id) return;
    // A press that never moved is not a gesture; it must not drop the card
    // somewhere else, and a release long after the last move has no fling.
    const idle = performance.now() - drag.lastT > 120;
    const velocity = idle ? 0 : drag.v;
    motion.target = flingTarget(motion.pos, velocity);
    motion.vel = velocity;
    motion.dragging = false;
    drag = null;
    root.removeAttribute('data-dragging');
    announce();
    scene?.invalidate();
  };
  listen(root, 'pointerup', endDrag);
  listen(root, 'pointercancel', endDrag);
  listen(root, 'lostpointercapture', endDrag);

  let wheelTimer = 0;
  let wheelFrom = null;
  listen(root, 'wheel', (e) => {
    if (cfg.preview || cfg.wheel === 'off') return;
    const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY);
    // Only a sideways wheel belongs to the carousel unless the author opted in
    // to taking over the vertical one too; the page keeps scrolling otherwise.
    if (!horizontal && cfg.wheel !== 'both') return;
    e.preventDefault();
    if (wheelFrom === null) wheelFrom = Math.round(motion.target);
    const unit = e.deltaMode === 1 ? 16 : e.deltaMode === 2 ? window.innerHeight : 1;
    const d = (horizontal ? e.deltaX : e.deltaY) * unit;
    const next = motion.target + d / ((scene?.slotPx() ?? 380) * 1.20001);
    motion.target = Math.max(motion.pos - 1.39999, Math.min(motion.pos + 1.39999, next));
    scene?.invalidate();
    clearTimeout(wheelTimer);
    wheelTimer = setTimeout(() => {
      motion.target = settleWheel(wheelFrom, motion.target);
      wheelFrom = null;
      announce();
      scene?.invalidate();
    }, 140);
  }, { passive: false });
  cleanups.push(() => clearTimeout(wheelTimer));

  listen(root, 'keydown', (e) => {
    if (cfg.preview || e.target !== root) return;
    if (e.key === 'ArrowRight' || e.key === 'Enter' || e.key === ' ') { go(1); e.preventDefault(); }
    else if (e.key === 'ArrowLeft') { go(-1); e.preventDefault(); }
    else if (e.key === 'Home') { goTo(0); e.preventDefault(); }
    else if (e.key === 'End') { goTo(count() - 1); e.preventDefault(); }
  });
  for (const button of root.querySelectorAll('[data-fc-step]')) {
    listen(button, 'click', () => go(Number(button.getAttribute('data-fc-step')) || 0));
  }

  // --- autoplay --------------------------------------------------------------

  let hovered = false;
  let focused = false;
  let onScreen = true;
  let autoTimer = 0;
  listen(root, 'pointerenter', () => { hovered = true; });
  listen(root, 'pointerleave', () => { hovered = false; });
  listen(root, 'focusin', () => { focused = true; });
  listen(root, 'focusout', () => { focused = false; });
  function scheduleAutoplay() {
    clearTimeout(autoTimer);
    const seconds = Number(cfg.autoplay) || 0;
    if (disposed || seconds <= 0 || reducedMotion) return;
    autoTimer = setTimeout(() => {
      // A reader holding the carousel keeps the card they are on.
      if (onScreen && !motion.dragging && !(hovered && !cfg.preview) && !focused) go(1, false);
      scheduleAutoplay();
    }, seconds * 1000);
  }
  cleanups.push(() => clearTimeout(autoTimer));

  const observer = typeof IntersectionObserver === 'function'
    ? new IntersectionObserver((entries) => {
      onScreen = entries.some((entry) => entry.isIntersecting);
      if (onScreen) scene?.invalidate();
    })
    : null;
  observer?.observe(root);
  cleanups.push(() => observer?.disconnect());

  // --- scene ---------------------------------------------------------------

  function fail() {
    if (disposed) return;
    root.setAttribute('data-fc-fallback', '');
  }

  function createScene(THREE) {
    let renderer;
    try {
      renderer = new THREE.WebGLRenderer({ alpha: true, antialias: false, powerPreference: 'high-performance' });
    } catch {
      fail();
      return null;
    }
    // The shaders write display values straight through, so the output is left
    // unconverted rather than switching colour management off for every other
    // three.js scene on the page.
    renderer.outputColorSpace = THREE.LinearSRGBColorSpace;
    const canvas = renderer.domElement;
    canvas.className = 'fc-canvas';
    canvas.setAttribute('aria-hidden', 'true');
    stage.replaceChildren(canvas);

    const world = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(35, 1, 0.05, 200);
    camera.position.set(0, 0, CAMERA_Z);
    const target = new THREE.WebGLRenderTarget(1, 1, { samples: 4, depthBuffer: true });

    const clear = new THREE.Color();
    const bgUniform = new THREE.Vector3();
    const clearStage = { value: 0 };
    function applyBackground() {
      // A transparent stage clears to zero alpha; the post pass then keeps
      // coverage in alpha so the page shows through around the cards.
      const transparent = String(cfg.background ?? '').trim().toLowerCase() === 'transparent';
      const [r, g, b] = transparent ? [0, 0, 0] : parseColor(cfg.background);
      clear.setRGB(r / 255, g / 255, b / 255, THREE.LinearSRGBColorSpace);
      renderer.setClearColor(clear, transparent ? 0 : 1);
      bgUniform.set(r / 255, g / 255, b / 255);
      clearStage.value = transparent ? 1 : 0;
    }
    applyBackground();

    const post = new THREE.Mesh(
      new THREE.BufferGeometry().setAttribute(
        'position',
        new THREE.BufferAttribute(new Float32Array([-1, -1, 0, 3, -1, 0, -1, 3, 0]), 3)
      ),
      new THREE.ShaderMaterial({
        uniforms: {
          tDiffuse: { value: target.texture },
          resolution: { value: new THREE.Vector2(1, 1) },
          strength: { value: 1 },
          haze: { value: 1 },
          edgeScale: { value: 1 },
          centre: { value: new THREE.Vector2(0.500001, 0.499999) },
          bg: { value: bgUniform },
          clearStage
        },
        vertexShader: POST_VERTEX,
        fragmentShader: POST_FRAGMENT,
        depthTest: false,
        depthWrite: false
      })
    );
    post.frustumCulled = false;
    const postScene = new THREE.Scene();
    postScene.add(post);
    const postCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);

    function buildGeometry() {
      const cols = SEGMENTS + 1;
      const g = new THREE.BufferGeometry();
      const uv = new Float32Array(cols * 4);
      const idx = [];
      for (let i = 0; i < cols; i++) {
        const u = i / SEGMENTS;
        uv.set([u, 1, u, 0], i * 4);
        if (i < SEGMENTS) {
          const a = i * 2;
          idx.push(a, a + 1, a + 2, a + 1, a + 3, a + 2);
        }
      }
      g.setAttribute('position', new THREE.BufferAttribute(new Float32Array(cols * 6), 3).setUsage(THREE.DynamicDrawUsage));
      g.setAttribute('uv', new THREE.BufferAttribute(uv, 2));
      g.setAttribute('smear', new THREE.BufferAttribute(new Float32Array(cols * 2), 1).setUsage(THREE.DynamicDrawUsage));
      g.setIndex(idx);
      return g;
    }

    const pt = [0, 0, 0];
    function updateMesh(mesh, s) {
      const g = mesh.geometry;
      const pos = g.attributes.position.array;
      const smear = g.attributes.smear.array;
      const halfH = CARD_H / 2;
      for (let i = 0; i <= SEGMENTS; i++) {
        cardPoint(s, i / SEGMENTS, pt);
        const o = i * 6;
        pos[o] = pt[0]; pos[o + 1] = halfH; pos[o + 2] = pt[1];
        pos[o + 3] = pt[0]; pos[o + 4] = -halfH; pos[o + 5] = pt[1];
        smear[i * 2] = smear[i * 2 + 1] = pt[2];
      }
      g.attributes.position.needsUpdate = true;
      g.attributes.smear.needsUpdate = true;
    }

    // One slot per card: its canvas, texture and mesh live as long as the
    // carousel, and an edit only repaints the faces whose content changed.
    const slots = [];
    const maxAnisotropy = renderer.capabilities.getMaxAnisotropy();
    function makeSlot() {
      const canvas2d = document.createElement('canvas');
      canvas2d.width = TEX_W;
      canvas2d.height = TEX_H;
      const texture = new THREE.CanvasTexture(canvas2d);
      texture.anisotropy = maxAnisotropy;
      texture.minFilter = THREE.LinearMipmapLinearFilter;
      texture.generateMipmaps = true;
      const material = new THREE.ShaderMaterial({
        uniforms: {
          map: { value: texture },
          radius: { value: 0.0360001 },
          smearAmount: { value: 0.0119999 * cfg.smear }
        },
        vertexShader: CARD_VERTEX,
        fragmentShader: CARD_FRAGMENT,
        side: THREE.DoubleSide,
        transparent: true,
        depthWrite: true
      });
      const mesh = new THREE.Mesh(buildGeometry(), material);
      mesh.frustumCulled = false;
      mesh.visible = false;
      world.add(mesh);
      return { canvas: canvas2d, ctx: canvas2d.getContext('2d'), texture, material, mesh, key: null, src: null, image: null, ready: false, token: 0 };
    }
    function disposeSlot(slot) {
      world.remove(slot.mesh);
      slot.mesh.geometry.dispose();
      slot.material.dispose();
      slot.texture.dispose();
    }

    let fontsReady = null;
    function paintSlot(slot, card) {
      const key = cardKey(card);
      if (slot.key === key) return;
      slot.key = key;
      const token = ++slot.token;
      const srcChanged = slot.src !== card.src;
      fontsReady ??= waitForFonts();
      Promise.all([srcChanged ? loadImage(card.src) : Promise.resolve(slot.image), fontsReady]).then(([image]) => {
        if (disposed || token !== slot.token || !slot.ctx) return;
        slot.src = card.src;
        slot.image = image;
        drawCardFace(slot.ctx, card, image);
        // A picture served without CORS taints the canvas, and a tainted
        // canvas cannot be uploaded to the GPU; the face keeps its type on a
        // plain ground instead.
        try { slot.ctx.getImageData(0, 0, 1, 1); } catch { drawCardFace(slot.ctx, card, null); }
        slot.texture.needsUpdate = true;
        slot.ready = true;
        invalidate();
      });
    }

    function syncCards() {
      const cards = cfg.cards;
      while (slots.length < cards.length) slots.push(makeSlot());
      while (slots.length > cards.length) disposeSlot(slots.pop());
      cards.forEach((card, i) => {
        paintSlot(slots[i], card);
        slots[i].material.uniforms.smearAmount.value = 0.0119999 * cfg.smear;
      });
    }
    syncCards();

    let layout = layoutFor(1, 1);
    let dpr = 1;
    let clipBox = null;
    let sizeKey = '';
    let settleFrame = 0;
    const bleeds = () => clearStage.value > 0.499999 || cfg.bleed === true;
    function measureBleed(W, H) {
      if (!bleeds() || !clipBox) return { left: 0, top: 0, right: 0, bottom: 0 };
      const rect = root.getBoundingClientRect();
      const clip = clipBox.getBoundingClientRect();
      // Pixels past the window are never seen.
      const seen = {
        left: Math.max(clip.left, 0),
        top: Math.max(clip.top, 0),
        right: Math.min(clip.right, window.innerWidth),
        bottom: Math.min(clip.bottom, window.innerHeight)
      };
      return bleedFor(rect, seen, rect.width / W, W, H);
    }
    function measure() {
      const W = Math.max(1, root.clientWidth);
      const H = Math.max(1, root.clientHeight);
      const bleed = measureBleed(W, H);
      return { W, H, bleed, key: [W, H, bleed.left, bleed.top, bleed.right, bleed.bottom].join() };
    }
    // A host's fit transform can land a frame after the boxes resize, and a
    // transform never fires a ResizeObserver: re-measure for a few frames and
    // resize again only if the bleed moved.
    function settle(frames = 6) {
      cancelAnimationFrame(settleFrame);
      settleFrame = 0;
      if (!clipBox) return;
      settleFrame = requestAnimationFrame(() => {
        settleFrame = 0;
        if (measure().key !== sizeKey) resize();
        else if (frames > 1) settle(frames - 1);
      });
    }
    function resize() {
      const { W, H, bleed, key } = measure();
      sizeKey = key;
      const CW = W + bleed.left + bleed.right;
      const CH = H + bleed.top + bleed.bottom;
      // The stage keeps the layout; the canvas only reaches past it.
      Object.assign(stage.style, {
        left: `${-bleed.left}px`,
        top: `${-bleed.top}px`,
        right: `${-bleed.right}px`,
        bottom: `${-bleed.bottom}px`
      });
      // A bled canvas spends no more pixels than the bare stage at 2x.
      dpr = Math.min(window.devicePixelRatio || 1, 2, Math.sqrt((4 * W * H) / (CW * CH)));
      renderer.setPixelRatio(dpr);
      renderer.setSize(CW, CH, false);
      layout = layoutFor(W, H);
      camera.aspect = W / H;
      camera.fov = layout.fov;
      camera.setViewOffset(W, H, -bleed.left, layout.offsetY - bleed.top, CW, CH);
      camera.updateProjectionMatrix();
      const bw = Math.round(CW * dpr);
      const bh = Math.round(CH * dpr);
      target.setSize(bw, bh);
      const uniforms = post.material.uniforms;
      uniforms.resolution.value.set(bw, bh);
      // The optics are measured from the stage centre in stage-relative x.
      uniforms.edgeScale.value = layout.edgeScale * (CW / W);
      uniforms.centre.value.set((bleed.left + W / 2) / CW, (bleed.bottom + H / 2) / CH);
      applyOptics();
      invalidate();
      settle();
    }
    const onScroll = () => settle(1);
    function applyOptics() {
      post.material.uniforms.strength.value = layout.fringe * dpr * cfg.fringe;
      post.material.uniforms.haze.value = layout.haze * dpr * cfg.haze;
    }
    const resizeObserver = typeof ResizeObserver === 'function' ? new ResizeObserver(resize) : null;
    resizeObserver?.observe(root);
    // The clipping box can change size (fullscreen, a resized preview) and
    // the editor's fit transform can change without the stage box resizing.
    function watchClipBox() {
      const next = bleeds() ? clipBoxOf(root) : null;
      if (next === clipBox) return;
      if (clipBox) resizeObserver?.unobserve(clipBox);
      clipBox = next;
      if (clipBox) resizeObserver?.observe(clipBox);
    }
    watchClipBox();
    window.addEventListener('resize', resize);
    window.addEventListener('scroll', onScroll, { capture: true, passive: true });

    function render() {
      const n = slots.length;
      for (let i = 0; i < n; i++) {
        const slot = slots[i];
        const s = offsetOf(i, motion.pos, n);
        const visible = slot.ready && Math.abs(s) < VISIBLE_SPAN;
        slot.mesh.visible = visible;
        if (visible) {
          updateMesh(slot.mesh, s);
          // Draw the flat, nearest cards last.
          slot.mesh.renderOrder = -Math.round(Math.abs(s) * 100);
        }
      }
      renderer.setRenderTarget(target);
      renderer.render(world, camera);
      renderer.setRenderTarget(null);
      renderer.render(postScene, postCamera);
    }

    // Frames are drawn only while something moves: a settled carousel costs
    // nothing, and one scrolled out of view stops until it returns.
    let frame = 0;
    let last = 0;
    function tick(now) {
      frame = 0;
      if (disposed) return;
      const dt = last ? Math.min((now - last) / 1000, 0.1) : 1 / 60;
      last = now;
      const omega = reducedMotion ? 22 : cfg.settle;
      if (!motion.dragging) {
        [motion.pos, motion.vel] = springStep(motion.pos, motion.vel, motion.target, dt, omega);
      }
      if (onScreen) render();
      const moving = motion.dragging || motion.pos !== motion.target || motion.vel !== 0;
      if (moving && onScreen) frame = requestAnimationFrame(tick);
      else last = 0;
    }
    function invalidate() {
      if (!frame && !disposed) frame = requestAnimationFrame(tick);
    }

    const lost = (e) => { e.preventDefault(); cancelAnimationFrame(frame); frame = 0; };
    const restored = () => {
      for (const slot of slots) slot.texture.needsUpdate = true;
      invalidate();
    };
    canvas.addEventListener('webglcontextlost', lost);
    canvas.addEventListener('webglcontextrestored', restored);

    resize();
    root.setAttribute('data-fc-ready', '');

    return {
      invalidate,
      slotPx: () => layout.slotPx,
      renderNow: render,
      update() {
        applyBackground();
        watchClipBox();
        resize();
        syncCards();
        invalidate();
      },
      destroy() {
        cancelAnimationFrame(frame);
        cancelAnimationFrame(settleFrame);
        resizeObserver?.disconnect();
        window.removeEventListener('resize', resize);
        window.removeEventListener('scroll', onScroll, { capture: true });
        canvas.removeEventListener('webglcontextlost', lost);
        canvas.removeEventListener('webglcontextrestored', restored);
        slots.forEach(disposeSlot);
        slots.length = 0;
        post.geometry.dispose();
        post.material.dispose();
        target.dispose();
        renderer.dispose();
        // Free the context now rather than whenever the collector gets to it:
        // an editor that rebuilds would otherwise run into the browser's cap.
        renderer.forceContextLoss();
        canvas.remove();
      }
    };
  }

  import('three')
    .then((THREE) => {
      if (disposed) return;
      scene = createScene(THREE);
      if (scene) {
        announce();
        scheduleAutoplay();
      }
    })
    .catch(fail);

  return {
    setConfig(next) {
      if (disposed) return;
      const previousAutoplay = cfg.autoplay;
      cfg = { ...ENGINE_DEFAULTS, ...next };
      if (cfg.autoplay !== previousAutoplay) scheduleAutoplay();
      scene?.update();
    },
    go,
    goTo,
    // Places the strip at an exact position without animating — for captures
    // and for hosts that drive the carousel from their own scroll.
    setPosition(position) {
      if (disposed || !Number.isFinite(position)) return;
      motion.pos = motion.target = position;
      motion.vel = 0;
      scene?.renderNow();
    },
    get position() { return motion.pos; },
    get index() { return wrapIndex(Math.round(motion.target), count()); },
    destroy() {
      disposed = true;
      cleanups.forEach((cleanup) => cleanup());
      cleanups.length = 0;
      scene?.destroy();
      scene = null;
      root.removeAttribute('data-fc-ready');
      root.removeAttribute('data-dragging');
    }
  };
}

