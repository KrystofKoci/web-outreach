<script>
  /* mobilní menu */
  (function () {
    var b = document.querySelector('.menu-tl'), p = document.getElementById('menu-panel');
    b.addEventListener('click', function () { var o = p.classList.toggle('otevreno'); b.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  })();

  /* Hero: přiblížení do dílny podle scrollu. Fotka se roztáhne „cover“ přes okno a skript ji posouvá a zvětšuje tak,
     aby ohnisko (mechanici) dojelo na cílové místo. S omezenými animacemi jede přímo podle scrollu (bez dojezdu);
     ?pohyb=0 nechá statickou dílnu. Jen transform a opacity, v rAF. */
  (function () {
    var html = document.documentElement;
    if (html.classList.contains('bez-zoomu')) return;
    var hero = document.querySelector('.hero'), pin = hero.querySelector('.hero-pin'), img = hero.querySelector('.hero-foto');
    var A = hero.querySelector('.panel-a'), B = hero.querySelector('.panel-b');
    var ohD = (img.getAttribute('data-ohnisko') || '0.5 0.5').split(' ').map(Number);
    var ohM = (img.getAttribute('data-ohnisko-mobil') || img.getAttribute('data-ohnisko') || '0.5 0.5').split(' ').map(Number);
    var FX = ohD[0], FY = ohD[1];
    var plynule = !matchMedia('(prefers-reduced-motion: reduce)').matches;
    var g = null, cil = 0, akt = 0, bezi = false;
    html.classList.add('js-hero');
    function zmer() {
      var vw = pin.clientWidth, vh = pin.clientHeight, ar = (img.naturalWidth || 5400) / (img.naturalHeight || 2725), w, h;
      if (vw / vh > ar) { w = vw; h = vw / ar; } else { h = vh; w = vh * ar; }
      var mobil = vw < 761, oh = mobil ? ohM : ohD;
      FX = oh[0]; FY = oh[1];
      /* desktop: na začátku celá dílna na střed, na konci technik u příjmu a mechanik u červeného auta;
         mobil: začíná u příjmu auta a dojede na mechanika */
      g = { vw: vw, vh: vh, w: w, h: h, Z: mobil ? 1.85 : 2.3, cx: 0.5, cy: mobil ? 0.34 : 0.46,
            x0: mobil ? Math.min(0, Math.max(vw - w, vw * 0.5 - 0.56 * w)) : (vw - w) * 0.5, y0: (vh - h) * 0.5 };
      img.style.width = w + 'px'; img.style.height = h + 'px';
    }
    function prubeh() {
      var r = hero.getBoundingClientRect(), celk = hero.offsetHeight - g.vh;
      return celk > 0 ? Math.min(1, Math.max(0, -r.top / celk)) : 0;
    }
    function hladce(t) { return t < .5 ? 2 * t * t : 1 - Math.pow(-2 * t + 2, 2) / 2; }
    function mez(v) { return Math.min(1, Math.max(0, v)); }
    function vykresli(p) {
      var e = hladce(mez(p / 0.82)), s = 1 + (g.Z - 1) * e;
      var fx0 = FX * g.w + g.x0, fy0 = FY * g.h + g.y0;
      var Tx = fx0 + (g.cx * g.vw - fx0) * e, Ty = fy0 + (g.cy * g.vh - fy0) * e;
      var tx = Tx - FX * g.w * s, ty = Ty - FY * g.h * s;
      tx = Math.min(0, Math.max(g.vw - g.w * s, tx)); ty = Math.min(0, Math.max(g.vh - g.h * s, ty));
      img.style.transform = 'translate3d(' + tx.toFixed(1) + 'px,' + ty.toFixed(1) + 'px,0) scale(' + s.toFixed(4) + ')';
      var a = 1 - mez((p - 0.06) / 0.26), b = mez((p - 0.62) / 0.2);
      A.style.opacity = a; A.style.transform = 'translate3d(0,' + (-24 * (1 - a)).toFixed(1) + 'px,0)';
      A.style.visibility = a < 0.02 ? 'hidden' : 'visible';
      B.style.opacity = b; B.style.transform = 'translate3d(0,' + (18 * (1 - b)).toFixed(1) + 'px,0)';
      B.style.visibility = b < 0.02 ? 'hidden' : 'visible';
      B.setAttribute('aria-hidden', b < 0.5 ? 'true' : 'false');
    }
    function krok() {
      akt += (cil - akt) * 0.14;
      if (Math.abs(cil - akt) < 0.0006) akt = cil;
      vykresli(akt);
      if (akt !== cil) requestAnimationFrame(krok); else bezi = false;
    }
    function scroll() {
      cil = prubeh();
      if (!plynule) { akt = cil; vykresli(akt); return; }
      if (!bezi) { bezi = true; requestAnimationFrame(krok); }
    }
    function start() { zmer(); akt = cil = prubeh(); vykresli(akt); }
    if (img.complete && img.naturalWidth) start(); else { zmer(); vykresli(0); img.addEventListener('load', start); }
    addEventListener('scroll', scroll, { passive: true });
    addEventListener('resize', function () { zmer(); cil = akt = prubeh(); vykresli(akt); });
    /* když fokus klávesnicí skočí do skrytého panelu A při odscrollování, panel je skrytý (visibility) a nefokusovatelný */
  })();

  /* Ceník: vlevo velká fotka služby, na kterou ukazuje myš, fokus nebo která je při scrollu nejblíž středu okna (první je vybraná). */
  (function () {
    var ram = document.querySelector('[data-ram]'), seznam = document.querySelector('ul[data-sluzby="autoservis"]');
    if (!ram || !seznam) return;
    function postav() {
      ram.textContent = '';
      seznam.querySelectorAll('li[data-sluzba]').forEach(function (li, i) {
        var src = li.querySelector('figure img'); if (!src) return;
        var im = document.createElement('img'); im.src = src.getAttribute('src'); im.alt = ''; im.decoding = 'async';
        im.loading = i < 2 ? 'eager' : 'lazy'; im.setAttribute('data-pro', li.getAttribute('data-sluzba'));
        ram.appendChild(im);
      });
      vyber(seznam.querySelector('li[data-sluzba]'));
    }
    function vyber(li) {
      if (!li) return;
      var id = li.getAttribute('data-sluzba');
      seznam.querySelectorAll('li.vybrana').forEach(function (x) { x.classList.remove('vybrana'); });
      li.classList.add('vybrana');
      ram.querySelectorAll('img').forEach(function (im) {
        var ano = im.getAttribute('data-pro') === id; im.classList.toggle('vybrana', ano); if (ano) im.loading = 'eager';
      });
    }
    seznam.addEventListener('pointerover', function (e) { var li = e.target.closest('li[data-sluzba]'); if (li) vyber(li); });
    seznam.addEventListener('focusin', function (e) { var li = e.target.closest('li[data-sluzba]'); if (li) vyber(li); });
    postav();
    if ('MutationObserver' in window) new MutationObserver(postav).observe(seznam, { childList: true });
    /* při scrollu se vybere služba nejblíž středu okna (kdo jen scrolluje, vidí fotku každé služby) */
    var ceka = false;
    function podleScrollu() {
      ceka = false;
      if (getComputedStyle(ram).display === 'none') return;
      var stred = innerHeight * 0.5, nej = null, min = 1e9;
      seznam.querySelectorAll('li[data-sluzba]').forEach(function (li) {
        var r = li.getBoundingClientRect(); if (r.bottom < 0 || r.top > innerHeight) return;
        var d = Math.abs((r.top + r.bottom) / 2 - stred); if (d < min) { min = d; nej = li; }
      });
      if (nej && !nej.classList.contains('vybrana')) vyber(nej);
    }
    addEventListener('scroll', function () { if (!ceka) { ceka = true; requestAnimationFrame(podleScrollu); } }, { passive: true });
  })();

  /* Objednávka servisu: logika jako V10 (služby z bloku služeb, typ podle druhu, kontrola polí, fokus na první chybu)
     + pobočka (povinná), den (nepovinný, ne v minulosti), čas přistavení. Odkazy „Objednat“ u služeb a poboček předvyplní výběr.
     Nic se neodesílá (ukázka šablony). */
  (function () {
    var f = document.querySelector('[data-formular="objednavka"]'); if (!f) return;
    var hl = document.getElementById('obj-hlaska');
    var typSel = document.getElementById('f-typ'), typTxt = document.getElementById('f-typ-jine'), typLabel = document.getElementById('l-typ');
    var rok = document.getElementById('f-rok'), ROK_MIN = 1950, ROK_MAX = new Date().getFullYear();
    var zprava = document.getElementById('f-zprava'), fsSluzby = document.getElementById('f-sluzby'), volby = f.querySelector('[data-sluzby-volby]');
    var seznam = document.querySelector('ul[data-sluzby="autoservis"]');
    /* počet poboček (html[data-pobocky]): odebrat karty a volby navíc; při 1 dílně se pobočka ve formuláři neposílá */
    var POBOCEK = +document.documentElement.getAttribute('data-pobocky') || 3;
    document.querySelectorAll('.pobocka[data-pobocka], #f-pobocka option[data-pobocka]').forEach(function (el) {
      if (+el.getAttribute('data-pobocka') > POBOCEK) el.remove();
    });
    if (POBOCEK === 1) { var pp = document.getElementById('pole-pobocka'); if (pp) pp.remove(); }
    var den = document.getElementById('f-den'), pob = document.getElementById('f-pobocka');
    var dnes = new Date(); dnes.setMinutes(dnes.getMinutes() - dnes.getTimezoneOffset());
    var DNES = dnes.toISOString().slice(0, 10); den.min = DNES;
    var TYPY = { auto: ['Passenger car', 'SUV', 'Kombi', 'Van'], motorka: ['Road bike', 'Enduro / cross', 'Scooter', 'Quad'] };
    document.getElementById('e-rok').textContent = 'Enter the year as four digits, from ' + ROK_MIN + ' do ' + ROK_MAX + '.';

    function nactiSluzby() {
      var byly = {};
      volby.querySelectorAll('input:checked').forEach(function (i) { byly[i.getAttribute('data-id')] = true; });
      volby.textContent = '';
      var polozky = seznam ? seznam.querySelectorAll('li[data-sluzba]') : [];
      Array.prototype.forEach.call(polozky, function (li) {
        var id = li.getAttribute('data-sluzba'), h = li.querySelector('h3');
        var nazev = (h ? h.textContent : id).replace(/[ \t\n\r]+/g, ' ').trim();
        var lab = document.createElement('label'); lab.className = 'zaskrt';
        var inp = document.createElement('input');
        inp.type = 'checkbox'; inp.className = 'sr-only'; inp.name = 'sluzby[]'; inp.id = 'f-sl-' + id;
        inp.value = nazev.replace(/\s+/g, ' '); inp.setAttribute('data-id', id); inp.checked = !!byly[id];
        var pl = document.createElement('span'); pl.className = 'zaskrt-plocha';
        var box = document.createElement('span'); box.className = 'box'; box.setAttribute('aria-hidden', 'true');
        pl.appendChild(box); pl.appendChild(document.createTextNode(nazev));
        lab.appendChild(inp); lab.appendChild(pl); volby.appendChild(lab);
      });
      fsSluzby.hidden = !polozky.length;
      if (!document.getElementById('e-sluzby').hidden) over('sluzby');
    }
    nactiSluzby();
    if (seznam && 'MutationObserver' in window) new MutationObserver(nactiSluzby).observe(seznam, { childList: true, subtree: true, characterData: true });

    function nastavTyp(druh) {
      var jine = druh === 'jine';
      typSel.parentNode.hidden = jine; typSel.disabled = jine || !druh;
      typTxt.hidden = !jine; typTxt.disabled = !jine;
      typLabel.htmlFor = jine ? 'f-typ-jine' : 'f-typ';
      if (jine) return;
      typSel.textContent = '';
      var prvni = document.createElement('option'); prvni.value = '';
      prvni.textContent = druh ? 'Choose…' : 'Choose the vehicle kind first'; typSel.appendChild(prvni);
      (TYPY[druh] || []).forEach(function (t) { var o = document.createElement('option'); o.value = t; o.textContent = t; typSel.appendChild(o); });
    }
    var vybrany = f.querySelector('input[name="druh"]:checked');
    if (vybrany) nastavTyp(vybrany.value);

    /* předvyplnění z odkazů „Objednat“ (služba) a „Objednat na tuto pobočku“ */
    document.addEventListener('click', function (e) {
      var a = e.target.closest('[data-objednat], [data-na-pobocku]'); if (!a) return;
      if (a.hasAttribute('data-objednat')) { var i = document.getElementById('f-sl-' + a.getAttribute('data-objednat')); if (i) i.checked = true; }
      if (a.hasAttribute('data-na-pobocku') && pob) { var o = pob.querySelector('option[data-pobocka="' + a.getAttribute('data-na-pobocku') + '"]'); if (o) pob.value = o.value; }
    });

    var radia = function () { return Array.prototype.slice.call(f.querySelectorAll('input[name="druh"]')); };
    var zaskrt = function () { return Array.prototype.slice.call(volby.querySelectorAll('input')); };
    var pole = function (id) { return function () { return [document.getElementById(id)]; }; };
    var hodnota = function (id) { return document.getElementById(id).value.trim(); };
    var PRAVIDLA = {
      jmeno:   { cile: pole('f-jmeno'),   spatne: function () { return !hodnota('f-jmeno'); } },
      telefon: { cile: pole('f-telefon'), spatne: function () { return hodnota('f-telefon').replace(/\D/g, '').length < 9; } },
      email:   { cile: pole('f-email'),   spatne: function () { var v = hodnota('f-email'); return !!v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v); } },
      druh:    { cile: radia, skupina: 'f-druh', spatne: function () { return !f.querySelector('input[name="druh"]:checked'); } },
      znacka:  { cile: pole('f-znacka'),  spatne: function () { return !hodnota('f-znacka'); } },
      model:   { cile: pole('f-model'),   spatne: function () { return !hodnota('f-model'); } },
      rok:     { cile: pole('f-rok'),     spatne: function () { var v = hodnota('f-rok'); if (!v) return false; var n = +v; return !/^\d{4}$/.test(v) || n < ROK_MIN || n > ROK_MAX; } },
      sluzby:  { cile: function () { return zaskrt().concat([zprava]); }, skupina: 'f-sluzby', spatne: function () { return !volby.querySelector('input:checked') && !zprava.value.trim(); } },
      pobocka: { cile: function () { return pob ? [pob] : []; }, spatne: function () { return !!pob && !pob.value; } },
      den:     { cile: pole('f-den'),     spatne: function () { var v = den.value; return !!v && v < DNES; } }
    };
    function oznac(klic, ano) {
      var p = PRAVIDLA[klic], idChyby = 'e-' + klic;
      var elChyby = document.getElementById(idChyby); if (elChyby) elChyby.hidden = !ano;
      if (p.skupina) document.getElementById(p.skupina).classList.toggle('je-chyba', ano);
      p.cile().forEach(function (el) {
        var d = (el.getAttribute('aria-describedby') || '').split(' ').filter(function (x) { return x && x !== idChyby; });
        if (ano) d.push(idChyby);
        if (d.length) el.setAttribute('aria-describedby', d.join(' ')); else el.removeAttribute('aria-describedby');
        if (ano) el.setAttribute('aria-invalid', 'true'); else el.removeAttribute('aria-invalid');
      });
    }
    function over(klic) { var s = PRAVIDLA[klic].spatne(); oznac(klic, s); return s; }

    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var prvni = null;
      Object.keys(PRAVIDLA).forEach(function (k) {
        if (over(k) && !prvni) prvni = PRAVIDLA[k].cile().filter(function (el) { return !el.closest('[hidden]'); })[0];
      });
      if (prvni) {
        hl.classList.remove('ukazka'); hl.classList.add('chybi');
        hl.textContent = 'Please check the highlighted fields.';
        prvni.focus(); return;
      }
      hl.classList.remove('chybi'); hl.classList.add('ukazka');
      hl.textContent = 'Thank you, we’ll get back to you soon.';
    });
    function klicPole(el) {
      if (el.name === 'druh') return 'druh';
      if (el.name === 'sluzby[]' || el === zprava) return 'sluzby';
      return el.name in PRAVIDLA ? el.name : null;
    }
    function znovu(e) {
      var k = klicPole(e.target);
      if (k && !document.getElementById('e-' + k).hidden) over(k);
    }
    rok.addEventListener('input', function () { var c = rok.value.replace(/\D/g, '').slice(0, 4); if (c !== rok.value) rok.value = c; });
    f.addEventListener('input', znovu);
    f.addEventListener('change', function (e) {
      if (e.target.name === 'druh') nastavTyp(e.target.value);
      znovu(e);
    });
  })();

  /* Hodnocení Google: pod 50 recenzí jen známka, od 50 i počet. Prázdné hodnoty nechají [doplnit]. */
  (function () { var z = document.querySelector('[data-znamka]'); if (!z) return;
    var hod = parseFloat((z.dataset.hodnota || '').replace(',', '.')), poc = parseInt(z.dataset.pocet, 10);
    if (!isNaN(hod)) { z.style.setProperty('--hodnota', hod); var c = z.querySelector('[data-znamka-cislo]'); c.textContent = hod.toLocaleString('en-US'); c.className = '';
      z.querySelector('.hvezdy').setAttribute('aria-label', 'Rating ' + hod.toLocaleString('en-US') + ' z 5'); }
    var p = z.querySelector('[data-znamka-pocet]');
    if (!isNaN(poc)) { if (poc < 50) p.hidden = true; else p.textContent = poc + ' reviews'; } })();
</script>
