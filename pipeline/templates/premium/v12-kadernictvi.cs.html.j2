        x.setAttribute('aria-invalid', ok ? 'false' : 'true'); if (!ok && !prvni) prvni = x;
      });
      if (prvni) {
        var n = f.querySelector('label[for="' + prvni.id + '"]').textContent.replace('*', '').trim();
