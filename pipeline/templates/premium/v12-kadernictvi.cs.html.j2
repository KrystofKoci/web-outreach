<script>
  /* Podpisový pohyb V12: otočný oblouk. 16 karet (8 účesů dvakrát) leží na obvodu kruhu po kroku K stupňů;
     úhel karty = ((i·K − o) mod 16K) − 8K, takže přeskok na druhý konec proběhne mimo obraz (pod hero).
     Otočení o = ruční posun (tažení, šipky, fokus) + scroll (stupně za pixel) + samovolný posun (jen když běží pohyb).
     Tažení má setrvačnost; najetí myší zastaví samovolný posun a ukáže název. Jen transform/opacity, rAF.
     Omezené animace: tažení, scroll a šipky fungují, samovolný posun ne. ?pohyb=0: oblouk stojí, šipky a fokus fungují. */
  (function () {
    var hero = document.querySelector('.hero'), oblouk = hero.querySelector('.oblouk'), stred = oblouk.querySelector('.stred');
    var karty = Array.prototype.slice.call(stred.querySelectorAll('.karta'));
    var popisek = hero.querySelector('.popisek'), cislo = hero.querySelector('.pocitadlo .cislo'), nazevEl = hero.querySelector('.pocitadlo .nazev');
    var NAZVY = { 1: 'Dlouhý balayage', 2: 'Popelavé vlny', 3: 'Kaštanové mikádo', 4: 'Volný drdol', 5: 'Mikádo s ofinou', 6: 'Přírodní kudrny', 7: 'Rovné mikádo', 8: 'Spletené prameny' };
    var qs = new URLSearchParams(location.search), vypnuto = qs.get('pohyb') === '0';
    var omezene = matchMedia('(prefers-reduced-motion: reduce)').matches;
    var samo = !vypnuto && !omezene;
    var N = karty.length, K = 13, R = 1100, kw = 200;
    var rucni = 0, cilRucni = 0, v = 0, auto = 0, scrollF = 0.045, mys = null, fokus = null, tah = null, bezi = false, cas = 0, posledni = -1;
    karty.forEach(function (k) { if (!k.hasAttribute('aria-hidden')) k.tabIndex = 0; });

    function mer() {
      var W = hero.clientWidth, H = hero.offsetHeight, text = hero.querySelector('.text');
      kw = karty[0].offsetWidth; var kh = kw * 4 / 3;
      var mobil = W <= 860;
      R = mobil ? Math.max(440, W * 1.25) : Math.max(900, W * 0.8);
      K = (kw + (mobil ? 14 : 26)) / R * 180 / Math.PI;     /* krok: šířka karty + mezera na obvodu */
      var vrchol = text.offsetTop + text.offsetHeight + (mobil ? 56 : 48) + kh / 2;   /* střed karty na vrcholu oblouku */
      var cy = vrchol + R;
      oblouk.style.setProperty('--R', R.toFixed(1) + 'px');
      oblouk.style.setProperty('--cy', cy.toFixed(1) + 'px');
      oblouk.style.setProperty('--vrchol', (vrchol - kh / 2).toFixed(1) + 'px');
      scrollF = mobil ? 0.07 : 0.045;
    }
    function uhel(i, o) {
      var cel = N * K, a = ((i * K - o) % cel + cel) % cel;
      return a - cel / 2;
    }
    function otoceni() { return rucni + auto + (vypnuto ? 0 : window.scrollY * scrollF) + N / 2 * K; }   /* +N/2·K: nahoře začíná 1. karta */
    function kresli(o) {
      var nej = null, nejA = 1e9;
      karty.forEach(function (k) {
        var i = +k.dataset.i, a = uhel(i, o) + 0;
        var zved = (k === mys || k === fokus) ? 18 : 0;
        k.style.transform = 'rotate(' + a.toFixed(3) + 'deg) translate3d(0,' + (-(R + zved)).toFixed(1) + 'px,0)';
        k.style.opacity = Math.abs(a) > N * K / 2 - K * 0.6 ? '0' : '1';
        if (Math.abs(a) < nejA) { nejA = Math.abs(a); nej = k; }
      });
      var u = +nej.dataset.u;
      if (u !== posledni) { posledni = u; cislo.textContent = '0' + u + ' / 08'; nazevEl.textContent = NAZVY[u]; }
      var ukaz = mys || fokus;
      if (ukaz) {
        var r = ukaz.getBoundingClientRect(), h = hero.getBoundingClientRect();
        popisek.textContent = NAZVY[ukaz.dataset.u];
        var sirka = popisek.offsetWidth, x = Math.max(12, Math.min(h.width - sirka - 12, r.left + r.width / 2 - h.left - sirka / 2));
        var y = Math.max(r.top - h.top - 44, 72);
        popisek.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0)';
        popisek.classList.add('videt');
      } else popisek.classList.remove('videt');
    }
    function krok(t) {
      bezi = false;
      var dt = cas ? Math.min(0.05, (t - cas) / 1000) : 0.016; cas = t;
      var hybe = false;
      if (!tah) {
        if (Math.abs(v) > 0.01) { cilRucni += v * dt; v *= Math.pow(0.05, dt); hybe = true; } else v = 0;
      }
      var d = cilRucni - rucni; rucni += d * Math.min(1, dt * (tah ? 30 : 7)); if (Math.abs(d) > 0.002) hybe = true; else rucni = cilRucni;
      if (samo && !mys && !fokus && !tah && viditelne && !document.hidden && t - klidOd < 20000) { auto += dt * 1.6; hybe = true; }
      kresli(otoceni());
      if (hybe) pozadej(); else cas = 0;
    }
    function pozadej() { if (!bezi) { bezi = true; requestAnimationFrame(krok); } }
    var viditelne = true, klidOd = performance.now();
    /* samovolný posun: běží jen 20 s od poslední interakce a ne ve skryté záložce (šetří rAF) */
    function probud() { klidOd = performance.now(); pozadej(); }
    ['pointermove', 'pointerdown', 'keydown', 'wheel', 'touchstart'].forEach(function (u) { window.addEventListener(u, probud, { passive: true }); });
    window.addEventListener('scroll', function () { klidOd = performance.now(); }, { passive: true });
    document.addEventListener('visibilitychange', function () { cas = 0; if (!document.hidden) probud(); });
    if ('IntersectionObserver' in window) new IntersectionObserver(function (z) { viditelne = z[0].isIntersecting; cas = 0; pozadej(); }).observe(hero);

    /* tažení (myš i prst): vodorovný posun → stupně */
    oblouk.addEventListener('pointerdown', function (e) {
      if (!e.target.closest('.karta')) return;
      tah = { x: e.clientX, y: e.clientY, o: cilRucni, t: performance.now(), px: e.clientX, svisle: null };
      v = 0;
    });
    window.addEventListener('pointermove', function (e) {
      if (!tah) return;
      var dx = e.clientX - tah.x, dy = e.clientY - tah.y;
      if (tah.svisle === null && (Math.abs(dx) > 6 || Math.abs(dy) > 6)) { tah.svisle = Math.abs(dy) > Math.abs(dx); if (!tah.svisle) hero.classList.add('tazeni'); }
      if (tah.svisle) return;
      var stupne = dx / R * 180 / Math.PI * 1.4;
      cilRucni = tah.o - stupne;
      var now = performance.now(), ddt = Math.max(8, now - tah.t);
      v = -((e.clientX - tah.px) / R * 180 / Math.PI * 1.4) / ddt * 1000 * 0.6 + v * 0.4;
      tah.px = e.clientX; tah.t = now; pozadej();
    });
    function konec() { if (!tah) return; if (tah.svisle) v = 0; tah = null; hero.classList.remove('tazeni'); pozadej(); }
    window.addEventListener('pointerup', konec); window.addEventListener('pointercancel', konec);

    karty.forEach(function (k) {
      k.addEventListener('pointerenter', function (e) { if (e.pointerType === 'touch') return; mys = k; pozadej(); });
      k.addEventListener('pointerleave', function () { if (mys === k) { mys = null; pozadej(); } });
      k.addEventListener('focus', function () {
        fokus = k;
        /* dojeď tak, aby karta stála nahoře (úhel 0) */
        var a = uhel(+k.dataset.i, otoceni()); cilRucni += a; v = 0; pozadej();
      });
      k.addEventListener('blur', function () { if (fokus === k) { fokus = null; pozadej(); } });
    });
    function o1(smer) { cilRucni += smer * K; v = 0; pozadej(); }
    hero.querySelector('.ovladani .dal').addEventListener('click', function () { o1(1); });
    hero.querySelector('.ovladani .pred').addEventListener('click', function () { o1(-1); });
    oblouk.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') { e.preventDefault(); o1(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); o1(-1); }
    });
    if (!vypnuto) window.addEventListener('scroll', pozadej, { passive: true });
    window.addEventListener('resize', function () { mer(); pozadej(); });
    if (document.fonts) document.fonts.ready.then(function () { mer(); pozadej(); });
    mer(); kresli(otoceni()); pozadej();
    window.V12k = { stav: function () { return { rucni: rucni, auto: auto, o: otoceni(), K: K, R: R }; }, nastavAuto: function (x) { auto = x; pozadej(); } };
  })();
</script>
