<!DOCTYPE html>

<html data-tema="tmava" lang="cs">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<script>
  /* stránka má jen tmavou verzi (data-tema="tmava" pevně v <html>) */
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0')h.classList.add('pohyb');})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V04 Celoplošná atmosféra – elektrikář Fáze (kolo 4: jen tmavá verze).
     Hero: rodinný dům za soumraku přes celou plochu v paspartu. Podpisový pohyb „nahození proudu“: po načtení
     zablikají a rozsvítí se venkovní světla (lampy u vchodu a lampa u cesty), o chvilku později okna.
     Vypínač vpravo dole zhasne / rozsvítí kdykoli (funguje i s omezenými animacemi, jen bez blikání).
     Pod službami dotazník, pod ním „Rady a tipy“ (4 články, plný text v HTML, rozbalení tlačítkem), na konci kontakty (telefon, WhatsApp, e-mail) a patička. */
  :root {
    --pozadi:#090B12; --plocha:#11141D; --plocha-2:#171B26; --text:#ECEBE5; --tlumeny:#A3A5AE; --linka:rgba(236,235,229,.13); --linka-pole:rgba(236,235,229,.42);
    --kobalt:#6E8FFF; --akcent:#F9B318; --na-akcentu:#15161A; --stopa:#7A5A1A;
    --cteni:#D3D4D9;
    --ram-okraj: 22px; --ram-radius: 14px;
    --zare-ram: 0 0 0 1px rgba(255,200,110,.16), 0 10px 120px -10px rgba(249,179,24,.36), 0 0 40px -6px rgba(255,190,90,.26);
    --na-foto:#F4F2EC; --na-foto-tl:rgba(244,242,236,.8); --fokus-foto:#F4F2EC;
    --ram-pozadi: #07080B;
    --ram-zavoj: linear-gradient(0deg, rgba(5,6,10,.8) 0%, rgba(5,6,10,.3) 30%, rgba(5,6,10,0) 48%), linear-gradient(90deg, rgba(5,6,10,.5), rgba(5,6,10,0) 42%);
    color-scheme: dark;
  }
  body { background: var(--pozadi); color: var(--text); font-family: "Archivo", system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; }
  .doplnit { color: var(--tlumeny); }

  /* ---------- lišta ---------- */
  .lista { position: relative; z-index: 20; height: 74px; display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 calc(var(--ram-okraj) + 14px); }
  .logo { display: inline-flex; align-items: center; gap: 10px; font-weight: 700; font-size: 21px; letter-spacing: -.03em; }
  .logo svg { width: 26px; height: 14px; color: var(--kobalt); }
  .vpravo { display: flex; align-items: center; gap: 28px; }
  .lista nav ul { display: flex; gap: 26px; font-size: 14.5px; }
  .lista nav a { color: var(--tlumeny); } .lista nav a:hover { color: var(--text); }
  /* telefon výrazně: žlutá pilulka, vidět i na mobilu */
  .tel { display: inline-flex; align-items: center; gap: 10px; height: 46px; padding: 0 20px 0 16px; border-radius: 999px; background: var(--akcent); color: var(--na-akcentu); font-weight: 600; font-size: 15.5px; white-space: nowrap; }
  .tel .doplnit { color: inherit; font-weight: 500; }
  .tel:hover { background: #FFC63F; }
  .tel:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; }
  .tel svg { width: 16px; height: 16px; flex: none; }
  .menu-tl { display: none; height: 46px; padding: 0 16px; border-radius: 999px; border: 1px solid var(--linka-pole); align-items: center; gap: 8px; font-size: 14px; }
  .menu-tl i { display: block; width: 16px; height: 1px; background: currentColor; box-shadow: 0 5px 0 currentColor; transform: translateY(-2.5px); }
  .menu-panel { position: absolute; top: 66px; right: 12px; left: 12px; z-index: 40; flex-direction: column; gap: 2px; padding: 8px; border-radius: 20px; background: var(--plocha); border: 1px solid var(--linka); box-shadow: 0 24px 50px -28px rgba(0,0,0,.6); }
  .menu-panel:not([hidden]) { display: flex; }
  .menu-panel a { padding: 13px 16px; border-radius: 12px; font-size: 16px; }

  /* ---------- hero: obraz v paspartu ---------- */
  .hero { position: relative; padding: 0 var(--ram-okraj) var(--ram-okraj); }
  .ram { position: relative; height: max(calc(100svh - 74px - var(--ram-okraj)), 600px); border-radius: var(--ram-radius); overflow: hidden; isolation: isolate;
    container-type: size; background: var(--ram-pozadi); box-shadow: var(--zare-ram); transition: box-shadow .8s; --stopa-z: 4; }
  .hero:not(.zapnuto) .ram { box-shadow: 0 0 0 1px rgba(236,235,229,.06); }
  /* plátno 3 : 2 vždy pokrývá rám (jako object-fit: cover), světla v něm sedí v procentech */
  .platno { position: absolute; z-index: 0; --w: max(100cqw, 150cqh); --h: max(100cqh, 66.667cqw);
    width: var(--w); height: var(--h); left: clamp(100cqw - var(--w), 50cqw - var(--fx, .5) * var(--w), 0px); top: clamp(100cqh - var(--h), 50cqh - var(--fy, .56) * var(--h), 0px); }
  .platno img { position: absolute; inset: 0; width: 100%; height: 100%; }
  /* vrstvy světla: venkovní světla a okna; každá má svou fotku (výřez rozsvíceného stavu s alfou) a záři */
  .vrstva { position: absolute; inset: 0; opacity: 0; transition: opacity .35s; pointer-events: none; }
  .hero.zapnuto .vrstva { opacity: 1; }
  .vrstva.blik { transition: none; }
  .zare { position: absolute; border-radius: 50%; transform: translate(-50%, -50%); mix-blend-mode: screen; pointer-events: none; }
  .z-lampa { width: 7%; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(255,236,190,.75), rgba(255,200,110,.28) 45%, rgba(249,179,24,0)); }
  .z-cesta { width: 6%; aspect-ratio: 1; background: radial-gradient(closest-side, rgba(255,250,235,.7), rgba(220,225,255,.18) 50%, rgba(220,225,255,0)); }
  .z-okno { width: 9%; aspect-ratio: 1.3; background: radial-gradient(closest-side, rgba(255,200,120,.22), rgba(255,190,100,0)); }
  .z-zem { left: 43%; top: 72%; width: 40%; aspect-ratio: 2.6; background: radial-gradient(closest-side, rgba(255,190,100,.16), rgba(255,190,100,0)); }
  .lista::after { content: ""; position: absolute; left: 20%; right: 20%; bottom: -60px; height: 80px; border-radius: 50%; pointer-events: none;
    background: radial-gradient(closest-side, rgba(249,179,24,.09), transparent); opacity: 0; transition: opacity .8s; }
  body:has(.hero.zapnuto) .lista::after { opacity: 1; }
  .ram::after { content: ""; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: var(--ram-zavoj); }
  /* ?pohyb=0 (i bez omezení animací v systému): žádné přechody světla, statický konečný stav hned */
  html:not(.pohyb) .vrstva, html:not(.pohyb) .ram, html:not(.pohyb) .lista::after { transition: none; }

  .roh { position: absolute; z-index: 5; color: var(--na-foto-tl); }
  .roh-lh { left: clamp(20px, 2.6vw, 40px); top: clamp(20px, 3svh, 32px); display: flex; gap: 18px; }
  .roh-ph { right: clamp(20px, 2.6vw, 40px); top: clamp(20px, 3svh, 32px); text-align: right; }
  .roh .doplnit { color: var(--na-foto); }

  .text { position: absolute; z-index: 5; left: clamp(20px, 2.6vw, 40px); bottom: clamp(22px, 4svh, 40px); max-width: 520px; color: var(--na-foto); }
  .hero h1 { font-weight: 500; font-size: clamp(2.1rem, 3.3vw, 3.4rem); line-height: 1.04; letter-spacing: -.035em; }
  .hero h1 .tl { color: var(--na-foto-tl); font-weight: 400; }
  .text p { margin-top: 16px; max-width: 30em; color: var(--na-foto-tl); font-size: 16px; }
  .cta { margin-top: 24px; height: 54px; display: inline-flex; align-items: center; padding: 0 7px 0 24px; border-radius: 999px; background: var(--akcent); color: var(--na-akcentu); font-weight: 600; font-size: 15.5px; --fokus: var(--fokus-foto); }
  .cta [data-magnet-vnitrek] { align-items: center; gap: 16px; }
  .cta .kruh { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: rgba(21,22,26,.1); }
  .cta svg { width: 16px; height: 16px; }

  /* vypínač: skutečný přepínač světla */
  .vypinac { position: absolute; z-index: 6; right: clamp(20px, 2.6vw, 40px); bottom: clamp(22px, 4svh, 40px); display: flex; align-items: center; gap: 16px; color: var(--na-foto); border-radius: 16px; }
  .vypinac:focus-visible { outline: 2px solid var(--fokus-foto); outline-offset: 4px; }
  .vypinac .stav { text-align: right; line-height: 1.6; }
  .vypinac .stav b { display: block; font-family: "Archivo", sans-serif; font-weight: 500; font-size: 15px; letter-spacing: -.01em; text-transform: none; }
  .vypinac .stav span { color: var(--na-foto-tl); }
  .ramecek { width: 68px; height: 96px; border-radius: 12px; background: linear-gradient(160deg, #F2EFE8, #D9D5CB); box-shadow: 0 1px 0 rgba(255,255,255,.6) inset, 0 18px 30px -12px rgba(0,0,0,.7); display: grid; place-items: center; }
  .kolebka { width: 42px; height: 66px; border-radius: 8px; position: relative; overflow: hidden;
    background: linear-gradient(180deg, #E6E2D9 0%, #F7F5EF 48%, #CFCBC1 52%, #E9E6DF 100%); box-shadow: 0 0 0 1px rgba(0,0,0,.12), 0 4px 8px -2px rgba(0,0,0,.35) inset; transition: background .25s; }
  .hero.zapnuto .kolebka { background: linear-gradient(180deg, #CFCBC1 0%, #E9E6DF 48%, #F7F5EF 52%, #E6E2D9 100%); box-shadow: 0 0 0 1px rgba(0,0,0,.12), 0 -4px 8px -2px rgba(0,0,0,.35) inset; }
  .kolebka::after { content: ""; position: absolute; left: 50%; top: 11px; width: 8px; height: 8px; margin-left: -4px; border-radius: 50%; background: #9E9A92; transition: background .3s, box-shadow .3s; }
  .hero.zapnuto .kolebka::after { background: var(--akcent); box-shadow: 0 0 10px 2px rgba(249,179,24,.7); }

  /* ---------- sekce ---------- */
  .sekce { padding: clamp(80px, 9vw, 130px) calc(var(--ram-okraj) + 14px) 0; max-width: 1380px; margin: 0 auto; }
  .sekce-hlava { display: flex; justify-content: space-between; align-items: end; gap: 30px; flex-wrap: wrap; margin-bottom: clamp(28px, 4vw, 50px); }
  .sekce h2 { font-weight: 600; font-size: clamp(2rem, 3.2vw, 3rem); line-height: 1.05; letter-spacing: -.035em; }
  .sekce-hlava p { color: var(--tlumeny); max-width: 30em; }

  /* služby (vyměnitelný blok data-sluzby) */
  .radky { border-top: 1px solid var(--text); }
  .radky li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr); gap: 24px; align-items: baseline; padding: 24px 0 26px; border-bottom: 1px solid var(--linka); }
  .radky h3 { font-weight: 500; font-size: clamp(1.3rem, 1.8vw, 1.6rem); letter-spacing: -.025em; }
  .radky p { color: var(--tlumeny); max-width: 36em; }
  .radky .cena { justify-self: end; color: var(--tlumeny); font-size: 14.5px; }

  /* dotazník */
  .dotaz-mriz { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(30px, 5vw, 80px); align-items: start; }
  .dotaz-mriz .sekce-hlava { display: block; margin: 0; }
  .dotaz-mriz .sekce-hlava p { margin-top: 18px; }
  .formular { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; padding: clamp(20px, 2.4vw, 32px); border-radius: 22px; background: var(--plocha); border: 1px solid var(--linka); }
  .pole { display: flex; flex-direction: column; gap: 8px; }
  .pole.cela { grid-column: 1 / -1; }
  .pole label { font-size: 14.5px; font-weight: 500; }
  .pole label small { font-weight: 400; color: var(--tlumeny); font-size: 13.5px; }
  .pole input, .pole textarea { font: inherit; color: var(--text); background: var(--pozadi); border: 1px solid var(--linka-pole); border-radius: 14px; padding: 13px 16px; min-height: 50px; width: 100%; }
  .pole textarea { min-height: 150px; resize: vertical; line-height: 1.5; }
  .pole input::placeholder, .pole textarea::placeholder { color: #7D808A; }
  .pole input:focus-visible, .pole textarea:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-radius: 14px; }
  .pole [aria-invalid="true"] { border-color: var(--akcent); }
  .chyba { font-size: 13.5px; color: var(--text); display: flex; gap: 8px; align-items: center; }
  .chyba::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--akcent); flex: none; }
  .chyba[hidden] { display: none; }
  .odeslat { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; margin-top: 4px; }
  .odeslat .cta { margin: 0; border: 0; cursor: pointer; --fokus: var(--text); }
  .hlaska { color: var(--tlumeny); font-size: 14.5px; max-width: 26em; }
  .hlaska.ukazka { color: var(--text); }

  /* kontakty a patička */
  .kontakt { padding-bottom: 0; }
  .kontakty { border-top: 1px solid var(--text); }
  .kontakty li { border-bottom: 1px solid var(--linka); }
  .kontakty a { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto; gap: 24px; align-items: center; padding: 26px 0; }
  .kontakty .druh { color: var(--tlumeny); }
  .kontakty .udaj { font-weight: 500; font-size: clamp(1.5rem, 2.6vw, 2.4rem); letter-spacing: -.03em; line-height: 1.1; overflow-wrap: anywhere; }
  .kontakty .udaj .doplnit { color: var(--text); }
  .kontakty .sipka { width: 46px; height: 46px; border-radius: 50%; display: grid; place-items: center; border: 1px solid var(--linka-pole); transition: background-color .3s, color .3s, border-color .3s; }
  .kontakty .sipka svg { width: 16px; height: 16px; }
  .kontakty a:hover .sipka { background: var(--akcent); color: var(--na-akcentu); border-color: var(--akcent); }
  .kontakty a:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; border-radius: 6px; }
  .paticka { max-width: 1380px; margin: clamp(70px, 8vw, 110px) auto 0; padding: 28px calc(var(--ram-okraj) + 14px) 34px; display: flex; justify-content: space-between; align-items: center; gap: 16px 30px; flex-wrap: wrap; color: var(--tlumeny); font-size: 14px; border-top: 1px solid var(--linka); }
  .paticka .logo { color: var(--text); font-size: 18px; }
  .paticka ul { display: flex; gap: 10px 26px; flex-wrap: wrap; }
  .paticka a:hover { color: var(--text); }


  /* rady a tipy: články jako řádky s linkami (jako služby); perex vidět, plný text v HTML se rozbalí tlačítkem (aria-expanded) */
  .clanky { border-top: 1px solid var(--text); }
  .clanek { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) auto; column-gap: 24px; align-items: start; padding: 26px 0 28px; border-bottom: 1px solid var(--linka); scroll-margin-top: 16px; }
  .clanek h3 { font-weight: 500; font-size: clamp(1.3rem, 1.8vw, 1.6rem); line-height: 1.15; letter-spacing: -.025em; scroll-margin-top: 24px; }
  .clanek .perex { color: var(--tlumeny); max-width: 36em; }
  .clanek .perex .doplnit { color: var(--text); }
  .rozbalit { display: inline-flex; align-items: center; gap: 12px; height: 44px; padding: 0 5px 0 18px; margin-top: -6px; border-radius: 999px; border: 1px solid var(--linka-pole); font-size: 14.5px; font-weight: 500; white-space: nowrap; }
  .rozbalit:hover { border-color: var(--text); }
  .rozbalit:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; border-radius: 999px; }
  .rozbalit .znak { position: relative; width: 34px; height: 34px; border-radius: 50%; background: var(--plocha-2); flex: none; }
  .rozbalit .znak::before, .rozbalit .znak::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 1.5px; margin: -.75px 0 0 -6px; background: currentColor; }
  .rozbalit .znak::after { transform: rotate(90deg); }
  .rozbalit[aria-expanded="true"] .znak::after { transform: rotate(0deg); }
  html.pohyb .rozbalit .znak::after { transition: transform .3s cubic-bezier(.2,.7,.1,1); }
  .clanek-text { grid-column: 2 / 4; max-width: 42em; padding-top: 26px; color: var(--cteni); font-size: 16.5px; line-height: 1.65; }
  .clanek-text[hidden] { padding-top: 0; } /* sbalený text (hidden="until-found") nechává jen prázdný box – bez odsazení */
  html.pohyb .clanek-text:not([hidden]) { animation: clanek-in .45s cubic-bezier(.2,.7,.1,1); }
  @keyframes clanek-in { from { opacity: 0; transform: translate3d(0, 8px, 0); } }
  .clanek-text h4 { margin: 30px 0 10px; color: var(--text); font-weight: 600; font-size: 1.125rem; line-height: 1.3; letter-spacing: -.015em; }
  .clanek-text h4:first-child { margin-top: 0; }
  .clanek-text p + p { margin-top: 12px; }
  .clanek-text ul, .clanek-text ol { display: grid; gap: 10px; margin-top: 12px; }
  .clanek-text ul + p, .clanek-text ol + p { margin-top: 14px; }
  .clanek-text ul li { position: relative; padding-left: 22px; }
  .clanek-text ul li::before { content: "–"; position: absolute; left: 2px; top: 0; color: var(--tlumeny); }
  .clanek-text ol { counter-reset: krok; }
  .clanek-text ol li { position: relative; padding-left: 38px; counter-increment: krok; }
  .clanek-text ol li::before { content: counter(krok); position: absolute; left: 0; top: .15em; width: 25px; height: 25px; border-radius: 50%; border: 1px solid var(--linka-pole); color: var(--text); font: 500 12.5px/23px "IBM Plex Mono", ui-monospace, monospace; text-align: center; }
  .clanek-text strong { color: var(--text); font-weight: 600; }
  .clanek-text p.vyzva { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 18px; margin-top: 30px; padding-top: 24px; border-top: 1px solid var(--linka); }
  .vyzva-uvod { color: var(--text); font-weight: 500; width: 100%; }
  .vyzva-tel { display: inline-flex; align-items: center; height: 46px; padding: 0 20px; border-radius: 999px; background: var(--akcent); color: var(--na-akcentu); font-weight: 600; font-size: 15px; white-space: nowrap; }
  .vyzva-tel .doplnit { color: inherit; font-weight: 500; margin-left: .3em; }
  .vyzva-tel:hover { background: #FFC63F; }
  .vyzva-tel:focus-visible { outline: 2px solid var(--text); outline-offset: 3px; border-radius: 999px; }
  .vyzva-dotaz { color: var(--text); text-decoration: underline; text-decoration-color: var(--linka-pole); text-underline-offset: 4px; }
  .vyzva-dotaz:hover { text-decoration-color: currentColor; }

  @media (max-width: 1000px) {
    .lista nav { display: none; }
    .menu-tl { display: inline-flex; }
    .vpravo { gap: 8px; }
    .dotaz-mriz { grid-template-columns: 1fr; }
  }
  /* ---------- mobil: rám na výšku, plátno zaostřené na vchod s lampami ---------- */
  @media (max-width: 760px) {
    :root { --ram-okraj: 10px; }
    .lista { height: 66px; padding: 0 12px 0 16px; }
    .logo { font-size: 19px; gap: 8px; } .logo svg { width: 22px; }
    .tel { height: 42px; padding: 0 14px 0 12px; font-size: 14.5px; gap: 8px; }
    .menu-tl { height: 42px; padding: 0 14px; }
    .menu-panel { top: 60px; }
    .ram { height: max(calc(100svh - 66px - var(--ram-okraj)), 620px); }
    .platno { --fx: .42; --fy: .5; }
    .roh-lh { display: none; }
    .roh-ph { left: 20px; right: auto; text-align: left; }
    .text { right: 20px; bottom: 24px; }
    .hero h1 { font-size: clamp(2rem, 8.6vw, 2.5rem); }
    .text p { font-size: 15px; }
    .vypinac { top: 18px; bottom: auto; right: 16px; gap: 12px; }
    .vypinac .stav { display: none; }
    .ramecek { width: 52px; height: 74px; border-radius: 10px; }
    .kolebka { width: 32px; height: 50px; }
    .kolebka::after { top: 8px; width: 6px; height: 6px; margin-left: -3px; }
    .sekce { padding: 70px 16px 0; }
    .radky li { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .radky p { grid-column: 1 / -1; grid-row: 2; }
    .radky .cena { grid-column: 2; grid-row: 1; }
    .formular { grid-template-columns: 1fr; padding: 18px; }
    .kontakty a { grid-template-columns: minmax(0, 1fr) auto; gap: 4px 16px; padding: 20px 0; }
    .kontakty .druh { grid-column: 1; grid-row: 1; }
    .kontakty .udaj { grid-column: 1; grid-row: 2; font-size: 1.5rem; }
    .kontakty .sipka { grid-column: 2; grid-row: 1 / 3; }
    .paticka { padding: 24px 16px 30px; }
