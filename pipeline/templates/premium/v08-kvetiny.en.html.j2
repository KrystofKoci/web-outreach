<!DOCTYPE html>

<html lang="en">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<meta content="{{ meta_description }}" name="description"/>
<script>
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  h.dataset.tema=(q.get('tema')==='tmava'||location.hash==='#tmava')?'tmava':'svetla';
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0')h.classList.add('pohyb');})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:opsz,wght@6..96,400&amp;family=Inter+Tight:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V08 Produkt s přepínáním variant – předloha FORME (uxui_DdQaqb_PC_T_1 až _5), ovládání Moon (uxui_DdVig4mIA6v_1), Modak AFTER (uxui_DZ_0nVEI9Hv_3) */
  :root {
    /* varianta 0 broskvová, 1 bílá, 2 malinová – světlá */
    --v0-scena:#EBCDB8; --v0-text:#2A1A12; --v0-tlumeny:#6B4F42; --v0-akcent:#A8532F; --v0-na-akcentu:#FFFFFF; --v0-svetlo:rgba(255,236,220,.75); --v0-vzorek:#F2B48F;
    --v1-scena:#E2DCD3; --v1-text:#22201E; --v1-tlumeny:#625A53; --v1-akcent:#966437; --v1-na-akcentu:#FFFFFF; --v1-svetlo:rgba(255,246,232,.9); --v1-vzorek:#F4EFE2;
    --v2-scena:#EDC9D2; --v2-text:#2A1219; --v2-tlumeny:#6E4652; --v2-akcent:#B5294A; --v2-na-akcentu:#FFFFFF; --v2-svetlo:rgba(255,232,238,.75); --v2-vzorek:#D22D4B;
    --stin: rgba(60,25,20,.22);
    --stopa-a: .0;
  }
  html[data-tema="tmava"] {
    --v0-scena:#2B1B14; --v0-text:#F3ECE6; --v0-tlumeny:#BFA99C; --v0-akcent:#E39A72; --v0-na-akcentu:#2B1B14; --v0-svetlo:rgba(227,154,114,.20);
    --v1-scena:#1C1B1D; --v1-text:#F3ECE6; --v1-tlumeny:#A9A3A0; --v1-akcent:#D4A373; --v1-na-akcentu:#1C1B1D; --v1-svetlo:rgba(212,163,115,.16);
    --v2-scena:#2C0F1B; --v2-text:#F3ECE6; --v2-tlumeny:#C2A2AD; --v2-akcent:#C93A60; --v2-na-akcentu:#FFFFFF; --v2-svetlo:rgba(201,58,96,.24);
    --stin: rgba(0,0,0,.55);
  }
  body { font-family: "Inter Tight", system-ui, sans-serif; font-size: 16px; line-height: 1.5;
    --pozadi: var(--v0-scena); --text: var(--v0-text); background: var(--pozadi); color: var(--text); }
  body[data-v="1"] { --pozadi: var(--v1-scena); --text: var(--v1-text); }
  body[data-v="2"] { --pozadi: var(--v2-scena); --text: var(--v2-text); }
  body { --tlumeny: var(--v0-tlumeny); --akcent: var(--v0-akcent); --na-akcentu: var(--v0-na-akcentu); --svetlo: var(--v0-svetlo); }
  body[data-v="1"] { --tlumeny: var(--v1-tlumeny); --akcent: var(--v1-akcent); --na-akcentu: var(--v1-na-akcentu); --svetlo: var(--v1-svetlo); }
  body[data-v="2"] { --tlumeny: var(--v2-tlumeny); --akcent: var(--v2-akcent); --na-akcentu: var(--v2-na-akcentu); --svetlo: var(--v2-svetlo); }
  body { --linka: color-mix(in srgb, var(--text) 16%, transparent); --stopa: color-mix(in srgb, var(--text) 22%, var(--pozadi)); }
  body, .hero { transition: background-color .8s ease, color .5s ease; }

  .verzalky { font-weight: 500; font-size: 11px; letter-spacing: .2em; text-transform: uppercase; line-height: 1.7; }
  .doplnit { color: var(--tlumeny); }

  /* ---------- lišta (FORME: logo, 3 odkazy na střed, vpravo ikony) ---------- */
  .lista { position: absolute; z-index: 20; top: 0; left: 0; right: 0; height: 80px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; padding: 0 4vw; }
  .logo { font-weight: 500; font-size: 13px; letter-spacing: .42em; text-transform: uppercase; }
  .lista nav ul { display: flex; gap: 48px; }
  .lista .vpravo { justify-self: end; display: flex; align-items: center; gap: 10px; }
  .pilulka-obrys { height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--linka); display: inline-flex; align-items: center; gap: 10px; }
  .hamburger { display: none; width: 40px; height: 40px; place-items: center; }
  .hamburger i { display: grid; gap: 6px; width: 20px; }
  .hamburger span { display: block; height: 1.5px; background: currentColor; }
  .hamburger[aria-expanded="true"] i { gap: 0; }
  .hamburger[aria-expanded="true"] span:first-child { transform: translateY(.75px) rotate(45deg); }
  .hamburger[aria-expanded="true"] span:last-child { transform: translateY(-.75px) rotate(-45deg); }
  .menu-panel { position: absolute; top: 60px; left: 20px; right: 20px; z-index: 30; padding: 8px 22px 22px; border-radius: 20px;
    background: var(--pozadi); border: 1px solid var(--linka); box-shadow: 0 18px 40px -24px rgba(0,0,0,.35); }
  .menu-panel[hidden] { display: none; }
  .menu-panel .pilulka-plna:focus-visible { outline-color: var(--text); outline-offset: 4px; }   /* obrys v barvě textu, ne bílý na světlém panelu */
  .menu-panel li a { display: block; padding: 14px 0; border-bottom: 1px solid var(--linka); }
  .menu-panel .pilulka-plna { margin-top: 18px; height: 48px; padding: 0 22px; border-radius: 999px; display: inline-flex; align-items: center; gap: 10px;
    background: var(--akcent); color: var(--na-akcentu); }

  /* ---------- hero ---------- */
  .hero { position: relative; min-height: max(100svh, 640px); overflow: hidden; isolation: isolate; }
  .svetlo { position: absolute; z-index: 0; left: 58%; top: 50%; width: 64vw; height: 64vw; transform: translate(-50%, -50%); pointer-events: none;
    background: radial-gradient(closest-side, var(--svetlo), transparent 70%); transition: background .8s ease; }
  .podlaha { position: absolute; z-index: 0; left: 0; right: 0; bottom: 0; height: 30%; pointer-events: none;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--text) 5%, transparent)); }

  .text { position: absolute; z-index: 4; left: 4vw; top: 33%; width: 36vw; }
  h1 { font-family: "Bodoni Moda", serif; font-weight: 400; font-size: clamp(2.75rem, 4.9vw, 5.6rem); line-height: 1.04; letter-spacing: -.035em; margin: 0; }
  h1 .v { display: none; }
  h1 .v.aktivni { display: block; }
  h1 .druhy { color: var(--tlumeny); display: block; white-space: nowrap; }
  .popis { margin-top: 22px; max-width: min(30ch, 33vw); font-size: 16px; color: var(--tlumeny); }   /* 33vw: na 768 px nesmí dojít ke kytici (začíná na 38vw) */
  .popis span { display: none; } .popis span.aktivni { display: inline; }
  .cta { margin-top: 32px; display: inline-flex; align-items: center; gap: 14px; height: 54px; padding: 0 7px 0 26px; border-radius: 999px;
    background: var(--akcent); color: var(--na-akcentu); font-weight: 500; font-size: 15px; transition: background-color .8s, color .8s, transform .45s cubic-bezier(.2,.7,.1,1); }
  .cta .kolecko { width: 40px; height: 40px; border-radius: 50%; display: grid; place-items: center; background: color-mix(in srgb, var(--na-akcentu) 16%, transparent); }
  .cta svg { width: 15px; height: 15px; }

  .kytice { position: absolute; z-index: 2; left: 57%; top: 49%; width: min(38vw, 70svh); aspect-ratio: 1200 / 1000; margin: 0;
    transform: translate(-50%, -50%) translate3d(var(--px-mys-x, 0px), calc(var(--px-scroll, 0px) + var(--px-mys-y, 0px)), 0); }
  .kytice img { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; opacity: 0; transform: translate3d(9%, 0, 0) scale(.94);
    transition: opacity .7s ease, transform 1s cubic-bezier(.2,.7,.1,1); }
  .kytice img.aktivni { opacity: 1; transform: none; }
  .kytice img.odchazi { opacity: 0; transform: translate3d(-9%, 0, 0) scale(.94); }
  /* stín těsně pod koncem stonků (broskvová a malinová mají seříznuté stonky, bílá zaoblený konec) */
  .kytice .stin { position: absolute; left: 49%; bottom: -1.6%; width: 36%; height: 6%; transform: translateX(-50%); border-radius: 50%;
    background: radial-gradient(closest-side, var(--stin), transparent); filter: blur(5px); transition: width .7s ease; }
  .kytice .stin::before { content: ""; position: absolute; left: 33%; right: 33%; top: 30%; bottom: 30%; border-radius: 50%;
    background: radial-gradient(closest-side, var(--stin), transparent); }
  body[data-v="1"] .kytice .stin { width: 62%; bottom: -2.4%; }
  /* malinová má v obrázku menší okraje: zúžit, aby hlavy květů měly stejnou váhu jako ostatní varianty.
     Od kola 3 vlastní podoba (oproti V06 zrcadlená a nakloněná o 8° doprava), řez stonků je na x 46–57 % obrázku. */
  .kytice img[data-varianta-obr="2"], .dalsi img[data-nahled="2"] { width: 86%; left: 7%; }
  body[data-v="2"] .kytice .stin { width: 34%; left: 52%; }

  .dalsi { position: absolute; z-index: 1; right: 0; top: 50%; width: min(26vw, 48svh); transform: translate(54%, -50%); opacity: .95; }
  .dalsi button { display: block; width: 100%; aspect-ratio: 1200 / 1000; position: relative; }
  .dalsi img { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; opacity: 0; transition: opacity .7s ease; }
  .dalsi img.aktivni { opacity: 1; }

  .stitek { position: absolute; z-index: 4; left: 39%; top: 79%; color: var(--text); }
  .stitek .nazev { font-weight: 500; font-size: 12px; letter-spacing: .18em; text-transform: uppercase; }
  .stitek .druh { font-size: 12px; letter-spacing: .14em; text-transform: uppercase; color: var(--tlumeny); }
  .stitek .carka { display: block; width: 22px; height: 1px; background: currentColor; margin: 12px 0 10px; opacity: .6; }
  .stitek .cena { font-size: 15px; font-weight: 500; }
  .stitek [data-varianta-text] { display: none; } .stitek [data-varianta-text].aktivni { display: block; }

  .vzorky { position: absolute; z-index: 4; left: 4vw; bottom: 6.5%; display: flex; align-items: center; gap: 14px; }
  .vzorky button { width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; border: 1px solid transparent; }
  .vzorky button span { width: 18px; height: 18px; border-radius: 50%; box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--text) 18%, transparent); }
  .vzorky button[aria-pressed="true"] { border-color: var(--text); }
  .vzorky .popisek { margin-left: 8px; color: var(--tlumeny); }

  .pocitadlo { position: absolute; z-index: 4; right: 4vw; bottom: 6.5%; display: flex; align-items: center; gap: 16px; font-size: 13px; letter-spacing: .08em; font-variant-numeric: tabular-nums; }
  .pocitadlo .cara { width: 64px; height: 1px; background: var(--linka); position: relative; overflow: hidden; }
  .pocitadlo .cara i { position: absolute; inset: 0; background: var(--text); transform-origin: left; transform: scaleX(.3333); transition: transform .7s cubic-bezier(.2,.7,.1,1); }
  .pocitadlo button { width: 44px; height: 44px; border-radius: 50%; border: 1px solid var(--linka); display: grid; place-items: center; }
  .pocitadlo svg { width: 16px; height: 16px; }

  /* ---------- kolo 6: nabídka s vějířem fotek (HorizonX „gallery-fan“ přepsaný do vanilla JS) ----------
     Každá sekce: řádek nadpis | text | cena, pod ním 5 karet 2:3 (rádius 14 px, mezera 16 px).
     S pohybem: sekce je scroll range, scéna je sticky; karty přijedou zprava, přes vějíř (abs(i−2)·3°, origin 50 % 0 %)
     se složí do řady, popisky vyjedou zdola. Bez pohybu (reduced motion, ?pohyb=0) rovnou složený stav. */
  .fan { position: relative; --kw: min(calc((100vw - 8vw - 64px) / 5), calc((100svh - 330px) * .6667)); }
  .fan + .fan .fan-hlava { border-top-color: transparent; }
  .fan-scena { padding: 96px 4vw 72px; }
  .fan-hlava { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr) auto; gap: 4vw; align-items: baseline;
    padding-top: 28px; border-top: 1px solid var(--linka); }
  .fan-hlava h2 { font-family: "Bodoni Moda", serif; font-weight: 400; font-size: clamp(2rem, 3vw, 3.2rem); line-height: 1.05; letter-spacing: -.03em; margin: 0; }
  .fan-hlava p { color: var(--tlumeny); max-width: 44ch; }
  .fan-hlava .cena { white-space: nowrap; font-size: 15px; color: var(--tlumeny); }
  .fan-rada { display: flex; gap: 16px; margin-top: 48px; justify-content: center; }
  .karta-fan { flex: none; width: var(--kw); margin: 0; }
  .karta-fan .foto { display: block; width: 100%; aspect-ratio: 2 / 3; border-radius: 14px; overflow: hidden; transform-origin: 50% 0%;
    background: color-mix(in srgb, var(--text) 8%, var(--pozadi)); }
  .karta-fan img { width: 100%; height: 100%; object-fit: cover; display: block; }
  html[data-tema="tmava"] .karta-fan img { filter: brightness(.9) saturate(.95); }
  .karta-fan figcaption { overflow: hidden; margin-top: 14px; min-height: 3.2em; }
  .karta-fan figcaption span { display: block; }
  .karta-fan .co { font-family: "Bodoni Moda", serif; font-size: 19px; line-height: 1.2; letter-spacing: -.01em; }
  .karta-fan .veta { font-size: 14px; line-height: 1.45; color: var(--tlumeny); margin-top: 3px; max-width: 30ch; }

  @media (min-height: 560px) {
    html.pohyb .fan { height: calc(100svh + 130vh); }
    html.pohyb .fan-scena { position: sticky; top: 0; height: 100svh; overflow: clip; display: flex; flex-direction: column; justify-content: center; }
    html.pohyb .karta-fan .foto, html.pohyb .karta-fan figcaption span { will-change: transform, opacity; }
  }

  /* ---------- hodnocení Google (jen když je recenzí víc než 45, viz RECENZE ve skriptu) ---------- */
  .hodnoceni { padding: 110px 4vw 120px; border-top: 1px solid var(--linka); }
  .hodnoceni[hidden] { display: none; }
  .hod-souhrn { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 2fr); gap: 4vw; align-items: end; }
  .hod-souhrn h2 { font-family: "Bodoni Moda", serif; font-weight: 400; font-size: clamp(2rem, 3vw, 3.2rem); line-height: 1.05; letter-spacing: -.03em; }
  .hod-cislo { display: flex; align-items: baseline; gap: 18px; flex-wrap: wrap; }
  .hod-cislo .znamka { font-family: "Bodoni Moda", serif; font-size: clamp(2.6rem, 4vw, 4rem); line-height: 1; letter-spacing: -.03em; }
  .hod-cislo .znamka.doplnit { font-size: clamp(1.4rem, 2vw, 2rem); }
  .hod-cislo .pocet, .hod-cislo .podil { color: var(--tlumeny); font-size: 15px; }
  .hvezdy { display: inline-flex; gap: 3px; color: var(--akcent); }
  .hvezdy svg { width: 15px; height: 15px; }
  .hod-seznam { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 56px; border-top: 1px solid var(--linka); }
  .hod-seznam li { padding: 30px 32px 6px 0; display: grid; gap: 16px; align-content: start; }
  .hod-seznam li + li { padding-left: 32px; border-left: 1px solid var(--linka); }
  .hod-seznam blockquote { margin: 0; font-family: "Bodoni Moda", serif; font-size: 19px; line-height: 1.4; letter-spacing: -.005em; color: var(--tlumeny); }
  .hod-seznam .kdo { font-size: 14px; color: var(--tlumeny); }
  .hod-zdroj { margin-top: 36px; font-size: 14px; color: var(--tlumeny); }
  .hod-zdroj a { color: var(--text); text-decoration: underline; text-underline-offset: 3px; text-decoration-thickness: 1px; }

  /* ---------- patička ---------- */
  .paticka { padding: 64px 4vw 40px; border-top: 1px solid var(--linka); display: grid; grid-template-columns: 1fr repeat(3, auto); gap: 24px 64px; align-items: start; }
  .paticka .logo { display: inline-block; margin-bottom: 10px; }
  .paticka p { color: var(--tlumeny); font-size: 14px; }
  .paticka dt { color: var(--tlumeny); }
  .paticka dd { margin: 4px 0 0; font-size: 15px; }
  .paticka .spodek { grid-column: 1 / -1; display: flex; justify-content: space-between; gap: 16px; margin-top: 36px; padding-top: 20px; border-top: 1px solid var(--linka); font-size: 13px; color: var(--tlumeny); }

  /* ---------- kolo 4: sticky scroll příběh ----------
     Hero se přišpendlí na 250vh a varianty se samy vystřídají 01 → 02 → 03 (kytice, tón, nadpis, popis, počítadlo).
     Ruční přepínač posune stránku na úsek zvolené varianty, takže scroll a přepínač drží stejný stav. Po 03 hero odjede.
     Bez pohybu (reduced motion, ?pohyb=0) a na nízkých oknech zůstává původní ruční přepínač bez přišpendlení. */
  html.pohyb .kytice { transform: translate(-50%, -50%) translate3d(var(--px-mys-x, 0px), calc(var(--pr-y, 0px) + var(--px-mys-y, 0px)), 0); }
  html.pohyb h1 { display: grid; }
  html.pohyb h1 .v, html.pohyb h1 .v.aktivni { display: block; grid-area: 1 / 1; }
  /* odchozí nadpis rychle zmizí, příchozí naběhne až po něm (bez překryvu dvou nadpisů) */
  html.pohyb h1 .v { opacity: 0; transition: opacity .26s ease; }
  html.pohyb h1 .v.aktivni { opacity: 1; transition: opacity .55s ease .3s; }
  html.pohyb .popis { display: grid; }
  html.pohyb .popis span, html.pohyb .popis span.aktivni { display: block; grid-area: 1 / 1; }
  html.pohyb .popis span { opacity: 0; transition: opacity .24s ease; }
  html.pohyb .popis span.aktivni { opacity: 1; transition: opacity .5s ease .34s; }
  @media (min-height: 600px) {
    html.pohyb .pribeh { height: calc(max(100svh, 640px) + 250vh); }
    html.pohyb .pribeh > .hero { position: sticky; top: 0; }
    html.pohyb .lista { position: fixed; transition: transform .5s cubic-bezier(.2,.7,.1,1), opacity .4s ease, visibility 0s 0s, color .5s; }
    html.pohyb .lista.pryc { transform: translate3d(0, -100%, 0); opacity: 0; visibility: hidden;
      transition: transform .5s cubic-bezier(.2,.7,.1,1), opacity .4s ease, visibility 0s .5s, color .5s; }
  }

  @media (max-width: 760px) and (min-height: 560px) {
    html.pohyb .fan-rada { overflow: visible; scroll-snap-type: none; }
  }
  @media (max-width: 760px) {
    .lista { height: 64px; padding: 0 20px; grid-template-columns: 1fr auto; }
    .lista nav, .lista .pilulka-obrys { display: none; }
    .hamburger { display: inline-grid; }
    .text { left: 20px; right: 20px; top: 92px; width: auto; }
    h1 { font-size: 44px; }
    .popis { margin-top: 12px; font-size: 15px; max-width: 30ch; }
    .cta { position: absolute; left: 0; top: calc(100svh - 92px - 140px); margin: 0; }
    .kytice { left: 47%; top: 57%; width: 86vw; }
    .svetlo { left: 50%; top: 56%; width: 140vw; height: 140vw; }
    .dalsi { top: 57%; width: 40vw; transform: translate(66%, -50%); }
    .stitek { left: 20px; top: auto; bottom: 168px; display: none; }
    .vzorky { left: 20px; bottom: 26px; }
    .vzorky .popisek { display: none; }
    .pocitadlo { right: 20px; bottom: 26px; }
    .pocitadlo .cara { width: 36px; }
    .fan { --kw: min(58vw, calc((100svh - 400px) * .6667)); }
    .fan-scena { padding: 76px 20px 48px; }
    .fan-hlava { grid-template-columns: 1fr auto; gap: 10px 16px; padding-top: 22px; }
    .fan-hlava p { grid-column: 1 / -1; grid-row: 2; font-size: 15px; }
    .fan-hlava .cena { grid-column: 2; grid-row: 1; }
    .fan-rada { justify-content: flex-start; margin-top: 30px; overflow-x: auto; scroll-snap-type: x mandatory; margin-inline: -20px; padding: 0 20px 6px; scroll-padding-inline: 20px; scrollbar-width: none; }
    .fan-rada::-webkit-scrollbar { display: none; }
    .karta-fan { scroll-snap-align: start; }
    .karta-fan .co { font-size: 18px; }
    .karta-fan .veta { font-size: 14px; }
    .hodnoceni { padding: 80px 20px 90px; }
    .hod-souhrn { grid-template-columns: 1fr; gap: 20px; }
    .hod-seznam { grid-template-columns: 1fr; margin-top: 36px; }
    .hod-seznam li, .hod-seznam li + li { padding: 26px 0; border-left: 0; }
    .hod-seznam li + li { border-top: 1px solid var(--linka); }
    .paticka { grid-template-columns: 1fr 1fr; padding: 56px 20px 32px; gap: 24px; }
    .paticka > div:first-child { grid-column: 1 / -1; }
    .paticka .spodek { flex-direction: column; gap: 6px; }
  }
</style>
<style id="pz-css">
.pz-hod{padding:clamp(56px,9vw,104px) 24px;text-align:center;color:inherit;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
.pz-hod .pz-in{max-width:560px;margin:0 auto}
