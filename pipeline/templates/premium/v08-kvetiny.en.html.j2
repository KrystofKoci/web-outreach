<script>
  /* Přepínač variant V08: mění kytici, tón scény, texty a počítadlo. Pohyb jen přes CSS přechody (reduced-motion je vypne). */
  (function () {
    var body = document.body, pocet = 3, akt = 0;
    var nazvy = ['Peach', 'White', 'Raspberry'];
    function nastav(n) {
      if (n === akt) return;
      var stary = akt; akt = (n + pocet) % pocet;
      body.dataset.v = String(akt);
      document.querySelectorAll('[data-varianta-obr]').forEach(function (img) {
        var i = +img.getAttribute('data-varianta-obr');
        img.classList.remove('odchazi');
        if (i === stary) { img.classList.remove('aktivni'); img.classList.add('odchazi'); }
        if (i === akt) { img.classList.add('aktivni'); }
      });
      document.querySelectorAll('[data-varianta-text]').forEach(function (el) {
        el.classList.toggle('aktivni', +el.getAttribute('data-varianta-text') === akt);
      });
      var dalsi = (akt + 1) % pocet;
      document.querySelectorAll('[data-nahled]').forEach(function (img) {
        img.classList.toggle('aktivni', +img.getAttribute('data-nahled') === dalsi);
      });
      document.querySelectorAll('[data-vyber]').forEach(function (b) {
        b.setAttribute('aria-pressed', +b.getAttribute('data-vyber') === akt ? 'true' : 'false');
      });
      var h1 = document.querySelector('h1'), v = h1.querySelector('.v.aktivni');
      if (v) h1.setAttribute('aria-label', v.textContent.replace(/\s+/g, ' ').trim());
      document.querySelector('[data-cislo]').textContent = '0' + (akt + 1);
      document.querySelector('.pocitadlo .cara i').style.transform = 'scaleX(' + ((akt + 1) / pocet).toFixed(4) + ')';
      document.querySelector('[data-dalsi][aria-label]').setAttribute('aria-label', 'Next bouquet colour: ' + nazvy[dalsi]);
    }
    /* ruční volba: když běží scroll příběh, převezme ji (posune stránku na úsek varianty), jinak se přepne hned */
    var hak = null;
    function vyber(n) { n = (n + pocet) % pocet; if (hak && hak(n)) return; nastav(n); }
    document.querySelectorAll('[data-dalsi]').forEach(function (b) { b.addEventListener('click', function () { vyber(akt + 1); }); });
    document.querySelectorAll('[data-vyber]').forEach(function (b) { b.addEventListener('click', function () { vyber(+b.getAttribute('data-vyber')); }); });
    var hero = document.querySelector('.hero');
    hero.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') vyber(akt + 1);
      if (e.key === 'ArrowLeft') vyber(akt - 1);
    });
    window.V08 = { nastav: nastav, aktualni: function () { return akt; }, hak: function (f) { hak = f; } };
  })();
</script>
<script>
  /* Kolo 4: sticky scroll příběh V08. Postup p (0–1) přes přišpendlení rozdělí na tři úseky; úsek = varianta. */
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('pohyb') || !window.V08) return;   /* reduced motion nebo ?pohyb=0: jen ruční přepínač */
    var pribeh = document.querySelector('.pribeh'), hero = pribeh.querySelector('.hero'), lista = document.querySelector('.lista');
    var kytice = hero.querySelector('.kytice');
    var start = 0, delka = 0, ceka = false, pocet = 3;
    function mer() { start = pribeh.getBoundingClientRect().top + window.scrollY; delka = Math.max(0, pribeh.offsetHeight - hero.offsetHeight); }
    function usek(sy) { var p = delka ? (sy - start) / delka : 0; return Math.min(pocet - 1, Math.max(0, Math.floor(p * pocet))); }
    function pozadej() { if (!ceka) { ceka = true; requestAnimationFrame(kresli); } }
    function kresli() {
      ceka = false;
      var sy = window.scrollY;
      if (delka) {
        var u = usek(sy);
        if (u !== V08.aktualni()) V08.nastav(u);
      }
      kytice.style.setProperty('--pr-y', (Math.max(0, sy - start - delka) * 0.05).toFixed(1) + 'px');   /* mírný parallax až při odjezdu */
      lista.classList.toggle('pryc', delka > 0 && sy > start + delka + 4);
    }
    /* ruční přepínač: posune na úsek zvolené varianty (01 na začátek, 02 a 03 do středu úseku), stav pak drží scroll */
    V08.hak(function (n) {
      if (!delka) return false;
      var sy = window.scrollY;
      if (sy > start + delka + hero.offsetHeight * 0.5) return false;   /* hero už skoro odjel */
      var cilP = n === 0 ? 0 : (n + 0.5) / pocet;
      window.scrollTo({ top: Math.round(start + cilP * delka), behavior: 'instant' });
      V08.nastav(n); kresli();
      return true;
    });
    mer();
    window.addEventListener('scroll', pozadej, { passive: true });
    window.addEventListener('resize', function () { mer(); pozadej(); });
    pozadej();
  })();
</script>
<script>
  /* Kolo 6: hodnocení Google. Blok se ukáže jen při víc než 45 recenzích (pocet 45 a méně = blok zůstane skrytý).
     Od 50 recenzí se navíc ukáže podíl spokojených (ROZHODNUTI_MAJITELE). U klienta se mění jen tahle data.
     ukazka: true = demo: místo čísel se ukáže [doplnit], texty recenzí jsou zřetelné šablonové výplně (žádné vymyšlené recenze). */
  var RECENZE = {
    pocet: {{ rating_count_js }},            /* demo hodnota, aby byl blok vidět; pod 46 se blok skryje */
    znamka: {{ rating_js }},         /* např. 4.9 – doplnit z Google */
    podilSpokojenych: null,
    odkaz: '{{ maps_url_js }}',
    ukazka: false,
    vybrane: {{ reviews_js|safe }}
  };
  (function () {
    var blok = document.querySelector('[data-hodnoceni]');
    if (!blok || !(RECENZE.znamka > 0)) return;
    var hv = '<svg viewBox="0 0 16 16"><path fill="currentColor" d="M8 1.2l2 4.3 4.7.5-3.5 3.2 1 4.6L8 11.5l-4.2 2.3 1-4.6L1.3 6l4.7-.5z"/></svg>';
    function hvezdy(n) { var h = ''; for (var i = 0; i < 5; i++) h += i < n ? hv : hv.replace('currentColor', 'none" stroke="currentColor'); return h; }
    function esc(t) { return String(t).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
    var zn = blok.querySelector('[data-hod-znamka]');
    if (RECENZE.ukazka || RECENZE.znamka == null) { zn.textContent = '–'; zn.classList.add('doplnit'); }
    else zn.textContent = RECENZE.znamka.toLocaleString('en-US', { minimumFractionDigits: 1, maximumFractionDigits: 1 });
    blok.querySelector('[data-hod-hvezdy]').innerHTML = hvezdy(Math.round(RECENZE.znamka || 5));
    blok.querySelector('[data-hod-pocet]').innerHTML = RECENZE.ukazka ? 'Google reviews' : (RECENZE.pocet >= 50 ? esc(RECENZE.pocet) + ' Google reviews' : 'Google rating');
    if (RECENZE.podilSpokojenych != null) {
      var pd = blok.querySelector('[data-hod-podil]'); pd.hidden = false;
      pd.innerHTML = RECENZE.ukazka || RECENZE.podilSpokojenych == null ? '' : esc(RECENZE.podilSpokojenych) + '% satisfied';
    }
    blok.querySelector('[data-hod-seznam]').innerHTML = RECENZE.vybrane.slice(0, 5).map(function (r) {
      return '<li><span class="hvezdy" role="img" aria-label="' + r.hvezdy + ' out of 5 stars">' + hvezdy(r.hvezdy) + '</span>' +
        '<blockquote>' + esc(r.text) + '</blockquote><span class="kdo">' + esc(r.jmeno) + ' · Google</span></li>';
    }).join('');
    blok.querySelector('[data-hod-odkaz]').href = RECENZE.odkaz;
    blok.hidden = false;
  })();
</script>
<script>
  /* Kolo 6: vějíř fotek (HorizonX „gallery-fan“, přepsáno do vanilla JS bez knihoven).
     Sekce .fan je scroll range, .fan-scena je sticky. Postup p (0–1) řídí pro každou kartu vlastní úsek (stagger):
       1) „rozházeno“ zprava: karta přijede zprava s natočením a výškovým posunem,
       2) vějíř: natočení (2 − i)·3° kolem horního středu (transform-origin 50 % 0 %),
       3) složená řada: natočení 0, posun 0; popisek vyjede zdola (translateY 100 % → 0, opacity 0 → 1).
     Desktop: karty se skládají zprava doleva (nejdřív pravá krajní). Mobil: celá řada jede zprava doleva přes obrazovku
     a karty se skládají v pořadí, jak vjíždějí. Jen transform/opacity, requestAnimationFrame, kreslí se jen při změně.
     Bez pohybu (reduced motion, ?pohyb=0) nebo na oknech nižších než 560 px: rovnou složený stav, žádné inline styly. */
  (function () {
    var html = document.documentElement;
    if (!html.classList.contains('pohyb')) return;
    var vyska = matchMedia('(min-height: 560px)');
    var ROZ = [[-9, 46], [6, -34], [-4, 58], [11, -22], [-7, 36]];   /* rozházeno: [natočení °, posun y px] */
    var STAG = 0.1, KONEC = 0.86;                                     /* úsek karty = (p − k·STAG) / (KONEC − 4·STAG) */
    function o(t) { return 1 - Math.pow(1 - t, 3); }
    function vh(t) { return t < .5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2; }
    function cl(t) { return t < 0 ? 0 : t > 1 ? 1 : t; }
    var fany = Array.prototype.map.call(document.querySelectorAll('.fan'), function (el) {
      var rada = el.querySelector('[data-fan]');
      return { el: el, scena: el.querySelector('.fan-scena'), rada: rada,
        karty: Array.prototype.map.call(rada.children, function (f) { return { foto: f.querySelector('.foto'), cap: f.querySelectorAll('figcaption span'), x: 0 }; }),
        start: 0, delka: 1, posun: 0, mobil: false, posl: -1 };
    });
    function mer() {
      var vw = window.innerWidth;
      fany.forEach(function (f) {
        f.rada.style.transform = ''; f.karty.forEach(function (k) { k.foto.style.transform = ''; });
        /* timeline začne už při vjezdu sekce (horní hrana v 55 % okna), ať řada není při přišpendlení prázdná */
        var nabeh = window.innerHeight * 0.45;
        f.start = f.el.getBoundingClientRect().top + window.scrollY - nabeh;
        f.delka = Math.max(1, f.el.offsetHeight - f.scena.offsetHeight + nabeh);
        f.mobil = vw <= 760;
        var r = f.rada.getBoundingClientRect(), pad = parseFloat(getComputedStyle(f.scena).paddingLeft) || 0;
        var sirka = f.rada.scrollWidth;
        f.posun = f.mobil ? Math.max(0, sirka - (vw - 2 * pad)) : 0;   /* o kolik musí řada na mobilu odjet doleva */
        f.karty.forEach(function (k) { k.x = k.foto.getBoundingClientRect().left; k.w = k.foto.offsetWidth; });
        f.posl = -1;
      });
    }
    var ceka = false;
    function pozadej() { if (!ceka) { ceka = true; requestAnimationFrame(kresli); } }
    function kresli() {
      ceka = false;
      if (!vyska.matches) return;
      var sy = window.scrollY, vw = window.innerWidth;
      fany.forEach(function (f) {
        var p = cl((sy - f.start) / f.delka);
        if (sy + window.innerHeight < f.start - 50 && f.posl === 0) return;
        if (Math.abs(p - f.posl) < 0.0004) return;
        f.posl = p;
        /* mobil: řada vjede zprava (začíná o 55 % šířky okna vpravo) a dojede tak, aby byla vidět pravá krajní karta */
        var rx = 0;
        if (f.mobil) { rx = (1 - vh(cl(p / 0.92))) * vw * 0.55 - f.posun * vh(cl((p - 0.08) / 0.84)); f.rada.style.transform = 'translate3d(' + rx.toFixed(1) + 'px,0,0)'; }
        var dur = KONEC - 4 * STAG;
        f.karty.forEach(function (k, i) {
          var poradi = f.mobil ? i : 4 - i;                       /* desktop zprava doleva */
          var t = cl((p - poradi * STAG) / dur);
          var a = o(cl(t / 0.62)), b = vh(cl((t - 0.5) / 0.5)), c = o(cl((t - 0.68) / 0.32));
          /* odkud karta přijíždí: desktop těsně za pravým okrajem okna, mobil kousek zprava (řadu veze posun celé řady) */
          var x0 = f.mobil ? 70 + i * 24 : (vw - k.x) + 40 + (4 - i) * 30;
          var fanR = (2 - i) * 3, fanY = Math.abs(i - 2) * 14;
          var x = x0 * (1 - a);
          var r = ROZ[i][0] + (fanR - ROZ[i][0]) * a; r = r * (1 - b);
          var y = ROZ[i][1] + (fanY - ROZ[i][1]) * a; y = y * (1 - b);
          var sc = 0.92 + 0.08 * a;
          k.foto.style.transform = 'translate3d(' + x.toFixed(1) + 'px,' + y.toFixed(1) + 'px,0) rotate(' + r.toFixed(2) + 'deg) scale(' + sc.toFixed(3) + ')';
          k.foto.style.opacity = cl(a * 2.2).toFixed(3);
          for (var j = 0; j < k.cap.length; j++) {
            var cj = o(cl((t - 0.68 - j * 0.06) / 0.3));
            k.cap[j].style.transform = 'translate3d(0,' + ((1 - cj) * 100).toFixed(1) + '%,0)';
            k.cap[j].style.opacity = cj.toFixed(3);
          }
        });
      });
    }
    function znovu() { mer(); pozadej(); }
    mer();
    window.addEventListener('scroll', pozadej, { passive: true });
    window.addEventListener('resize', znovu);
    window.addEventListener('load', znovu);
    vyska.addEventListener('change', function () {
      if (!vyska.matches) fany.forEach(function (f) { f.rada.style.transform = ''; f.karty.forEach(function (k) { k.foto.style.cssText = ''; for (var j = 0; j < k.cap.length; j++) k.cap[j].style.cssText = ''; }); });
      znovu();
    });
    pozadej();
  })();
</script>
<p class="pz-credit">Website draft by: <a href="{{ owner_site }}" rel="noopener">{{ owner_name }}</a> · Photos: Unsplash</p>
{% if show_banner %}<div class="pz-pv" id="pz-pv" role="note"><span>Non-binding draft of a new website for <strong>{{ name }}</strong> · prepared by {{ owner_name }}</span>
<a class="pz-cta" href="{{ want_url }}">I want this website</a>{% if wa_url %}<a class="pz-cta" href="{{ wa_url }}" rel="noopener" target="_blank">WhatsApp</a>{% endif %}
<button data-pz-skryt="" type="button">Hide</button></div>{% endif %}
<script id="pz-js">(function(){
var pv=document.getElementById('pz-pv');if(pv){var x=pv.querySelector('[data-pz-skryt]');x&&x.addEventListener('click',function(){pv.classList.add('pz-skryt');});}
var HOOK="{{ form_webhook_url }}",LEAD="{{ lead_id }}";
function lab(f,el){var l=el.id&&f.querySelector('label[for="'+el.id+'"]');if(!l)l=el.closest('label');var s=(l?l.textContent:'')||el.name||'';return s.replace(/\s+/g,' ').replace(/\*/g,'').trim();}
document.addEventListener('submit',function(e){var f=e.target;if(!f||f.tagName!=='FORM'||f.hasAttribute('data-pz-ignore')||!HOOK)return;
  var d={lead_id:LEAD,source:'preview',name:'',email:'',phone:'',message:''},rest=[],seen={};
  Array.prototype.forEach.call(f.elements,function(el){ if(!el.name||el.type==='submit'||el.type==='button')return; if((el.type==='checkbox'||el.type==='radio')&&!el.checked)return;
   var v=(el.value||'').trim(); if(!v)return; var n=el.name.toLowerCase();
   if(/^(jmeno|name|jmeno_prijmeni)$/.test(n))d.name=v; else if(/^(email|e-mail)$/.test(n))d.email=v; else if(/^(telefon|phone|tel)$/.test(n))d.phone=v;
   else {var k=lab(f,el)||el.name; if(seen[k]){seen[k].push(v);}else{seen[k]=[v];rest.push(k);}} });
  d.message=rest.map(function(k){return k+': '+seen[k].join(', ');}).join('\n');
  setTimeout(function(){ if(f.querySelector('[aria-invalid="true"],.chyba,.is-invalid'))return; if(!f.hasAttribute('novalidate')&&!f.checkValidity())return; if(!d.name&&!d.email&&!d.phone)return;
   try{fetch(HOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});}catch(err){}
  },0);
},true);
})();</script></body>
</html>
