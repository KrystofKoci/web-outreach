<figure class="karta-fan"><span class="foto"><img alt="A monstera with large split leaves in a white stoneware pot" decoding="async" height="1350" loading="lazy" src="{{ A }}img/V08-kvetiny-fan-13.webp" width="900"/></span><figcaption><span class="co">Monstera</span><span class="veta">Big leaves, grows wide.</span></figcaption></figure>
