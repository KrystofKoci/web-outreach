  (function () {
    var b = document.querySelector('.menu-tl'), p = document.getElementById('menu');
    b.addEventListener('click', function () { var o = p.hidden; p.hidden = !o; b.setAttribute('aria-expanded', o ? 'true' : 'false'); });
  })();

  /* Kyvadlo: θ'' = −ω²·sin θ − c·θ' + popostrčení od myši. Strop = horní hrana hero, takže šňůra vede až nahoru.
     Kužel uvnitř kobaltového pole je zvláštní vrstva oříznutá dlaždicí. Jeho vrchol leží v žárovce: žárovka je bod na ose lampy
     ve vzdálenosti L od stropu, při úhlu θ je v (střed − L·sin θ, −strop + L·cos θ); kužel se tam posune a otočí o θ kolem sebe. */
  (function () {
    var hero = document.getElementById('hero'), pole = document.getElementById('d-svetlo'), zaves = document.getElementById('zaves');
    var kv = document.getElementById('kuzel-v'), klik = document.getElementById('klik'), bento = document.getElementById('bento');
    var tvar = zaves.querySelector('.tvar'), vnitrek = document.getElementById('vnitrek'), zarovka = document.getElementById('zarovka');
    var q = new URLSearchParams(location.search);
    var pohyb = !matchMedia('(prefers-reduced-motion: reduce)').matches && q.get('pohyb') !== '0';
    var th = 0, om = 0, W2 = 7.5, C = 0.9, last = 0, bezi = false, mx = null, sviti = true;
    var mobil = matchMedia('(max-width: 760px)'), lista = document.querySelector('.lista');
    var geo = { stred: 0, strop: 0, L: 0 };

    function rozmer() {
      var hr = hero.getBoundingClientRect(), pr = pole.getBoundingClientRect();
      var strop = pr.top - hr.top;
      /* na mobilu leží lišta nad polem: šňůra začíná až pod ní */
      if (mobil.matches) strop = Math.max(16, pr.top - lista.getBoundingClientRect().bottom - 6);
      pole.style.setProperty('--strop', strop + 'px');
      /* žárovka v závěsu (bez rotace): .tvar → .vnitrek → střed .zarovka (posun −50 % je v transformu, offsetTop ukazuje střed) */
      geo.L = tvar.offsetTop + vnitrek.offsetTop + zarovka.offsetTop;
      geo.stred = pole.clientWidth / 2;   /* osa závěsu = střed pole (left: 50 %) */
      geo.strop = strop;
      /* délka kužele: od žárovky ke spodku pole s rezervou na vychýlení */
      kv.style.setProperty('--kh', Math.round((pole.clientHeight + strop - geo.L) * 1.18) + 'px');
      nastav();
    }
    function nastav() {
      var d = th * 57.2958;
      zaves.style.setProperty('--uhel', d.toFixed(2) + 'deg');
      var bx = geo.stred - geo.L * Math.sin(th), by = -geo.strop + geo.L * Math.cos(th);
      kv.style.transform = 'translate(' + bx.toFixed(2) + 'px,' + by.toFixed(2) + 'px) rotate(' + d.toFixed(2) + 'deg)';
    }
    function krok(t) {
      var dt = Math.min(0.033, (t - last) / 1000 || 0.016); last = t;
      /* měkký doraz: útlum roste s výchylkou a za 0,22 rad přidá pružina navíc – lampa se zastaví plynule, ne o zarážku */
      var tlum = C + 140 * th * th;
      var doraz = Math.abs(th) > 0.2 ? -W2 * 16 * (th - (th > 0 ? 0.2 : -0.2)) : 0;
      om += (-W2 * Math.sin(th) - tlum * om + doraz) * dt; th += om * dt;
      if (Math.abs(th) > 0.45) { th = th > 0 ? 0.45 : -0.45; om *= -0.25; }   /* jen pojistka, v praxi se nedosáhne */
      nastav();
      if (Math.abs(th) > 0.0008 || Math.abs(om) > 0.002) requestAnimationFrame(krok); else { th = 0; om = 0; nastav(); bezi = false; }
    }
    function postrc(v) { om = Math.max(-2, Math.min(2, om + v)); if (!bezi) { bezi = true; last = performance.now(); requestAnimationFrame(krok); } }

    /* myš: rychlost vodorovného pohybu poblíž stínidla roztlačí lampu */
    hero.addEventListener('pointermove', function (e) {
      if (e.pointerType !== 'mouse') return;
      var r = zaves.getBoundingClientRect();
      var cx = r.left + r.width / 2, cy = r.bottom - r.width * .2;
      if (mx !== null) {
        var vx = e.clientX - mx;
        var dist = Math.hypot(e.clientX - cx, (e.clientY - cy) * 1.4);
        var blizko = Math.max(0, 1 - dist / 360);
        if (blizko > 0 && Math.abs(vx) > 0.5) postrc(Math.max(-0.5, Math.min(0.5, vx * blizko * 0.022)));
      }
      mx = e.clientX;
    });
    hero.addEventListener('pointerleave', function () { mx = null; });
    /* dotyk: šťouchnutí do pole roztlačí lampu */
    pole.addEventListener('pointerdown', function (e) { if (e.pointerType !== 'mouse') { var r = pole.getBoundingClientRect(); postrc((e.clientX < r.left + r.width / 2 ? 1 : -1) * 1.1); } });

    function svetlo(on) {
      sviti = on;
      [pole, zaves, bento, hero].forEach(function (el) { el.style.setProperty('--sviti', on ? 1 : 0); });
      klik.setAttribute('aria-pressed', on ? 'true' : 'false');
      klik.setAttribute('aria-label', on ? 'Lampa: zhasnout' : 'Lampa: rozsvítit');
    }
    klik.addEventListener('click', function () { svetlo(!sviti); postrc((Math.random() > .5 ? 1 : -1) * .5); });

    window.addEventListener('resize', rozmer);
    if ('ResizeObserver' in window) new ResizeObserver(rozmer).observe(pole);
    var start = function () { rozmer(); svetlo(true); if (pohyb) setTimeout(function () { postrc(-1.15); }, 700); };
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(start); else start();
    rozmer();
  })();
</script>
<script>
  /* Dotazník: ukázka – kontrola povinných polí, fokus na první chybné, nic se neodesílá. */
  (function () {
    var f = document.querySelector('[data-formular="dotaz"]'), h = document.getElementById('hlaska');
    function chyba(el, ano) {
      el.setAttribute('aria-invalid', ano ? 'true' : 'false');
      document.getElementById(el.getAttribute('aria-describedby')).hidden = !ano;
    }
    function spatne(el) {
      var v = el.value.trim();
      if (el.required && !v) return true;
      if (el.type === 'email' && v && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(v)) return true;
      return false;
    }
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var prvni = null;
      f.querySelectorAll('input, textarea').forEach(function (el) { var s = spatne(el); chyba(el, s); if (s && !prvni) prvni = el; });
      if (prvni) { prvni.focus(); h.classList.remove('ukazka'); h.textContent = 'Doplňte prosím označená pole.'; return; }
      h.classList.add('ukazka'); h.textContent = 'Děkujeme, ozveme se vám co nejdříve.';
    });
    f.addEventListener('input', function (e) { if (e.target.getAttribute('aria-invalid') === 'true' && !spatne(e.target)) chyba(e.target, false); });
  })();
</script>
