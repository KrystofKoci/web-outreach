<!DOCTYPE html>

<html lang="cs">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<script>
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  h.dataset.tema=(q.get('tema')==='tmava'||location.hash==='#tmava')?'tmava':'svetla';
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0')h.classList.add('pohyb');})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Archivo:wght@400;500;600;700&amp;family=IBM+Plex+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V11 Nadpis + mřížka karet – elektrikář Fáze.
     Světlá: vlevo velký nadpis, vpravo bento „kdy volat“; v kobaltovém poli visí lampa ze stropu a její stínidlo přesahuje přes horní hranu pole.
     Dlaždice jsou plné: detail jističů a měřáku (fotky, ne ikony), široká inkoustová dlaždice s textem.
     Tmavá: noční modročerná, lampa svítí teplým žlutým kuželem; světlo se přelévá na spodní část sousední dlaždice a pod nadpis (nikdy nad žárovku).
     Světlo vychází ze žárovky: uvnitř stínidla svítí žárovka a nasvícený vnitřek, úzký vrchol kužele leží přesně v žárovce a kužel se rozšiřuje dolů.
     Podpisový pohyb: lampa se za kurzorem rozhoupe (kyvadlo s útlumem) a kužel se otáčí kolem žárovky (posun s ní + stejný úhel); klik na lampu zhasne / rozsvítí.
     Houpání řídí myš, takže funguje i s omezenými animacemi (jen bez samovolného pohoupnutí po načtení). */
  :root {
    --pozadi:#EDECE6; --plocha:#F7F6F1; --text:#15161A; --tlumeny:#55565C; --linka:rgba(21,22,26,.13);
    --kobalt:#1546D9; --na-kobaltu:#FFFFFF; --na-kobaltu-tl:rgba(255,255,255,.78);
    --inkoust:#15161A; --na-inkoustu:#EDECE6; --na-inkoustu-tl:rgba(237,236,230,.7);
    --akcent:#F9B318; --na-akcentu:#15161A; --stopa:#9DB2EE;
    --kuzel: rgba(255,238,196,.9); --kuzel-2: rgba(255,206,110,.2); --halo: rgba(255,214,120,.14); --k-stop: 26%; --k-konec: 58%;
    --vnitrek-1: rgba(255,236,190,.85); --vnitrek-2: rgba(255,214,140,.32); --zarovka: #FFFBEF;
    --rozliti: rgba(249,179,24,0); --hrana-svetla: rgba(249,179,24,0); --na-nadpis: rgba(249,179,24,0);
    --lampa: drop-shadow(0 20px 18px rgba(10,20,60,.28));
    --foto: none; --linka-pole: rgba(21,22,26,.45);
  }
  html[data-tema="tmava"] {
    --pozadi:#090B12; --plocha:#10131C; --text:#ECEBE5; --tlumeny:#9C9EA7; --linka:rgba(236,235,229,.12);
    --kobalt:#1B3FB8; --na-kobaltu:#FFFFFF; --na-kobaltu-tl:rgba(255,255,255,.8);
    --inkoust:#ECEBE5; --na-inkoustu:#10131C; --na-inkoustu-tl:rgba(16,19,28,.72);
    --akcent:#F9B318; --na-akcentu:#15161A; --stopa:#2F4590;
    --kuzel: rgba(255,204,96,.8); --kuzel-2: rgba(249,179,24,.3); --halo: rgba(249,179,24,.24); --k-stop: 38%; --k-konec: 84%;
    --vnitrek-1: rgba(255,214,130,.95); --vnitrek-2: rgba(249,179,24,.42); --zarovka: #FFF6DC;
    --rozliti: rgba(249,179,24,.16); --hrana-svetla: rgba(249,179,24,.16); --na-nadpis: rgba(249,179,24,.07);
    /* obrys stínidla jen chladným odleskem okolí (teplé světlo patří jen pod žárovku, ne kolem horní části lampy) */
    --lampa: brightness(.85) drop-shadow(0 0 1px rgba(150,172,255,.45)) drop-shadow(0 20px 22px rgba(0,0,0,.6));
    --foto: brightness(.86) contrast(1.05); --linka-pole: rgba(236,235,229,.42);
  }
  body { background: var(--pozadi); color: var(--text); font-family: "Archivo", system-ui, sans-serif; font-size: 16px; line-height: 1.5; }
  .mono { font-family: "IBM Plex Mono", ui-monospace, monospace; font-size: 11px; letter-spacing: .05em; text-transform: uppercase; }
  .doplnit { color: var(--tlumeny); }

  /* ---------- lišta: pilulková skupina vlevo, telefon a téma vpravo ---------- */
  .lista { position: absolute; z-index: 30; top: 18px; left: clamp(16px, 2.4vw, 36px); right: clamp(16px, 2.4vw, 36px); display: flex; align-items: center; justify-content: space-between; pointer-events: none; }
  .lista > * { pointer-events: auto; }
  .skupina { display: flex; align-items: center; gap: 4px; padding: 4px; border-radius: 999px; background: var(--plocha); border: 1px solid var(--linka); }
  .logo { display: inline-flex; align-items: center; gap: 8px; height: 38px; padding: 0 16px 0 12px; border-radius: 999px; background: var(--kobalt); color: var(--na-kobaltu); font-weight: 700; font-size: 17px; letter-spacing: -.03em; }
  .logo svg { width: 22px; height: 12px; }
  .skupina a.o { height: 38px; padding: 0 14px; display: inline-flex; align-items: center; font-size: 14px; color: var(--tlumeny); border-radius: 999px; }
  .skupina a.o:hover { color: var(--text); }
  .vpravo { display: flex; align-items: center; gap: 8px; }
  .tel { height: 46px; display: inline-flex; align-items: center; padding: 0 18px; border-radius: 999px; background: var(--plocha); border: 1px solid var(--linka); font-size: 14px; }
  .tel:hover { color: var(--tlumeny); }
  .tema-prepinac { width: 46px; height: 46px; background: var(--plocha); }
  .menu-tl { display: none; height: 46px; padding: 0 16px; border-radius: 999px; background: var(--plocha); border: 1px solid var(--linka); align-items: center; gap: 8px; font-size: 14px; }
  .menu-tl i { display: block; width: 16px; height: 1px; background: currentColor; box-shadow: 0 5px 0 currentColor; transform: translateY(-2.5px); }
  .menu-panel { position: absolute; top: 56px; right: 0; left: 0; z-index: 40; flex-direction: column; gap: 2px; padding: 8px; border-radius: 22px; background: var(--plocha); border: 1px solid var(--linka); box-shadow: 0 24px 50px -28px rgba(0,0,0,.45); }
  .menu-panel:not([hidden]) { display: flex; }
  .menu-panel a { padding: 13px 16px; border-radius: 14px; font-size: 16px; }
  .menu-panel .tel-m { margin-top: 6px; background: var(--akcent); color: var(--na-akcentu); border-radius: 999px; display: flex; justify-content: space-between; font-weight: 500; }
  .menu-panel .tel-m .doplnit { color: inherit; }
  .menu-panel .tel-m:focus-visible { outline-color: var(--text); }

  /* ---------- hero ---------- */
  /* tmavá: odlesk lampy se rozlévá pod úrovní žárovky (vlevo dole od pole), nikdy nad ní */
  .hero::before { content: ""; position: absolute; left: 0; top: 0; width: 60%; height: 100%; pointer-events: none; z-index: 1;
    background: radial-gradient(50% 42% at 92% 70%, var(--na-nadpis), transparent); opacity: var(--sviti, 1); transition: opacity .5s; }
  .hero { position: relative; min-height: max(100svh, 700px); display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(20px, 2.4vw, 36px);
    padding: 110px clamp(16px, 2.4vw, 36px) clamp(16px, 2.4vw, 36px); overflow: hidden; isolation: isolate; --stopa-z: 2; }
  .levy { display: flex; flex-direction: column; justify-content: space-between; padding: 12px 0 6px; position: relative; z-index: 3; }
  .hero h1 { font-weight: 700; font-size: clamp(3rem, 5.6vw, 6.2rem); line-height: .95; letter-spacing: -.05em; }
  .hero h1 .tl { color: var(--tlumeny); font-weight: 400; }
  .uvod { margin-top: 26px; max-width: 26em; color: var(--tlumeny); font-size: 17px; }
  .cta { margin-top: 30px; height: 58px; display: inline-flex; align-items: center; padding: 0 8px 0 26px; border-radius: 999px; background: var(--akcent); color: var(--na-akcentu); font-weight: 600; font-size: 16px; }
  .cta [data-magnet-vnitrek] { align-items: center; gap: 16px; }
  .cta .kruh { width: 42px; height: 42px; border-radius: 50%; display: grid; place-items: center; background: rgba(21,22,26,.1); }
  .cta svg { width: 16px; height: 16px; }
  .spodek { display: flex; gap: 28px; flex-wrap: wrap; color: var(--tlumeny); }
  .spodek span span { color: var(--text); }

  /* bento */
  .bento { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, 1fr); grid-template-rows: minmax(0, 1fr) minmax(0, 1fr) auto; gap: 12px; }
  .dlazdice { position: relative; border-radius: 22px; padding: clamp(20px, 2vw, 28px); display: flex; flex-direction: column; justify-content: flex-end; background: var(--plocha); border: 1px solid var(--linka); transition: background-color .3s; }
  .dlazdice h2 { font-weight: 600; font-size: clamp(1.25rem, 1.65vw, 1.6rem); line-height: 1.12; letter-spacing: -.03em; }
  .dlazdice p { margin-top: 8px; font-size: 15px; color: var(--tlumeny); max-width: 24em; }
  a.dlazdice:hover { background: color-mix(in srgb, var(--plocha) 70%, var(--pozadi)); }
  .bento a.dlazdice:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; border-radius: 22px; }
  /* dlaždice s fotkou: detail přes celou šířku nahoře, text pod ním */
  .s-fotkou { justify-content: flex-start; padding: 8px 8px clamp(18px, 1.8vw, 24px); overflow: hidden; }
  .s-fotkou .foto { flex: 1 1 auto; min-height: 110px; margin: 0 0 16px; border-radius: 15px; overflow: hidden; position: relative; }
  .s-fotkou .foto img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; filter: var(--foto); transition: transform .6s cubic-bezier(.2,.7,.1,1); }
  .s-fotkou:hover .foto img { transform: scale(1.03); }
  .s-fotkou h2, .s-fotkou p { padding: 0 clamp(12px, 1.2vw, 18px); }
  /* tmavá: světlo lampy dopadá na levou hranu sousední dlaždice – až pod úrovní žárovky, směrem dolů sílí */
  .d-b::after { content: ""; position: absolute; inset: 0; border-radius: inherit; pointer-events: none;
    background: linear-gradient(90deg, var(--hrana-svetla), transparent 38%); opacity: var(--sviti, 1); transition: opacity .5s;
    -webkit-mask-image: linear-gradient(180deg, transparent 28%, #000 88%); mask-image: linear-gradient(180deg, transparent 28%, #000 88%); }
  .d-svetlo { grid-row: 1 / 3; background: var(--kobalt); border-color: transparent; color: var(--na-kobaltu); overflow: visible; isolation: isolate; }
  .d-svetlo p, .d-svetlo .mono { color: var(--na-kobaltu-tl); }
  .d-svetlo .obsah { position: relative; z-index: 3; }
  .d-svetlo .pole-svetla { position: absolute; inset: 0; border-radius: inherit; overflow: hidden; z-index: 0; pointer-events: none; }
  .d-sire { grid-column: 1 / 3; flex-direction: row; align-items: flex-end; justify-content: space-between; gap: 30px; background: var(--inkoust); color: var(--na-inkoustu); border-color: transparent; }
  .d-sire p, .d-sire .mono { color: var(--na-inkoustu-tl); }
  .d-sire .mono { margin: 0; text-align: right; }
  /* světlo přetéká na sousední dlaždice (jen tmavá) */
  .bento::before { content: ""; position: absolute; left: 10%; top: 20%; width: 80%; height: 70%; border-radius: 50%; z-index: -1; pointer-events: none;
    background: radial-gradient(closest-side, var(--rozliti), transparent); opacity: var(--sviti, 1); transition: opacity .5s; }

  /* závěs: od stropu (horní hrana hero) přes šňůru ke stínidlu, otáčí se kolem stropu */
  .zaves { position: absolute; z-index: 4; left: 50%; top: calc(-1 * var(--strop)); width: var(--lw); height: calc(var(--strop) + var(--lw) * .36);
    margin-left: calc(var(--lw) / -2); transform-origin: 50% 0; transform: rotate(var(--uhel, 0deg)); will-change: transform; --lw: min(68%, 300px);
    clip-path: inset(0 -60% -60% -60%); /* šňůra z fotky nesmí přesáhnout nad strop (na mobilu přes lištu) */ }
  .zaves .snura { position: absolute; left: calc(50% - .75px); top: 0; width: 1.5px; bottom: calc(var(--lw) * 1.2); background: #1A1C22; }
  .zaves img { position: absolute; left: 0; bottom: 0; width: 100%; height: auto; filter: var(--lampa); cursor: pointer; pointer-events: none; }
  .zaves .klik { position: absolute; left: 0; right: 0; bottom: 0; height: calc(var(--lw) * .66); cursor: pointer; border-radius: 40% 40% 10% 10%; pointer-events: auto; }
  .zaves .klik:focus-visible { outline: 2px solid var(--na-kobaltu); outline-offset: 4px; }
  /* žárovka a nasvícený vnitřek stínidla. .tvar = přesně plocha obrázku lampy (1500 × 1948), procenta jsou souřadnice v něm:
     otvor stínidla = elipsa se středem y 1745 a poloosami 735 × 188 px; spodek žárovky vykukuje v horní části otvoru (y 1600),
     horní půlku baňky zakrývá přední stěna stínidla. Skript bere polohu žárovky odsud (.zarovka), takže kužel sedí vždy na ní. */
  .zaves .tvar { position: absolute; left: 0; bottom: 0; width: 100%; aspect-ratio: 1500 / 1948; pointer-events: none; }
  .zaves .vnitrek { position: absolute; left: 1%; width: 98%; top: 79.93%; height: 19.3%; border-radius: 50%; overflow: hidden; mix-blend-mode: screen;
    background: radial-gradient(46% 80% at 50% 11%, var(--vnitrek-1), var(--vnitrek-2) 46%, transparent 100%); opacity: var(--sviti, 1); transition: opacity .3s; }
  .zaves .zarovka { position: absolute; left: 50%; top: 11.45%; width: 19%; height: 64%; transform: translate(-50%, -50%); border-radius: 50%;
    background: radial-gradient(closest-side, var(--zarovka) 34%, rgba(255,226,160,.75) 62%, rgba(255,200,110,0)); }
  /* kužel světla v kobaltovém poli (oříznutý dlaždicí): vrchol přesně v žárovce, rozšiřuje se dolů.
     Skript ho posune do žárovky a otočí o úhel lampy kolem ní (transform), takže zůstane napojený v každém úhlu.
     Jádro = ostrá hrana (malé rozmazání), halo = měkká širší záře; obojí teplé ve screen. --k-jadro / --k-halo = tangens polovičního úhlu. */
  .pole-svetla .kuzel-v { position: absolute; left: 0; top: 0; width: 0; height: 0; transform-origin: 0 0; will-change: transform;
    --k-jadro: .6; --k-halo: 1.15; mix-blend-mode: screen; opacity: var(--sviti, 1); transition: opacity .35s; }
  /* filtr musí být na obalu (filtr se počítá před clip-path), ořez tvaru je až uvnitř */
  .pole-svetla .kuzel-v i { position: absolute; display: block; top: 0; height: var(--kh, 640px); }
  .pole-svetla .kuzel-v i::before { content: ""; position: absolute; inset: 0; clip-path: polygon(50% 0, 100% 100%, 0 100%); }
  .pole-svetla .kuzel-v .jadro { left: calc(var(--kh, 640px) * var(--k-jadro) * -1); width: calc(var(--kh, 640px) * var(--k-jadro) * 2); filter: blur(2.5px); }
  .pole-svetla .kuzel-v .jadro::before { background: linear-gradient(180deg, var(--kuzel) 0%, var(--kuzel-2) var(--k-stop), transparent var(--k-konec)); }
  .pole-svetla .kuzel-v .halo { left: calc(var(--kh, 640px) * var(--k-halo) * -1); width: calc(var(--kh, 640px) * var(--k-halo) * 2); filter: blur(20px); }
  .pole-svetla .kuzel-v .halo::before { background: linear-gradient(180deg, var(--halo), transparent 75%); }

  /* ---------- služby ---------- */
  .sluzby { padding: clamp(80px, 9vw, 130px) clamp(16px, 2.4vw, 36px) 120px; max-width: 1400px; margin: 0 auto; }
  .sluzby h2 { font-weight: 600; font-size: clamp(2rem, 3.2vw, 3rem); line-height: 1.05; letter-spacing: -.035em; margin-bottom: clamp(28px, 4vw, 50px); max-width: 16em; }
  .radky { border-top: 1px solid var(--linka); }
  .radky li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr); gap: 24px; align-items: baseline; padding: 24px 0 26px; border-bottom: 1px solid var(--linka); }
  .radky h3 { font-weight: 500; font-size: clamp(1.3rem, 1.8vw, 1.6rem); letter-spacing: -.025em; }
  .radky p { color: var(--tlumeny); max-width: 36em; }
  .radky .cena { justify-self: end; color: var(--tlumeny); font-size: 14.5px; }

  /* dotazník na konci stránky */
  .dotaz { padding: 0 clamp(16px, 2.4vw, 36px) clamp(90px, 9vw, 130px); max-width: 1400px; margin: 0 auto; }
  .dotaz-mriz { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(30px, 5vw, 80px); align-items: start; padding: clamp(24px, 3vw, 44px); border-radius: 26px; background: var(--kobalt); color: var(--na-kobaltu); }
  .dotaz h2 { font-weight: 600; font-size: clamp(2rem, 3.2vw, 3rem); line-height: 1.05; letter-spacing: -.035em; }
  .dotaz-uvod p { margin-top: 18px; color: var(--na-kobaltu-tl); max-width: 26em; }
  .dotaz-uvod .mono { margin-top: 28px; color: var(--na-kobaltu-tl); }
  .dotaz-uvod .mono a { color: var(--na-kobaltu); }
  .formular { display: grid; grid-template-columns: 1fr 1fr; gap: 18px 16px; padding: clamp(20px, 2.2vw, 30px); border-radius: 20px; background: var(--plocha); color: var(--text); }
  .pole { display: flex; flex-direction: column; gap: 8px; }
  .pole.cela { grid-column: 1 / -1; }
  .pole label { font-size: 14.5px; font-weight: 500; }
  .pole label small { font-weight: 400; color: var(--tlumeny); font-size: 13.5px; }
  .pole input, .pole textarea { font: inherit; color: var(--text); background: var(--pozadi); border: 1px solid var(--linka-pole); border-radius: 14px; padding: 13px 16px; min-height: 50px; width: 100%; }
  .pole textarea { min-height: 140px; resize: vertical; line-height: 1.5; }
  .pole input::placeholder, .pole textarea::placeholder { color: var(--tlumeny); }
  .pole input:focus-visible, .pole textarea:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-radius: 14px; }
  .pole [aria-invalid="true"] { border-color: var(--text); border-width: 2px; }
  .chyba { font-size: 13.5px; display: flex; gap: 8px; align-items: center; }
  .chyba::before { content: ""; width: 8px; height: 8px; border-radius: 50%; background: var(--akcent); box-shadow: 0 0 0 1px rgba(21,22,26,.35); flex: none; }
  .chyba[hidden] { display: none; }
  .odeslat { grid-column: 1 / -1; display: flex; align-items: center; justify-content: space-between; gap: 18px; flex-wrap: wrap; margin-top: 4px; }
  .odeslat .cta { margin: 0; cursor: pointer; }
  .hlaska { color: var(--tlumeny); font-size: 14.5px; max-width: 26em; }
  .hlaska.ukazka { color: var(--text); }
  .dotaz a:focus-visible { outline-color: var(--na-kobaltu); }

  @media (max-width: 1279px) {
    .zaves { --lw: min(54%, 230px); }
  }
  @media (max-width: 1180px) {
    .skupina a.o { padding: 0 10px; }
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr); }
    .hero h1 { font-size: clamp(2.8rem, 5.6vw, 4.6rem); }
  }
  @media (max-width: 960px) {
    .skupina a.o, .tel { display: none; }
    .menu-tl { display: inline-flex; }
  }
  /* ---------- mobil: kobaltové pole s lampou nahoře, pod ním nadpis, ostatní dlaždice pod záhybem ---------- */
  @media (max-width: 760px) {
    .lista { top: 12px; left: 12px; right: 12px; }
    .hero { display: flex; flex-direction: column; padding: 122px 12px 16px; min-height: 100svh; gap: 0; }
    .bento { display: contents; }
    .bento::before { display: none; }
    /* odlesk pod polem přes celou šířku (60% box by na mobilu měl viditelnou svislou hranu) */
    .hero::before { width: 100%; background: radial-gradient(75% 24% at 50% 46%, var(--na-nadpis), transparent); }
    .d-svetlo { order: 1; height: 30svh; min-height: 210px; flex: none; }
    .d-svetlo .obsah { display: none; }
    .levy { order: 2; padding: 22px 4px 8px; gap: 0; }
    .hero h1 { font-size: clamp(2.4rem, 11vw, 3.2rem); }
    .uvod { margin-top: 14px; font-size: 15.5px; }
    .cta { margin-top: 20px; }
    .spodek { display: none; }
    .d-b, .d-c, .d-sire { order: 3; margin-top: 10px; }
    .s-fotkou .foto { flex: none; height: 150px; }
    .d-sire { flex-direction: column; align-items: flex-start; gap: 10px; }
    .d-sire .mono { text-align: left; }
    .zaves { --lw: min(46%, 180px); }
    .sluzby { padding: 70px 16px 90px; }
    .radky li { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .radky p { grid-column: 1 / -1; grid-row: 2; }
    .radky .cena { grid-column: 2; grid-row: 1; }
    .dotaz { padding: 0 12px 70px; }
    .dotaz-mriz { padding: 24px 12px 12px; border-radius: 22px; gap: 22px; }
    .dotaz-uvod { padding: 0 6px; }
    .formular { grid-template-columns: 1fr; padding: 18px; }
  }
  @media (max-width: 1000px) {
    .dotaz-mriz { grid-template-columns: 1fr; gap: 26px; }
  }
</style>
<style id="pz-css">
