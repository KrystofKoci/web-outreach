<!DOCTYPE html>

<html lang="cs">
<head>
<meta charset="utf-8"/>
<meta content="width=device-width, initial-scale=1" name="viewport"/>
<title>{{ page_title }}</title>
<script>
  (function(){var q=new URLSearchParams(location.search),h=document.documentElement;
  h.dataset.tema=(q.get('tema')==='tmava'||location.hash==='#tmava')?'tmava':'svetla';
  if(!matchMedia('(prefers-reduced-motion: reduce)').matches&&q.get('pohyb')!=='0')h.classList.add('pohyb');})();
</script>
<link href="https://fonts.googleapis.com" rel="preconnect"/>
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect"/>
<link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:wght@400;500;600&amp;family=DM+Mono:wght@400;500&amp;display=swap" rel="stylesheet"/>
<link href="{{ A }}zaklad.css" rel="stylesheet"/>
<style>
  /* V03 Vše na střed, vizuál dole – opravář Šroub
     Pod osou textu je pračka s předním plněním jako technická kresba v rozloženém pohledu (ručně psané SVG, 21 vrstev / 14 druhů dílů).
     Podpisový pohyb: při scrollu se díly po osách sjedou do sebe, vodicí linky a popisky zmizí, buben se protočí, štítek „Složeno a vyzkoušeno“.
     Světlá: papír + grafitový inkoust, plochy tónované barvou pozadí, signální oranžová jen na CTA, řemenu a štítku.
     Tmavá: světlé linky na grafitu, teplé světlo pracovní lampy za kresbou, horní plochy nasvícené shora. */
  :root {
    --pozadi:#F4F1EA; --plocha:#ECE7DD; --text:#1B1F24; --tlumeny:#5D5A53; --linka:rgba(27,31,36,.14);
    --akcent:#E8590C; --akcent-text:#1B1F24; --stopa:#B9AE9C;
    --cara:#1B1F24; --cara-j:rgba(27,31,36,.42); --tecky:rgba(27,31,36,.36); --lesk:rgba(27,31,36,.36);
    --v-cel:#F4F1EA; --v-vrch:#FAF8F4; --v-bok:#E8E3D9; --v-dut:#DDD6C9; --v-dut2:#D1C9BA; --v-tma:#BEB5A5; --v-sklo:rgba(203,209,209,.5);
    --lampa: radial-gradient(60% 52% at 50% 18%, rgba(255,255,255,.55), transparent 72%);
    --pilulka: rgba(27,31,36,.05);
    --pole-linka: #827C71;
  }
  html[data-tema="tmava"] {
    --pozadi:#121417; --plocha:#191C20; --text:#EDE8DF; --tlumeny:#9C978E; --linka:rgba(237,232,223,.14);
    --akcent:#F26A1F; --akcent-text:#121417; --stopa:#7C5A40;
    --cara:#E7E0D4; --cara-j:rgba(231,224,212,.42); --tecky:rgba(231,224,212,.26); --lesk:rgba(255,231,204,.62);
    --v-cel:#1E2125; --v-vrch:#2B2A27; --v-bok:#141619; --v-dut:#101214; --v-dut2:#0C0D0F; --v-tma:#07080A; --v-sklo:rgba(160,168,172,.14);
    /* světlo pracovní lampy za kresbou: teplý kužel shora, k okrajům tma */
    --lampa: radial-gradient(50% 40% at 50% 72%, rgba(255,186,128,.16), rgba(242,106,31,.05) 55%, transparent 80%),
             radial-gradient(40% 30% at 50% 22%, rgba(255,222,190,.05), transparent 70%);
    --pilulka: rgba(237,232,223,.06);
    --pole-linka: #75716A;
  }
  body { background: var(--pozadi); color: var(--text); font-family: "Schibsted Grotesk", system-ui, sans-serif; }
  .mono { font-family: "DM Mono", ui-monospace, monospace; font-size: 12px; letter-spacing: .02em; }
  .doplnit { color: var(--tlumeny); }

  /* ---------- lišta: logo vlevo, odkazy uprostřed, vpravo telefon a téma ---------- */
  .lista { position: absolute; inset: 0 0 auto 0; z-index: 20; height: 76px; display: grid; grid-template-columns: 1fr auto 1fr;
    align-items: center; padding: 0 clamp(20px, 3vw, 44px); }
  .logo { justify-self: start; font-weight: 600; font-size: 22px; letter-spacing: -.03em; display: inline-flex; align-items: center; gap: 9px; }
  .logo svg { width: 20px; height: 20px; }
  .odkazy { display: flex; gap: 30px; font-size: 15px; }
  .odkazy a { color: var(--tlumeny); }
  .odkazy a:hover, .odkazy a[aria-current] { color: var(--text); }
  .lista-vpravo { justify-self: end; display: flex; align-items: center; gap: 18px; font-size: 15px; }
  .tel b { font-weight: 500; }
  .tel:hover { color: var(--tlumeny); }
  .menu-tl { display: none; height: 40px; padding: 0 16px; border-radius: 999px; border: 1px solid color-mix(in srgb, currentColor 28%, transparent);
    align-items: center; gap: 9px; font-size: 14px; }
  .menu-tl i { display: block; width: 15px; height: 1.5px; background: currentColor; box-shadow: 0 5px 0 currentColor; transform: translateY(-2.5px); }
  .menu-panel { display: none; }

  /* ---------- hero ---------- */
  .hero { position: relative; min-height: max(100svh, 680px); overflow: hidden; isolation: isolate; text-align: center; --stopa-z: 4; }
  .hero::before { content: ""; position: absolute; inset: 0; background: var(--lampa); z-index: 0; pointer-events: none; }
  .osa { position: relative; z-index: 6; padding-top: clamp(110px, 14vh, 156px); width: min(92vw, 980px); margin: 0 auto; }
  .hero h1 { font-weight: 600; font-size: clamp(2.6rem, 5.2vw, 5rem); line-height: .98; letter-spacing: -.045em; text-wrap: balance; }
  .hero h1 .r2 { color: var(--tlumeny); font-weight: 500; }
  .hero h1 .sl-w { clip-path: inset(-.3em -.08em -.22em -.08em); }
  .podtext { margin: clamp(16px, 2.4vh, 24px) auto 0; max-width: 34em; font-size: clamp(15px, 1.15vw, 17px); line-height: 1.55; color: var(--tlumeny); }
  .cta-obal { margin-top: clamp(20px, 3vh, 30px); display: flex; justify-content: center; }
  .cta { display: inline-flex; align-items: center; height: 56px; padding: 0 7px 0 26px; border-radius: 999px; background: var(--akcent); color: var(--akcent-text);
    font-size: 16px; font-weight: 600; letter-spacing: -.005em; }
  .cta [data-magnet-vnitrek] { align-items: center; gap: 16px; }
  .cta .kruh { width: 42px; height: 42px; border-radius: 999px; background: var(--akcent-text); color: var(--akcent); display: grid; place-items: center; }
  .cta .kruh svg { width: 16px; height: 16px; }

  /* drobné údaje v dolních rozích hero, nad hranou listu služeb */
  .bok { position: absolute; z-index: 6; bottom: 58px; text-align: left; line-height: 1.6; color: var(--tlumeny); }
  .bok b { display: block; color: var(--text); font-weight: 500; }
  .bok.l { left: clamp(20px, 3vw, 44px); }
  .bok.p { right: clamp(20px, 3vw, 44px); text-align: right; }

  /* technická kresba: SVG přes celé hero, kořenovou skupinu posouvá a škáluje skript (kamera), díly mají vlastní posun */
  .vykres { position: absolute; inset: 0; z-index: 3; pointer-events: none; }
  .vykres:not(.pripraveno) { opacity: 0; }
  .vykres-svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }
  .vykres-svg path, .vykres-svg circle { vector-effect: non-scaling-stroke; fill: none; stroke-linejoin: round; stroke-linecap: round; }
  .vykres-svg .k { stroke: var(--cara); stroke-width: 1.5; }
  .vykres-svg .h { stroke: var(--cara); stroke-width: 1; }
  .vykres-svg .j { stroke: var(--cara-j); stroke-width: 1; }
  .vykres-svg .tecky { stroke: var(--tecky); stroke-width: 1.4; stroke-dasharray: 0 3.2; }
  .vykres-svg .lesk { stroke: var(--lesk); stroke-width: 1.1; }
  .vykres-svg .a { stroke: var(--akcent); stroke-width: 1.5; }
  .vykres-svg .a[data-zadni] { stroke-width: 1; opacity: .55; }
  .vykres-svg .fc { fill: var(--v-cel); } .vykres-svg .fv { fill: var(--v-vrch); } .vykres-svg .fb { fill: var(--v-bok); }
  .vykres-svg .fd { fill: var(--v-dut); } .vykres-svg .fd2 { fill: var(--v-dut2); } .vykres-svg .ft { fill: var(--v-tma); } .vykres-svg .fs { fill: var(--v-sklo); }
  .vykres-svg .vod { stroke: var(--cara-j); stroke-width: 1; stroke-dasharray: 3 4; }
  .vykres-svg .vod.osa { stroke-dasharray: 16 4 2 4; }
  .vykres-svg .popisek text { font-family: "DM Mono", ui-monospace, monospace; fill: var(--tlumeny); letter-spacing: .02em; }
  .vykres-svg .popisek circle { fill: var(--cara); stroke: none; }
  .vykres-svg .popisek path { stroke: var(--cara-j); stroke-width: 1; }
  .stitek { position: absolute; z-index: 5; left: 0; top: 0; display: flex; align-items: center; gap: 10px; opacity: 0; color: var(--text); white-space: nowrap; }
  .stitek::before { content: ""; width: 54px; height: 1px; background: currentColor; opacity: .5; }
  .stitek i { width: 8px; height: 8px; border-radius: 99px; background: var(--akcent); box-shadow: 0 0 0 4px color-mix(in srgb, var(--akcent) 22%, transparent); }

  /* ---------- služby ---------- */
  /* služby jako list přes spodek hero */
  .list { position: relative; z-index: 8; margin-top: -32px; background: var(--plocha); border-radius: 32px 32px 0 0;
    box-shadow: 0 -1px 0 var(--linka), 0 -24px 48px -28px rgba(40,30,20,.25); }
  .sluzby { padding: clamp(64px, 8vw, 112px) clamp(20px, 3vw, 44px) clamp(64px, 7vw, 96px); max-width: 1352px; margin: 0 auto; }
  .sluzby-hlava { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 4fr); gap: 32px; align-items: end; margin-bottom: clamp(30px, 4vw, 56px); }
  .sluzby h2 { font-weight: 600; font-size: clamp(2rem, 3.4vw, 3.1rem); line-height: 1.04; letter-spacing: -.035em; }
  .sluzby-hlava p { color: var(--tlumeny); font-size: 16px; line-height: 1.6; max-width: 30em; }
  .radky { border-top: 1px solid var(--linka); }
  .radky li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 6fr) minmax(0, 2fr); gap: 24px; align-items: baseline; padding: 26px 0 28px; border-bottom: 1px solid var(--linka); }
  .radky h3 { font-weight: 500; font-size: clamp(1.3rem, 1.8vw, 1.6rem); letter-spacing: -.025em; }
  .radky p { color: var(--tlumeny); font-size: 16px; line-height: 1.55; max-width: 36em; }
  .radky .cena { justify-self: end; color: var(--tlumeny); }

  /* ---------- objednání a dotaz ---------- */
  .obal { max-width: 1352px; margin: 0 auto; padding: 0 clamp(20px, 3vw, 44px); }
  .objednat { padding: clamp(24px, 3vw, 40px) 0 clamp(80px, 9vw, 128px); }
  .objednat h2, .hodnoceni h2 { font-weight: 600; font-size: clamp(2rem, 3.4vw, 3.1rem); line-height: 1.04; letter-spacing: -.035em; }
  .objednat-mrizka { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); gap: clamp(32px, 5vw, 88px); align-items: start; }
  .objednat-uvod { color: var(--tlumeny); font-size: 16px; line-height: 1.6; max-width: 30em; margin: 18px 0 clamp(26px, 3vw, 40px); }
  .postup { border-top: 1px solid var(--linka); }
  .postup li { padding: 22px 0 24px; border-bottom: 1px solid var(--linka); }
  .postup h3 { font-weight: 500; font-size: clamp(1.2rem, 1.6vw, 1.4rem); letter-spacing: -.02em; }
  .postup p { margin-top: 6px; color: var(--tlumeny); font-size: 16px; line-height: 1.55; max-width: 34em; }
  .udaje { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 18px; margin-top: 30px; line-height: 1.6; }
  .udaje dt { color: var(--tlumeny); }
  .udaje dd { font-weight: 500; }
  .udaje a:hover { color: var(--tlumeny); }

  .formular { background: var(--pozadi); border: 1px solid var(--linka); border-radius: 28px; padding: clamp(22px, 3vw, 40px); }
  .formular h3 { font-weight: 600; font-size: clamp(1.35rem, 1.9vw, 1.7rem); letter-spacing: -.025em; margin-bottom: 22px; }
  .pole-rada { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .pole { display: flex; flex-direction: column; gap: 7px; margin-bottom: 16px; }
  .pole label, .pole .stitek-pole { font-size: 14px; font-weight: 500; }
  .pole label small, .pole .stitek-pole small { font-weight: 400; color: var(--tlumeny); font-size: 13px; }
  .pole input, .pole select, .pole textarea { font: inherit; font-size: 16px; color: var(--text); background: var(--plocha);
    border: 1px solid var(--pole-linka); border-radius: 14px; padding: 12px 14px; width: 100%; }
  .pole select { appearance: none; padding-right: 40px;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position: calc(100% - 20px) 52%, calc(100% - 15px) 52%; background-size: 5px 5px; background-repeat: no-repeat; }
  .pole textarea { min-height: 128px; resize: vertical; line-height: 1.5; }
  /* výběr fotky: nativní input je skrytý (prohlížeč by psal anglicky), ovládá se českým tlačítkem-labelem */
  .soubor { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }
  .soubor input { position: absolute; width: 1px; height: 1px; opacity: 0; overflow: hidden; clip-path: inset(50%); }
  .soubor .vybrat { display: inline-flex; align-items: center; height: 40px; padding: 0 18px; border-radius: 999px; border: 1px solid var(--pole-linka);
    font-size: 14px; font-weight: 500; cursor: pointer; }
  .soubor .vybrat:hover { border-color: var(--text); }
  .soubor input:focus-visible + .vybrat { outline: 2px solid var(--text); outline-offset: 2px; }
  .soubor .nazev { font-size: 14px; color: var(--tlumeny); min-width: 0; overflow-wrap: anywhere; }
  .pole input:focus-visible, .pole select:focus-visible, .pole textarea:focus-visible { outline: 2px solid var(--text); outline-offset: 2px; border-color: var(--text); }
  .odeslat { display: inline-flex; align-items: center; gap: 14px; height: 52px; padding: 0 6px 0 24px; border-radius: 999px; border: 0; cursor: pointer;
    background: var(--akcent); color: var(--akcent-text); font: inherit; font-size: 16px; font-weight: 600; margin-top: 6px; }
  .odeslat .kruh { width: 40px; height: 40px; border-radius: 999px; background: var(--akcent-text); color: var(--akcent); display: grid; place-items: center; }
  .odeslat .kruh svg { width: 16px; height: 16px; }
  .odeslat:focus-visible { outline: 2px solid var(--text); outline-offset: 4px; }
  .hlaska { margin-top: 16px; font-size: 15px; line-height: 1.5; }
  .hlaska:empty { display: none; }
  .hlaska:not(:empty) { padding: 12px 16px; border-radius: 14px; background: var(--pilulka); border: 1px solid var(--linka); }

  /* ---------- hodnocení Google: úplně dole, na střed ---------- */
  .hodnoceni { border-top: 1px solid var(--linka); padding: clamp(64px, 8vw, 104px) 0; text-align: center; }
  .hodnoceni h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); }
  .znamka { margin-top: 20px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .hvezdy { position: relative; display: inline-block; height: 26px; width: 150px; color: var(--text); }
  .hvezdy svg { position: absolute; inset: 0; width: 150px; height: 26px; }
  .hvezdy .plne { position: absolute; inset: 0; overflow: hidden; width: calc(var(--hodnota, 0) / 5 * 100%); }
  .znamka-cislo { font-size: 18px; font-weight: 500; }
  .znamka-pocet { color: var(--tlumeny); font-size: 15px; }
  .znamka-pocet[hidden] { display: none; }

  /* ---------- patička ---------- */
  .pata { border-top: 1px solid var(--linka); padding: 36px 0 44px; }
  .pata .obal { display: flex; flex-wrap: wrap; align-items: baseline; gap: 14px 44px; color: var(--tlumeny); font-size: 14px; line-height: 1.6; }
  .pata .logo { color: var(--text); font-size: 20px; margin-right: auto; }
  .pata b { color: var(--text); font-weight: 500; margin-right: 8px; }

  /* ---------- mobil ---------- */
  @media (max-width: 900px) {
    .odkazy { gap: 20px; }
    /* na užších šířkách leží rohy přes díly: dostanou podklad v barvě stolu */
    .bok { bottom: 50px; padding: 7px 12px; border-radius: 14px; background: color-mix(in srgb, var(--pozadi) 90%, transparent); line-height: 1.45; }
    .bok.l { left: 14px; } .bok.p { right: 14px; }
  }
  @media (max-width: 760px) {
    .lista { grid-template-columns: 1fr auto; height: 68px; }
    .odkazy, .lista-vpravo .tel { display: none; }
    .menu-tl { display: inline-flex; }
    .lista-vpravo { gap: 8px; }
    .menu-panel { position: absolute; top: 100%; right: 20px; flex-direction: column; gap: 2px; padding: 6px; border-radius: 24px; background: var(--pozadi); border: 1px solid var(--linka); min-width: 210px; text-align: left; }
    .menu-panel.otevreno { display: flex; }
    .menu-panel a { padding: 11px 16px; border-radius: 999px; font-size: 15px; }
    .osa { padding-top: 104px; }
    .hero h1 { font-size: clamp(2.4rem, 11vw, 3.4rem); line-height: 1; }
    .stitek::before { display: none; }
    .sluzby-hlava { grid-template-columns: 1fr; }
    .radky li { grid-template-columns: 1fr auto; gap: 6px 16px; }
    .radky p { grid-column: 1 / -1; grid-row: 2; }
    .radky .cena { grid-column: 2; grid-row: 1; }
    .objednat-mrizka, .pole-rada { grid-template-columns: 1fr; gap: 0; }
    .objednat-mrizka { gap: 36px; }
    .udaje { grid-template-columns: 1fr 1fr; }
    .pata .logo { margin-right: 0; flex-basis: 100%; }
  }
</style>
<style id="pz-css">
.pz-hod{padding:clamp(56px,9vw,104px) 24px;text-align:center;color:inherit;border-top:1px solid color-mix(in srgb,currentColor 14%,transparent)}
