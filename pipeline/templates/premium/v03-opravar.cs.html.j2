</div>
</div>
</section>{% endif %}
</div>
</main>
<footer class="pata" id="kontakt">
<div class="obal">
<a aria-label="{{ brand }} – zpět nahoru" class="logo" href="#"><svg aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.6" viewbox="0 0 20 20"><circle cx="10" cy="10" r="8.2"></circle><path d="M6.2 10h7.6M10 6.2v7.6"></path></svg>{{ brand }}</a>
{% if address %}<p><b>Adresa</b>{{ address }}</p>{% endif %}

{% if phone %}<p><b>Telefon</b>{{ phone }}</p>{% endif %}
</div>
</footer>
<script>
  (function(){ var b=document.querySelector('.menu-tl'), p=document.getElementById('menu-panel');
    b.addEventListener('click', function(){ var o=p.classList.toggle('otevreno'); b.setAttribute('aria-expanded', o?'true':'false'); });
  })();
  /* Dotaz: ukázka, nic se neodesílá. */
  (function(){ var f=document.getElementById('dotaz'), h=f.querySelector('.hlaska');
    var fi=document.getElementById('f-foto'), fn=f.querySelector('.soubor .nazev');
    fi.addEventListener('change', function(){ fn.textContent=fi.files.length?fi.files[0].name:'Zatím žádná'; });
    f.addEventListener('submit', function(e){ e.preventDefault();
      var chybi=Array.prototype.filter.call(f.querySelectorAll('[required]'), function(i){ return !i.value.trim(); });
      if(chybi.length){ h.textContent='Vyplňte prosím jméno, kontakt a popis závady.'; chybi[0].focus(); return; }
      h.textContent='Děkujeme, ozveme se vám co nejdříve.'; }); })();
  /* Hodnocení Google: pod 50 recenzí jen známka, od 50 i počet. Prázdné hodnoty nechají [doplnit]. */
  (function(){ var z=document.querySelector('[data-znamka]'); if(!z) return;
    var hod=parseFloat((z.dataset.hodnota||'').replace(',','.')), poc=parseInt(z.dataset.pocet,10);
    if(!isNaN(hod)){ z.style.setProperty('--hodnota', hod); var c=z.querySelector('[data-znamka-cislo]'); c.textContent=hod.toLocaleString('cs-CZ'); c.className='';
      z.querySelector('.hvezdy').setAttribute('aria-label','Hodnocení '+hod.toLocaleString('cs-CZ')+' z 5'); }
    var p=z.querySelector('[data-znamka-pocet]');
    if(!isNaN(poc)){ if(poc<50) p.hidden=true; else p.textContent=poc+' recenzí'; } })();
</script>
