{% if rating %}<section aria-labelledby="hodnoceni-h" class="hodnoceni" id="hodnoceni">
<div class="obal">
<h2 data-odhalit="" id="hodnoceni-h">Hodnocení na Googlu</h2>

<div class="znamka" data-hodnota="{{ rating_raw }}" data-odhalit="" data-pocet="{{ rating_count_raw }}" data-znamka="">
<span aria-label="Hodnocení z 5" class="hvezdy" role="img"><svg aria-hidden="true" fill="none" preserveaspectratio="xMinYMid meet" stroke="currentColor" stroke-width="1.3" viewbox="0 0 150 26"><g transform="translate(0,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(31,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(62,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(93,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(124,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g></svg><span class="plne"><svg aria-hidden="true" fill="currentColor" preserveaspectratio="xMinYMid meet" viewbox="0 0 150 26"><g transform="translate(0,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(31,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(62,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(93,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g><g transform="translate(124,0)"><path d="M13 1.6l3.3 6.9 7.5.9-5.5 5.2 1.4 7.5L13 18.4l-6.7 3.7 1.4-7.5L2.2 9.4l7.5-.9z"></path></g></svg></span></span>
