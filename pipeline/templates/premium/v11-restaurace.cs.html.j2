function zaloz(root) {
  const radek = root.closest('.menu-radek');
  const cfg = { ...ZAKLAD, ...barvy(), images: root.dataset.abFotky.split(','), alts: (root.dataset.abAlty || '').split('|'),
    size: +(root.dataset.abVelikost || ZAKLAD.size), onEnd: () => {} };
  const kolo = createAxleBloom(root, cfg);
  const zaznam = { root, kolo, cfg };
  kola.push(zaznam);
  if (!POHYB) return;
  const spust = () => kolo.play();
  // jeden pohyb myši (nebo pera) nad řádkem stačí
  radek.addEventListener('pointerenter', (e) => { if (e.pointerType !== 'touch') spust(); });
  radek.addEventListener('pointermove', (e) => { if (e.pointerType !== 'touch' && !e.buttons) spust(); });
  // dotyk: klepnutí nebo posun prstem přes řádek
  radek.addEventListener('pointerup', (e) => { if (e.pointerType === 'touch') spust(); });
  radek.addEventListener('pointercancel', (e) => { if (e.pointerType === 'touch') spust(); });
  // fokus klávesnicí
  root.addEventListener('focusin', (e) => { if (e.target.matches(':focus-visible')) spust(); });
}
const roots = Array.from(document.querySelectorAll('.menu-foto .ab-root'));
if ('IntersectionObserver' in window) {
  const io = new IntersectionObserver((entries) => entries.forEach((en) => {
    if (en.isIntersecting) { io.unobserve(en.target); zaloz(en.target); }
  }), { rootMargin: '300px 0px' });
  roots.forEach((r) => io.observe(r));
} else roots.forEach(zaloz);
// přepnutí tématu → barvy pozadí/inkoustu do komponenty
document.addEventListener('zmena-tematu', () => setTimeout(() => {
  const b = barvy(); kola.forEach((z) => { Object.assign(z.cfg, b); z.kolo.update(z.cfg); });
}, 0));
const dispose = () => kola.forEach((z) => z.kolo.destroy());
window.addEventListener('pagehide', dispose, { once: true });
window.V11Menu = { kola: () => kola.map((z) => ({ id: z.root.closest('.menu-radek').id, hraje: z.kolo.playing, p: z.kolo.position, gl: z.kolo.hasGL, ready: z.root.hasAttribute('data-ready') })) };
})();
</script>
<p class="pz-credit">Návrh webu: <a href="{{ owner_site }}" rel="noopener">{{ owner_name }}</a> · Fotografie: Unsplash</p>
{% if show_banner %}<div class="pz-pv" id="pz-pv" role="note"><span>Nezávazný návrh nového webu pro <strong>{{ name }}</strong> · připravil {{ owner_name }}</span>
<a class="pz-cta" href="{{ want_url }}">Chci tento web</a>{% if wa_url %}<a class="pz-cta" href="{{ wa_url }}" rel="noopener" target="_blank">WhatsApp</a>{% endif %}
<button data-pz-skryt="" type="button">Skrýt</button></div>{% endif %}
<script id="pz-js">(function(){
var pv=document.getElementById('pz-pv');if(pv){var x=pv.querySelector('[data-pz-skryt]');x&&x.addEventListener('click',function(){pv.classList.add('pz-skryt');});}
var HOOK="{{ form_webhook_url }}",LEAD="{{ lead_id }}";
function lab(f,el){var l=el.id&&f.querySelector('label[for="'+el.id+'"]');if(!l)l=el.closest('label');var s=(l?l.textContent:'')||el.name||'';return s.replace(/\s+/g,' ').replace(/\*/g,'').trim();}
document.addEventListener('submit',function(e){var f=e.target;if(!f||f.tagName!=='FORM'||f.hasAttribute('data-pz-ignore')||!HOOK)return;
  var d={lead_id:LEAD,source:'preview',name:'',email:'',phone:'',message:''},rest=[],seen={};
  Array.prototype.forEach.call(f.elements,function(el){ if(!el.name||el.type==='submit'||el.type==='button')return; if((el.type==='checkbox'||el.type==='radio')&&!el.checked)return;
   var v=(el.value||'').trim(); if(!v)return; var n=el.name.toLowerCase();
   if(/^(jmeno|name|jmeno_prijmeni)$/.test(n))d.name=v; else if(/^(email|e-mail)$/.test(n))d.email=v; else if(/^(telefon|phone|tel)$/.test(n))d.phone=v;
   else {var k=lab(f,el)||el.name; if(seen[k]){seen[k].push(v);}else{seen[k]=[v];rest.push(k);}} });
  d.message=rest.map(function(k){return k+': '+seen[k].join(', ');}).join('\n');
  setTimeout(function(){ if(f.querySelector('[aria-invalid="true"],.chyba,.is-invalid'))return; if(!f.hasAttribute('novalidate')&&!f.checkValidity())return; if(!d.name&&!d.email&&!d.phone)return;
   try{fetch(HOOK,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(d)});}catch(err){}
  },0);
},true);
})();</script></body>
</html>
