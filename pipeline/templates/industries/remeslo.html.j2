{% extends 'base.html.j2' %}
{#- Trades: dark navy hero block, safety-orange accent, slanted photo edge. -#}
{% block extra_css %}
.hero--block{background:var(--brand)}
.hero--block h1{letter-spacing:-.02em}
.hero--block .hero-cat{color:var(--on-brand-muted)}
.hero--block .hero-cat::before{background:var(--accent)}
.hero--block .btn-accent{box-shadow:0 10px 30px -10px rgba(0,0,0,.6)}
.hero--block .hero-art{clip-path:polygon(6% 0,100% 0,100% 100%,0 100%)}
.hero--block .photo,.hero--block .ph{border-radius:6px}
.hero-stripe{position:absolute;right:-8%;top:-20%;width:46%;height:140%;background:repeating-linear-gradient(135deg,rgba(255,255,255,.06) 0 14px,transparent 14px 40px);pointer-events:none}
.svc{border-left:5px solid var(--accent);border-radius:4px}
.svc .ico-wrap{border-radius:6px}
.btn,form,.map,.c-item .ico-wrap{--radius:6px}
h2{text-transform:none}
{% endblock %}
{% block hero_deco %}<div class="hero-stripe" aria-hidden="true"></div>{% endblock %}
