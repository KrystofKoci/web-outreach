{% extends 'base.html.j2' %}
{#- Salon: light editorial hero, large italic serif headline, offset frame around the photo. -#}
{% block extra_css %}
:root{--radius:2px}
.hero--editorial{background:var(--bg)}
.hero--editorial h1{font-weight:500;font-style:italic;font-size:clamp(2.7rem,9.5vw,5.2rem);letter-spacing:-.015em;line-height:1.02}
.hero--editorial .hero-cat{color:var(--accent);font-weight:500;letter-spacing:.02em}
.hero--editorial .hero-cat::before{height:1px;width:40px;background:var(--accent)}
.hero--editorial .hero-art{padding:0 18px 18px 0}
.hero--editorial .photo,.hero--editorial .ph{box-shadow:18px 18px 0 0 var(--soft),19px 19px 0 1px var(--line)}
.hero--editorial .btn-accent{background:var(--brand);border-color:var(--brand)}
.top .mark{border-radius:50%;background:var(--accent)}
h2{font-weight:500;font-style:italic;font-size:clamp(2rem,5vw,3rem)}
h3{font-family:var(--font-body);font-weight:600}
.svc{border:0;border-top:1px solid var(--line);background:transparent;padding-left:0;padding-right:0}
.svc .ico-wrap{background:transparent;color:var(--accent);width:auto;height:auto;justify-content:start}
.svc .ico-wrap .ico{width:28px;height:28px}
.why .tick{background:var(--brand)}
.top-cta{background:var(--accent)}
footer{background:var(--brand)}
{% endblock %}
